#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"

# Secret scan is never skippable.
"$ROOT/scripts/scan-secrets.sh"

# Future: re-enable fmt/lint/tests once the toolchain runs inside the Vagrant guest
# (host checkouts share VirtFS with the VM and often lack a usable Deno tree).
echo "pre-commit: fmt/lint/tests disabled — secret scan only" >&2
exit 0
