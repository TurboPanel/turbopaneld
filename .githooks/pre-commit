#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"

# Secret scan is never skippable.
"$ROOT/scripts/scan-secrets.sh"

# Typecheck and the test suite stay deferred to `deno task verify` / CI (they
# need the Vagrant guest or minutes of wall clock). Everything below is the
# cheap, offline half of verify.yml -- fmt, lint, and the two static contract
# guards -- because those are what actually turn CI red on an otherwise-good
# change, and they cost ~2s here instead of ~5min there.
if [ "${TURBOPANEL_SKIP_HOOK_TESTS:-}" = 1 ]; then
  echo "pre-commit: fmt + guards skipped (TURBOPANEL_SKIP_HOOK_TESTS=1) -- CI still runs them" >&2
  exit 0
fi

tp_precommit_dev_checkout() {
  if [ -n "${TURBOPANEL_DEV_CHECKOUT:-}" ] &&
    [ -f "$TURBOPANEL_DEV_CHECKOUT/Vagrantfile" ]; then
    printf '%s\n' "$TURBOPANEL_DEV_CHECKOUT"
    return 0
  fi
  if [ -f "$ROOT/../dev/Vagrantfile" ]; then
    CDPATH= cd -- "$ROOT/../dev" && pwd
    return 0
  fi
  _home_dev="${TURBOPANEL_DEV_ROOT:-$HOME}/dev"
  if [ -f "$_home_dev/Vagrantfile" ]; then
    printf '%s\n' "$_home_dev"
    return 0
  fi
  return 1
}

# Resolve the Deno this hook may run, through the dev checkout's pin-aware
# toolchain (dev/scripts/lib/hook-toolchain.sh) so the hook, ./console and CI
# all agree on one runtime. That policy is deliberately not version-blind: the
# pinned vendor/deno/<DENO_VERSION>/deno wins, vendor/deno/current is used only
# once it resolves to that pin (a `current` left behind by a superseded pin is
# what a pin bump has to repair), and a PATH Deno is a last resort rather than
# the default -- fmt/lint output differs between releases, so a stale host Deno
# silently reformats the tree the pinned CI runner then rejects.
#
# Run in a subshell: tp_hook_toolchain_fail exits 1, and swallowing that here
# keeps the vagrant fallback below reachable while stopping the sourced dev
# libs from leaking their variables into this hook. The subshell runs without
# `set -e` on purpose -- a relink into a read-only vendor tree is meant to fall
# through to running vendor/deno/<DENO_VERSION>/deno directly, not to abort --
# so the status is checked explicitly and the resolved binary is re-verified.
tp_precommit_deno() {
  _dev=$(tp_precommit_dev_checkout) || return 1
  [ -f "$_dev/scripts/lib/hook-toolchain.sh" ] || return 1
  TURBOPANEL_DEV_CHECKOUT="$_dev" sh -c '
    set -u
    . "$1/scripts/lib/hook-toolchain.sh" || exit 1
    tp_hook_ensure_deno_toolchain >&2 || exit 1
    [ -n "${DENO_BIN:-}" ] && [ -x "$DENO_BIN" ] || exit 1
    printf "%s\n" "$DENO_BIN"
  ' sh "$_dev"
}

tp_precommit_vagrant_deno() {
  if ! command -v vagrant >/dev/null 2>&1; then
    return 1
  fi
  _dev=$(tp_precommit_dev_checkout) || return 1
  echo "pre-commit: no pinned host Deno - running 'deno $*' via vagrant ssh ($_dev)" >&2
  (
    CDPATH= cd -- "$_dev" || exit 1
    vagrant ssh -c "export PATH=\"/opt/turbopanel/vendor/deno/current:\$PATH\"; cd ~/turbopaneld && deno $*"
  )
}

# Run `deno <args...>` on the host, else inside the sibling-dev guest.
# Propagates the exit status so a failing guard aborts the commit.
#
# Resolution is memoized: four guards run below, and tp_precommit_deno may
# vendor the pin, so re-resolving per guard would repeat that work (and its
# failure) four times per commit.
TP_PRECOMMIT_DENO=""
TP_PRECOMMIT_DENO_RESOLVED=0
tp_precommit_deno_exec() {
  if [ "$TP_PRECOMMIT_DENO_RESOLVED" -eq 0 ]; then
    TP_PRECOMMIT_DENO="$(tp_precommit_deno)" || TP_PRECOMMIT_DENO=""
    TP_PRECOMMIT_DENO_RESOLVED=1
  fi
  if [ -n "$TP_PRECOMMIT_DENO" ]; then
    "$TP_PRECOMMIT_DENO" "$@"
    return
  fi
  if tp_precommit_vagrant_deno "$@"; then
    return 0
  fi
  echo "pre-commit: no pinned Deno on this host, and 'vagrant ssh deno $*' failed" >&2
  echo "pre-commit: install Deno 2.9.6, converge vendor Deno, or vagrant up from the sibling dev checkout" >&2
  echo "pre-commit: CI runs the same commands; skipping them only moves the failure to verify" >&2
  return 1
}

cd "$ROOT"
# Apply fmt (same rules as CI) and restage files already in this commit so the
# index cannot stay on the unformatted copy.
staged="$(git diff --cached --name-only --diff-filter=ACM || true)"
tp_precommit_deno_exec fmt
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -e "$file" ] || continue
    git add -- "$file"
  done
fi

# Static gates from verify.yml, in CI order. These read the whole tree (not
# just the staged diff) because the contract guards are whole-tree scans -- a
# new file that hardcodes a layout path fails here rather than 5 minutes into
# a PR run. All three are offline and finish in ~2s.
tp_precommit_deno_exec lint
tp_precommit_deno_exec task check:layout
tp_precommit_deno_exec task check:vocabulary
