{
  "name": "turbopaneld",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./main.ts",
    "./orchestration/ansible-events": "./src/orchestration/ansible-events.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/crypto": "jsr:@std/crypto@1",
    "@std/encoding/base64": "jsr:@std/encoding@1/base64",
    "@std/encoding/base64url": "jsr:@std/encoding@1/base64url",
    "@std/encoding/hex": "jsr:@std/encoding@1/hex",
    "@std/path": "jsr:@std/path@1",
    "@std/testing/bdd": "jsr:@std/testing@1/bdd",
    "yaml": "npm:yaml@^2.8.0"
  },
  "exclude": [
    "dist",
    "publish",
    "state",
    "logs",
    "cloudflared",
    "coverage*",
    ".ansible",
    "orchestration/roles/geerlingguy.docker",
    "orchestration/roles/geerlingguy",
    "workers"
  ],
  "fmt": {
    "exclude": [
      "**/*.md",
      "orchestration/**"
    ]
  },
  "tasks": {
    "start": "deno run --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env main.ts",
    "dev": "deno run --watch --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env main.ts",
    "bootstrap-orchestration": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env scripts/bootstrap-orchestration.ts",
    "check:layout": "deno run --allow-read --allow-run=git scripts/check-production-layout.ts",
    "check:vocabulary": "deno run --allow-read scripts/check-vocabulary.ts",
    "test": "deno test -A",
    "test:coverage": "rm -rf coverage && deno test -A --coverage=coverage/profile && deno coverage coverage/profile --lcov --output=coverage/lcov.info",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check main.ts src/prod-main.ts src/ scripts/",
    "bundle:js": "deno bundle src/prod-main.ts -o dist/turbopaneld.js",
    "bundle:orchestration": "bash scripts/bundle-orchestration.sh",
    "compile": "deno compile --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env -o dist/turbopaneld src/prod-main.ts",
    "compile:linux-amd64": "deno compile --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env --target x86_64-unknown-linux-gnu -o dist/.build/turbopaneld-linux-amd64 src/prod-main.ts",
    "compile:linux-arm64": "deno compile --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env --target aarch64-unknown-linux-gnu -o dist/.build/turbopaneld-linux-arm64 src/prod-main.ts",
    "compile:all": "deno task compile:linux-amd64 && deno task compile:linux-arm64 && deno task bundle:js && deno task bundle:orchestration && deno task package:release",
    "package:release": "bash scripts/package-daemon-release.sh",
    "release:package": "deno task compile:all",
    "release:dev": "deno run --allow-read --allow-write --allow-run --allow-env scripts/release-dev-overlay.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"]
  }
}
