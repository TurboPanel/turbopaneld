{
  "name": "turbopanel-daemon",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./main.ts",
    "./orchestration/ansible-events": "./src/orchestration/ansible-events.ts"
  },
  "imports": {
    "@std/encoding/base64": "jsr:@std/encoding@1/base64",
    "@std/encoding/base64url": "jsr:@std/encoding@1/base64url",
    "@std/encoding/hex": "jsr:@std/encoding@1/hex",
    "@std/path": "jsr:@std/path@1"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env main.ts",
    "dev": "deno run --watch --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env main.ts",
    "bootstrap-orchestration": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env scripts/bootstrap-orchestration.ts",
    "compile": "deno compile --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env -o dist/turbopaneld main.ts",
    "compile:linux-amd64": "deno compile --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env --target x86_64-unknown-linux-gnu -o dist/turbopaneld-linux-amd64 main.ts",
    "compile:linux-arm64": "deno compile --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env --target aarch64-unknown-linux-gnu -o dist/turbopaneld-linux-arm64 main.ts",
    "compile:all": "deno task compile:linux-amd64 && deno task compile:linux-arm64 && deno task package:release",
    "package:release": "sh scripts/package-daemon-release.sh",
    "release:package": "deno task compile:all && deno task package:release"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"]
  }
}
