---
# Repo-root config for IDE ansible-lint (cwd = daemon checkout).
# Runtime converge still uses orchestration/ansible.cfg + orchestration/.ansible-lint.
#
# geerlingguy.* Galaxy installs (requirements-docker.yml) — third-party,
# gitignored, and must not be linted or edited. exclude_paths only apply to
# auto-discovery (explicitly opened files still lint via the nested
# geerlingguy.*/.ansible-lint written by ensureGalaxyDockerRole).
offline: true
exclude_paths:
  - .cache/
  # Galaxy geerlingguy.docker (dot layout) and geerlingguy/docker (author/role)
  - orchestration/roles/geerlingguy.docker/
  - orchestration/roles/geerlingguy/
  - orchestration/roles/geerlingguy.*/
  - "**/orchestration/roles/geerlingguy.docker/**"
  - "**/orchestration/roles/geerlingguy/**"
  - "**/orchestration/roles/geerlingguy.*/**"
