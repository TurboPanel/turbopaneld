# Rules for scripts/scan-secrets.sh. Byte-identical in turbopanel, turbopaneld,
# ui, website and dev: change all five together (dev's test checks the copies).
#
# One rule per line, "kind id regex", split on the first two blanks. The regex
# is a POSIX extended regular expression (grep -E), case-sensitive, so no \b,
# \d, \w or lookarounds. Lines starting with # and blank lines are ignored.
#
#   line      the regex is matched against file content, one line at a time
#   path      the regex is matched against the whole repo-relative path; a hit
#             means that file must not be committed whatever it contains
#   pathok    a path matching this is exempt from every `path` rule (templates)
#
# The scanner never prints the matching text, only the rule id and location.

# --- private key material ---------------------------------------------------
# A key block counts only when the key body is there, not when code merely
# names the header: the header with the body on the same line (a JSON string
# with \n escapes), or the header alone on its line with a body-looking line
# right after it (the shell checks that line for pem-header-line).
line pem-private-key-inline PRIVATE KEY( BLOCK)?-----(\\r)?(\\n|[[:space:]])*[A-Za-z0-9+/]{40,}
line pem-header-line ^[^A-Za-z0-9]*-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----([^A-Za-z0-9]|\\n)*$
line jwk-private-d "d"[[:space:]]*:[[:space:]]*"[A-Za-z0-9_-]{20,}"
line jwk-private-binding privateJwk"?[[:space:]]*[:=][[:space:]]*["']

# --- vendor tokens ----------------------------------------------------------
line stripe-key (sk|rk)_(live|test)_[0-9A-Za-z]{16,}
line stripe-webhook-secret whsec_[0-9A-Za-z]{24,}
line github-token gh[pousr]_[0-9A-Za-z]{36,}
line github-fine-grained-pat github_pat_[0-9A-Za-z_]{40,}
line aws-access-key-id (AKIA|ASIA)[0-9A-Z]{16}
line generic-aws-secret-key [Aa][Ww][Ss]_?[Ss][Ee][Cc][Rr][Ee][Tt]_?([Aa][Cc][Cc][Ee][Ss][Ss]_?)?[Kk][Ee][Yy]["']?[[:space:]]*(:|=|:=)[[:space:]]*["']?[A-Za-z0-9+/]{40}([^A-Za-z0-9+/=]|$)
line slack-token xox[abprs]-[0-9A-Za-z-]{10,}
line slack-webhook hooks\.slack\.com/services/T[0-9A-Z]+/B[0-9A-Z]+/[0-9A-Za-z]{20,}
line cloudflare-api-token (CLOUDFLARE|CF)_[A-Z_]*(TOKEN|KEY)[A-Z_]*["']?[[:space:]]*[:=][[:space:]]*["']?[A-Za-z0-9_-]{40}([^A-Za-z0-9_-]|$)
line bearer-token-40 [Bb]earer [A-Za-z0-9_-]{40}([^A-Za-z0-9_-]|$)
line sonar-token sq[pau]_[0-9a-f]{40}
line ci-token-assignment (SONAR|GITGUARDIAN|GG)[A-Z_]*(TOKEN|KEY)["']?[[:space:]]*[:=][[:space:]]*["']?[0-9A-Za-z_-]{32,}([^0-9A-Za-z_-]|$)
line google-api-key AIza[0-9A-Za-z_-]{35}
line npm-token npm_[0-9A-Za-z]{36}
line anthropic-openai-key sk-(ant|proj)-[0-9A-Za-z_-]{20,}
line jwt eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}

# --- connection URLs with embedded credentials ------------------------------
line db-url-credentials (postgres(ql)?|amqps?)://.*:.*@
line url-credentials (mysql|mongodb(\+srv)?)://[^[:space:]@/]+:[^[:space:]@/*${<%][^[:space:]@/]*@
line redis-url-credentials rediss?://[^[:space:]@/]*:[^[:space:]@/*${<%][^[:space:]@]*@

# --- the root secret and secret-bearing file names mentioned in text ---------
# Needs = or : right after the name, so prose like "TURBOPANEL_SECRET is
# required" stays clean.
line turbopanel-secret TURBOPANEL_SECRETS?"?[=:]
line secret-file-mention (license\.token|server-key\.json|\.rabbitmq_pass|\.pgpass)

# --- high-entropy assignment to a secret-sounding name ----------------------
# The shell also requires a 24+ character token on the line with a letter and a
# digit and no placeholder word (every token on the line is tried, so a trailing
# comment cannot hide the value), so identifiers and "changeme" style values
# stay clean. generic-secret-unquoted is the same shape without quotes
# (YAML, .ini, shell). generic-aws-secret-key (with the vendor tokens above)
# is the 40 character AWS secret access key in any case, quoted or not.
line generic-secret-assignment (SECRET|Secret|secret|TOKEN|Token|token|PASSWORD|Password|password|PASSWD|passwd|API_KEY|APIKEY|ApiKey|apiKey|api_key|PRIVATE_KEY|privateKey|private_key)[A-Za-z0-9_]*["']?[[:space:]]*(:|=|:=)[[:space:]]*[bB]?["'][A-Za-z0-9+/=_-]{24,}["']
line generic-secret-env (SECRET|TOKEN|PASSWORD|PASSWD|API_KEY|APIKEY|PRIVATE_KEY)[A-Z0-9_]*=[A-Za-z0-9+/_-]{32,}[[:space:]]*$
line generic-secret-unquoted (SECRET|Secret|secret|TOKEN|Token|token|PASSWORD|Password|password|PASSWD|passwd|API_KEY|APIKEY|ApiKey|apiKey|api_key|PRIVATE_KEY|privateKey|private_key)[A-Za-z0-9_]*["']?[[:space:]]*(:|=|:=)[[:space:]]*[A-Za-z0-9+/=_-]{24,}([[:space:],;#]|$)

# --- files that must never be committed -------------------------------------
path env-file (^|/)\.env(\..*)?$
path env-dash-file (^|/)\.env-.*
path dev-vars-file (^|/)\.dev\.vars(\..*)?$
path pem-file \.pem$
path key-file \.key$
path private-key-file (^|/)id_(rsa|dsa|ecdsa|ed25519)[^/]*$
path pkcs-keystore \.(p12|pfx|jks)$
path credentials-json (^|/)credentials[^/]*\.json$
path daemon-identity-file (^|/)(license\.token|license\.id|server-key\.json|server-key-id|server\.id)$
path password-file (^|/)\.(pgpass|rabbitmq_pass)$|\.(pgpass|rabbitmq_pass)$
pathok env-template (^|/)\.(env|dev\.vars)\.(example|sample|template)$
