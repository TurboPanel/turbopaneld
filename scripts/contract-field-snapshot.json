{
  "ServerReportedIp": {
    "instance": "src/contracts/server-addresses.ts",
    "daemon": "src/contracts/server-reported-ip.ts",
    "fields": [
      { "name": "address", "required": true, "type": "string" },
      { "name": "cidr", "required": false, "type": "string" },
      { "name": "interface", "required": false, "type": "string" },
      { "name": "preferred", "required": false, "type": "boolean" },
      { "name": "scope", "required": true, "type": "'private' | 'public'" },
      { "name": "version", "required": true, "type": "4 | 6" }
    ]
  },
  "CellAttachVersionMessage": {
    "instance": "src/contracts/cell-protocol.ts",
    "daemon": "src/contracts/cell-messages.ts",
    "fields": [
      { "name": "at", "required": true, "type": "string" },
      { "name": "branch", "required": true, "type": "string" },
      { "name": "commit", "required": true, "type": "string" },
      { "name": "features", "required": false, "type": "Array<string>" },
      { "name": "instanceVersion", "required": false, "type": "string" },
      { "name": "type", "required": true, "type": "'version'" }
    ]
  },
  "DaemonUpdateMessage": {
    "instance": "src/contracts/cell-protocol.ts",
    "daemon": "src/contracts/cell-messages.ts",
    "fields": [
      { "name": "at", "required": true, "type": "string" },
      { "name": "channel", "required": false, "type": "string" },
      { "name": "id", "required": true, "type": "string" },
      { "name": "manifestUrl", "required": false, "type": "string" },
      { "name": "targetCommit", "required": false, "type": "string" },
      { "name": "type", "required": true, "type": "'update'" },
      { "name": "updateSha256", "required": false, "type": "string" },
      { "name": "updateUrl", "required": false, "type": "string" },
      { "name": "upgradeId", "required": false, "type": "string" }
    ]
  },
  "InstanceUpdateMessage": {
    "instance": "src/contracts/cell-protocol.ts",
    "daemon": "src/contracts/cell-messages.ts",
    "fields": [
      { "name": "at", "required": true, "type": "string" },
      { "name": "channel", "required": false, "type": "string" },
      { "name": "id", "required": true, "type": "string" },
      { "name": "manifestUrl", "required": false, "type": "string" },
      { "name": "targetCommit", "required": false, "type": "string" },
      { "name": "targetVersion", "required": false, "type": "string" },
      { "name": "type", "required": true, "type": "'instance-update'" },
      { "name": "uiManifestUrl", "required": false, "type": "string" },
      { "name": "upgradeId", "required": false, "type": "string" }
    ]
  },
  "UpdateProgressMessage": {
    "instance": "src/contracts/cell-protocol.ts",
    "daemon": "src/contracts/cell-messages.ts",
    "fields": [
      { "name": "at", "required": true, "type": "string" },
      { "name": "detail", "required": false, "type": "string" },
      { "name": "errorCode", "required": false, "type": "string" },
      { "name": "id", "required": true, "type": "string" },
      {
        "name": "stage",
        "required": true,
        "type": "'done' | 'downloading' | 'failed' | 'installing' | 'preparing' | 'restarting' | 'rolled-back' | 'verifying'"
      },
      { "name": "type", "required": true, "type": "'update-progress'" },
      { "name": "unit", "required": true, "type": "'daemon' | 'instance'" },
      { "name": "upgradeId", "required": false, "type": "string" }
    ]
  },
  "InstanceAcmeWireSettings": {
    "instance": "src/contracts/cell-protocol.ts",
    "daemon": "src/contracts/cell-messages.ts",
    "fields": [
      { "name": "contactEmail", "required": true, "type": "string" },
      { "name": "directoryUrl", "required": true, "type": "string" },
      { "name": "tosAccepted", "required": true, "type": "boolean" },
      { "name": "useStaging", "required": true, "type": "boolean" }
    ]
  },
  "InstanceHostnameWireEntry": {
    "instance": "src/contracts/cell-protocol.ts",
    "daemon": "src/contracts/cell-messages.ts",
    "fields": [
      { "name": "certPem", "required": false, "type": "string" },
      { "name": "host", "required": true, "type": "string" },
      { "name": "keyPem", "required": false, "type": "string" },
      {
        "name": "source",
        "required": true,
        "type": "'lets-encrypt' | 'platform-ca' | 'uploaded'"
      },
      { "name": "uploadedCertId", "required": false, "type": "string" }
    ]
  },
  "EnvironmentDeployHostAccess": {
    "instance": "src/contracts/commands/schemas.ts",
    "daemon": "src/contracts/commands-contracts.ts",
    "fields": [
      { "name": "hostLevelApproved", "required": false, "type": "boolean" }
    ]
  }
}
