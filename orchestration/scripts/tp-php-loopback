#!/bin/sh
# tp-php-loopback — keeps every Hosting Account off other accounts' loopback
# ports and off the host's container networks (POSIX sh, root:root, installed
# next to tp-host in lib/). The name is historical: it began as site PHP's
# loopback guard.
#
# One nftables table, `inet turbopanel_php`, with an output hook at priority
# -150 (before Docker's NAT, so a published 127.0.0.1:<port> is still seen as
# 127.0.0.1). Every rule binds only the principal band (uids 15001-60000,
# tp-host's PRINCIPAL_ID_MIN/MAX): site PHP, cron, ssh and sftp sessions,
# `sudo -u`, native apps and anything else run as a Hosting Account, whether
# or not it has a PHP site. The daemon, root, the web servers and builds
# (dynamic uids) are outside the band and untouched.
#
# Replies first: `ct state established,related accept` comes before every
# refusal, so the answers a native app sends the hosting proxy over loopback,
# and every reply to a connection the account was allowed to open, pass.
#
# Loopback (127.0.0.0/8 and ::1): new connections are refused except
#
#   - 127.0.0.1 tcp 13306   the database proxy, MySQL family (proxysql.ts MYSQL_PORT)
#   - 127.0.0.1 tcp 15432   the database proxy, Postgres (proxysql.ts PGSQL_PORT)
#   - port 53 on 127.0.0.53 (systemd-resolved's stub) and on every loopback
#     nameserver /etc/resolv.conf names (a local caching resolver)
#   - the account's own ports: 127.0.0.1:<PORT> of each of its native apps
#     (User= and Environment=PORT= of /etc/systemd/system/turbopanel-app-*.service,
#     the check copy beside a serving release included), as uid . port pairs
#     in the set `own_ports`. This set is the per-account opening: a
#     project's own helper containers will be added to it, for that one
#     account, when they get loopback ports of their own.
#
# so ProxySQL's admin (6032) and metrics (6070) ports, other accounts' apps
# and loopback publishes, other sites' ports and Apache's backend port are
# closed. A server an account starts by hand on loopback (from its shell) is
# refused too, to that account as well: nothing on the host can say which
# account a loopback listener belongs to.
#
# Container networks: new connections are refused
#
#   - that leave through a container bridge (docker0, br-<id>), matched on the
#     packet's output interface, so a network created after this sync is
#     covered too (a br-<name> that is not Docker's, such as a LAN bridge,
#     is left out by name as found at the sync);
#   - to an address on one of those bridges now (the networks' gateways, which
#     are the host's own addresses and route over lo), read from `ip -o addr`;
#   - to Docker's configured address pools and default bridge range
#     (`default-address-pools` bases and `bip` in /etc/docker/daemon.json),
#     less every range this host routes somewhere other than a Docker bridge
#     (`ip route`: its own networks, the private fabric on tp0 and the
#     private network's services stay reachable even when an operator's pool
#     is as wide as 10.0.0.0/8). The pools therefore only refuse pool
#     addresses the host has no route of its own for. The routes are read at
#     each sync; the boot unit runs before the network is up and sees none
#     (so a pool is whole until the daemon's boot sync, which runs after it
#     restores the private fabric), and a route added later stays closed
#     inside a pool until the next sync.
#
# Everything else stays open: the host's scope addresses and the private
# network's services (a datacenter database, a VPC service), and the database
# proxy on 127.0.0.1, whose published port the hook sees before Docker's NAT
# rewrites it to the proxy's bridge address. Docker's built-in pools are not
# assumed when none is configured: they overlap common private networks
# (172.31.0.0/16, 192.168.0.0/16), and Docker only hands out ranges that do not
# collide with the host's routes, so the live bridges and the interface match
# are exact. Not covered: a network given its own bridge name
# (`com.docker.network.bridge.name`, host-level approval only) whose range is
# outside the configured pools, and another server's container network this
# host has a route for (the far server's forwarding rules decide those).
#
# One verb, `sync`: the whole table is rebuilt from what is on disk and in the
# kernel now (one atomic nft transaction) and read back. Callers:
#   - turbopanel-loopback-php.service at boot, before the network, logins and
#     cron (fails open: nothing Requires= it);
#   - every PHP unit's `ExecStartPre=+` (FAILS CLOSED: when this exits non-zero
#     the unit does not start);
#   - the daemon, through `tp-host php-loopback-sync`: at its boot reconcile
#     (after the private fabric is restored), after it installs or removes PHP
#     units, and after it installs, retires or removes native app units (so a
#     port that goes back to the ledger leaves its old account's pairs).
#
# Needs the `nft`, `flock` and `ip` programs (Ansible installs the nftables,
# util-linux and iproute2 packages in turbopanel-user/root-helpers.yml). When
# one is missing, or `ip` fails, the script exits non-zero with a message
# naming it, so a PHP unit does not start open and the daemon's reconcile
# reports why.
#
# Not closed: someone running `nft flush ruleset` / `nft delete table inet
# turbopanel_php`. The next unit start, deploy or daemon boot restores it.
set -eu
umask 077

PRINCIPAL_ID_MIN=15001
PRINCIPAL_ID_MAX=60000
DB_PORT=13306
PG_PORT=15432
RESOLVED_STUB=127.0.0.53
PATH=/usr/sbin:/usr/bin:/sbin:/bin

tp_die() {
  printf 'tp-php-loopback: %s\n' "$*" >&2
  exit 1
}

if [ "$(id -u)" = "0" ]; then
  TP_TEST=""
  P=""
else
  [ -n "${TP_HOST_TEST_PREFIX:-}" ] || tp_die "must run as root"
  TP_TEST=1
  P="$TP_HOST_TEST_PREFIX"
fi
UNITS="$P/etc/systemd/system"

[ "$#" -eq 1 ] && [ "$1" = "sync" ] || tp_die "only: sync"

uid_of() {
  if [ -n "$TP_TEST" ]; then
    awk -F: -v n="$1" '$1 == n { print $3; exit }' "$P/etc/passwd"
  else
    getent passwd "$1" | cut -d: -f3
  fi
}

# `uid . port` for every native app unit whose User= is a Hosting Account and
# whose PORT= is a port. A unit that does not fit is skipped, never fatal:
# a skipped pair only keeps that account off that port.
own_ports() {
  _acc=""
  for _u in "$UNITS"/turbopanel-app-*.service; do
    [ -f "$_u" ] && [ ! -L "$_u" ] || continue
    _name="$(sed -n 's/^User=//p' "$_u" | head -1)"
    case "$_name" in ''|-*|*[!A-Za-z0-9_.-]*) continue ;; esac
    _port="$(sed -n 's/^Environment=PORT=//p' "$_u" | head -1)"
    case "$_port" in ''|0*|*[!0-9]*) continue ;; esac
    [ "${#_port}" -le 5 ] && [ "$_port" -le 65535 ] || continue
    _uid="$(uid_of "$_name")"
    case "$_uid" in ''|*[!0-9]*) continue ;; esac
    [ "${#_uid}" -le 10 ] && [ "$_uid" -ge "$PRINCIPAL_ID_MIN" ] &&
      [ "$_uid" -le "$PRINCIPAL_ID_MAX" ] || continue
    _acc="$_acc$_uid . $_port
"
  done
  printf '%s' "$_acc" | sort -u
}

# Loopback nameservers /etc/resolv.conf names, besides resolved's stub.
loopback_resolvers() {
  _rc="$P/etc/resolv.conf"
  [ -r "$_rc" ] || return 0
  awk '$1 == "nameserver" { print $2 }' "$_rc" |
    grep -E '^(127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|::1)$' || :
}

# Keep only well-formed CIDRs of one family (4 or 6) from stdin, one per line,
# so a stray value never makes nft refuse the ruleset (which would keep every
# PHP unit down). Prefixes shorter than MIN (the second argument, default 8)
# are dropped with a warning: no container network is wider than /8, and such
# a pool would cut off the internet. Routes pass 0: they only keep ranges open.
valid_cidrs() {
  awk -v fam="$1" -v min="${2:-8}" '
    function v4(a,   n, o, i) {
      n = split(a, o, ".")
      if (n != 4) return 0
      for (i = 1; i <= 4; i++)
        if (o[i] !~ /^[0-9]+$/ || length(o[i]) > 3 || o[i] + 0 > 255) return 0
      return 1
    }
    function v6(a,   n, g, i, t) {
      if (a !~ /^[0-9a-f:]+$/ || a !~ /:/ || a ~ /:::/) return 0
      t = a
      if (gsub(/::/, "", t) > 1) return 0
      n = split(a, g, ":")
      if (n > 8) return 0
      for (i = 1; i <= n; i++) if (length(g[i]) > 4) return 0
      return 1
    }
    {
      c = tolower($0)
      if (split(c, p, "/") != 2 || p[2] !~ /^[0-9]+$/ || length(p[2]) > 3) next
      max = (fam == 4) ? 32 : 128
      if (fam == 4 && !v4(p[1])) next
      if (fam == 6 && !v6(p[1])) next
      if (p[2] + 0 > max) next
      if (p[2] + 0 < min) {
        printf "tp-php-loopback: ignoring %s (wider than /8)\n", c > "/dev/stderr"
        next
      }
      print p[1] "/" (p[2] + 0)
    }
  ' | sort -u
}

# Docker's configured ranges: every `default-address-pools` base and `bip`.
docker_config_ranges() {
  _dj="$P/etc/docker/daemon.json"
  [ -f "$_dj" ] && [ ! -L "$_dj" ] || return 0
  grep -oE '"(base|bip)"[[:space:]]*:[[:space:]]*"[^"]*"' "$_dj" |
    sed 's/.*:[[:space:]]*"\([^"]*\)"$/\1/' || :
}

# One `ip` listing (a fixture file in test mode); fails the sync when ip does.
ip_out() {
  if [ -n "$TP_TEST" ]; then
    [ ! -f "$P/ip-$1" ] || cat "$P/ip-$1"
    return 0
  fi
  case "$1" in
    addr) ip -o addr show ;;
    link) ip -o link show ;;
    route) ip -o -4 route show ;;
    route6) ip -o -6 route show ;;
  esac
}

# Interfaces named br-<something> that are not Docker's, such as an
# operator's LAN bridge: the br-* interface match must not catch them.
foreign_br_links() {
  printf '%s\n' "$1" | awk '{
    n = $2; sub(/:$/, "", n); sub(/@.*/, "", n)
    if (n !~ /^br-/ || length(n) > 15 || n !~ /^[A-Za-z0-9_.-]+$/) next
    if (n ~ /^br-[0-9a-f]+$/ && length(n) == 15) next
    print n
  }' | sort -u
}

# The addresses on Docker's bridges right now, with their prefixes;
# link-local ones are left to the unit's own filter.
bridge_ranges() {
  printf '%s\n' "$1" | awk '
    ($2 == "docker0" || ($2 ~ /^br-[0-9a-f]+$/ && length($2) == 15)) &&
      ($3 == "inet" || $3 == "inet6") && $0 !~ / scope link / { print $4 }
  '
}

# Every range this host routes somewhere other than a Docker bridge (the
# default route and route types such as blackhole or multicast excluded). A
# host route without a prefix is a /32 (or /128).
routed_ranges() {
  printf '%s\n' "$1" | awk -v host="$2" '
    $1 == "" || $1 == "default" || $1 ~ /^[a-z]+$/ || $1 ~ /^fe80:/ { next }
    {
      dev = ""
      for (i = 2; i < NF; i++) if ($i == "dev") { dev = $(i + 1); break }
      if (dev == "docker0" || (dev ~ /^br-[0-9a-f]+$/ && length(dev) == 15)) next
      d = $1
      if (d !~ /\//) d = d "/" host
      print d
    }
  '
}

# A set of one type, or nothing when it would be empty.
range_set() {
  [ -n "$3" ] || return 0
  _e=""
  for _r in $3; do _e="${_e:+$_e, }$_r"; done
  cat <<SET
  set $1 {
    type $2
    flags interval
    auto-merge
    elements = { $_e }
  }
SET
}

# Two rules (tcp reset, then the rest) refusing MATCH for the band.
refuse() {
  printf '    meta skuid %s %s meta l4proto tcp reject with tcp reset\n' "$BAND" "$1"
  printf '    meta skuid %s %s reject\n' "$BAND" "$1"
}

BAND="$PRINCIPAL_ID_MIN-$PRINCIPAL_ID_MAX"

# ruleset OWN_PAIRS DNS4 DNS6 BRIDGE4 BRIDGE6 POOL4 POOL6 KEEP4 KEEP6 FOREIGN_BR
ruleset() {
  _own=""
  while IFS= read -r _pair; do
    [ -n "$_pair" ] && _own="${_own:+$_own, }$_pair"
  done <<EOF
$1
EOF
  _not=""
  for _n in ${10}; do _not="${_not:+$_not, }\"$_n\""; done
  [ -z "$_not" ] || _not=" oifname != { $_not }"
  _dns4="$RESOLVED_STUB"
  for _d in $2; do [ "$_d" = "$RESOLVED_STUB" ] || _dns4="$_dns4, $_d"; done
  cat <<RULES
add table inet turbopanel_php
delete table inet turbopanel_php
table inet turbopanel_php {
  set own_ports {
    type uid . inet_service
${_own:+    elements = { $_own \}}
  }
$(range_set bridge4 ipv4_addr "$4")
$(range_set bridge6 ipv6_addr "$5")
$(range_set pool4 ipv4_addr "$6")
$(range_set pool6 ipv6_addr "$7")
$(range_set keep4 ipv4_addr "$8")
$(range_set keep6 ipv6_addr "$9")
  chain output {
    type filter hook output priority -150; policy accept;
    meta skuid $BAND ct state established,related accept
    meta skuid $BAND ip daddr 127.0.0.1 tcp dport $DB_PORT accept
    meta skuid $BAND ip daddr 127.0.0.1 tcp dport $PG_PORT accept
    meta skuid $BAND ip daddr { $_dns4 } udp dport 53 accept
    meta skuid $BAND ip daddr { $_dns4 } tcp dport 53 accept
$(if [ -n "$3" ]; then
    printf '    meta skuid %s ip6 daddr ::1 udp dport 53 accept\n' "$BAND"
    printf '    meta skuid %s ip6 daddr ::1 tcp dport 53 accept\n' "$BAND"
  fi)
    # Per-account openings: each account's own loopback ports.
    meta skuid . tcp dport @own_ports ip daddr 127.0.0.1 accept
$(refuse "ip daddr 127.0.0.0/8")
$(refuse "ip6 daddr ::1")
$(refuse 'oifname "docker0"')
$(refuse "oifname \"br-*\"$_not")
$([ -z "$4" ] || refuse "ip daddr @bridge4")
$([ -z "$5" ] || refuse "ip6 daddr @bridge6")
$([ -z "$8" ] || [ -z "$6" ] || printf '    meta skuid %s ip daddr @keep4 accept\n' "$BAND")
$([ -z "$9" ] || [ -z "$7" ] || printf '    meta skuid %s ip6 daddr @keep6 accept\n' "$BAND")
$([ -z "$6" ] || refuse "ip daddr @pool4")
$([ -z "$7" ] || refuse "ip6 daddr @pool6")
  }
}
RULES
}

if [ -z "$TP_TEST" ]; then
  command -v ip >/dev/null 2>&1 || tp_die "ip is not installed (apt install iproute2); the account rules cannot be built"
fi
_addr="$(ip_out addr)" || tp_die "ip -o addr show failed"
_link="$(ip_out link)" || tp_die "ip -o link show failed"
_route="$(ip_out route)" || tp_die "ip -o -4 route show failed"
_route6="$(ip_out route6)" || tp_die "ip -o -6 route show failed"

_own="$(own_ports)"
_res="$(loopback_resolvers)"
_res4="$(printf '%s\n' "$_res" | grep -v ':' | sed 's|$|/32|' | valid_cidrs 4 32 |
  sed 's|/32$||')"
_res6="$(printf '%s\n' "$_res" | grep -x '::1' || :)"
_bridges="$(bridge_ranges "$_addr")"
_pools="$(docker_config_ranges)"
_routes="$({ routed_ranges "$_route" 32; routed_ranges "$_route6" 128; })"
_rules="$(ruleset "$_own" "$_res4" "$_res6" \
  "$(printf '%s\n' "$_bridges" | valid_cidrs 4)" \
  "$(printf '%s\n' "$_bridges" | valid_cidrs 6)" \
  "$(printf '%s\n' "$_pools" | valid_cidrs 4)" \
  "$(printf '%s\n' "$_pools" | valid_cidrs 6)" \
  "$(printf '%s\n' "$_routes" | valid_cidrs 4 0)" \
  "$(printf '%s\n' "$_routes" | valid_cidrs 6 0)" \
  "$(foreign_br_links "$_link")")"

_rules="$(printf '%s\n' "$_rules" | grep -v '^[[:space:]]*$')"

if [ -n "$TP_TEST" ]; then
  printf '%s\n' "$_rules"
  exit 0
fi

command -v nft >/dev/null 2>&1 || tp_die "nft is not installed (apt install nftables); site PHP cannot start without its loopback rules"
command -v flock >/dev/null 2>&1 || tp_die "flock is not installed"
exec 9>/run/turbopanel-php-loopback.lock
flock 9
printf '%s\n' "$_rules" | nft -f - || tp_die "nft refused the ruleset"
# Read it back: the band's rules must be in the live table.
_live="$(nft list table inet turbopanel_php)" || tp_die "ruleset not loaded"
printf '%s\n' "$_live" | grep -q "meta skuid $BAND ip daddr 127.0.0.0/8" ||
  tp_die "loopback rules not loaded"
printf '%s\n' "$_live" | grep -q "meta skuid $BAND oifname \"docker0\"" ||
  tp_die "container rules not loaded"
