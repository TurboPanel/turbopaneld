#!/bin/sh
# tp-php-loopback — keeps site PHP off every loopback port but the database
# proxy's (POSIX sh, root:root, installed next to tp-host in lib/).
#
# A per-site PHP unit (turbopanel-php-<id>.service) may dial 127.0.0.1, but the
# unit cannot say "the database ports only" (systemd filters by address). This script
# adds the port filter: one nftables table, `inet turbopanel_php`, whose output
# hook (before Docker's NAT, so a published 127.0.0.1:<port> is still seen as
# 127.0.0.1) refuses, for every site owner's Linux user that has a PHP unit,
# anything bound for 127.0.0.0/8 or ::1 except
#
#   - 127.0.0.1 tcp 13306   the database proxy, MySQL family (proxysql.ts MYSQL_PORT)
#   - 127.0.0.1 tcp 15432   the database proxy, Postgres (proxysql.ts PGSQL_PORT)
#   - 127.0.0.53 port 53    systemd-resolved's stub
#
# so ProxySQL's admin (6032) and metrics (6070) ports, other sites' ports and
# Apache's backend port are closed to PHP. Rules are matched by uid (`meta
# skuid`), so they also bind that user's ssh and cron sessions.
#
# One verb, `sync`: the whole table is rebuilt from the unit files on disk (one
# atomic nft transaction) and read back. Two callers:
#   - every PHP unit's `ExecStartPre=+` (FAILS CLOSED: when this exits non-zero
#     the unit does not start, so PHP never runs with open loopback);
#   - the daemon, through `tp-host php-loopback-sync`, after it installs or
#     removes PHP units (a removed runtime's user drops out of the set).
# Because the set is derived from disk, start and sweep cannot disagree.
#
# Replies: the output hook also sees every packet a socket owned by the user
# sends, including the SYN-ACK and data a local server of theirs (a native app
# on 127.0.0.1:<port>) returns to its client. `ct state established,related
# accept` comes first so those replies are never refused; PHP's own new
# connections are `new` and still hit the port filter.
#
# Needs the `nft` and `flock` programs (Ansible installs the nftables and
# util-linux packages in turbopanel-user/root-helpers.yml). When either is
# missing the script exits non-zero with a message naming it, so a PHP unit
# does not start with open loopback and the daemon's reconcile reports why.
#
# Container wall: the same chain also keeps every Hosting Account off the
# host's container networks. For every uid in the principal band (15001-60000,
# tp-host's PRINCIPAL_ID_MIN/MAX: site PHP, cron, ssh and sftp sessions, and
# anything else run as the account, PHP unit or not) it refuses new
# connections
#
#   - that leave through a container bridge (docker0, br-<id>), matched on the
#     packet's output interface, so a network created after this sync is
#     covered too;
#   - to an address on one of those bridges now (the networks' gateways, which
#     are the host's own addresses and route over lo), read from `ip -o addr`;
#   - to Docker's configured address pools and default bridge range
#     (`default-address-pools` bases and `bip` in /etc/docker/daemon.json),
#     which also covers container networks on other servers reached over
#     the private network.
#
# Everything else stays open: the host's scope addresses and the private
# network's services (a datacenter database, a VPC service), and the database
# proxy on 127.0.0.1, whose published port the hook sees before Docker's NAT
# rewrites it to the proxy's bridge address. Docker's built-in pools are not
# assumed when none is configured: they overlap common private networks
# (172.31.0.0/16, 192.168.0.0/16), and Docker only hands out ranges that do not
# collide with the host's routes, so the live bridges and the interface match
# are exact. Not covered: a network given its own bridge name
# (`com.docker.network.bridge.name`, host-level approval only) whose range is
# outside the configured pools.
#
# A project's own helper containers are not opened here: the later design
# publishes them on a loopback port and opens that port for the one account
# in the loopback rules above (see the marked slot), so this wall stays whole.
#
# Not closed: someone running `nft flush ruleset` / `nft delete table inet
# turbopanel_php` while PHP runs. The next unit start, the next deploy or the
# daemon's boot reconcile restores it; until then loopback and the container
# networks are open to PHP. An account with no PHP unit is covered from the
# daemon's boot reconcile (every daemon start runs this sync) and every later
# sync.
set -eu
umask 077

PRINCIPAL_ID_MIN=15001
PRINCIPAL_ID_MAX=60000
DB_PORT=13306
PG_PORT=15432
PATH=/usr/sbin:/usr/bin:/sbin:/bin

tp_die() {
  printf 'tp-php-loopback: %s\n' "$*" >&2
  exit 1
}

if [ "$(id -u)" = "0" ]; then
  TP_TEST=""
  P=""
else
  [ -n "${TP_HOST_TEST_PREFIX:-}" ] || tp_die "must run as root"
  TP_TEST=1
  P="$TP_HOST_TEST_PREFIX"
fi
UNITS="$P/etc/systemd/system"

[ "$#" -eq 1 ] && [ "$1" = "sync" ] || tp_die "only: sync"

uid_of() {
  if [ -n "$TP_TEST" ]; then
    awk -F: -v n="$1" '$1 == n { print $3; exit }' "$P/etc/passwd"
  else
    getent passwd "$1" | cut -d: -f3
  fi
}

# The distinct uids of the site owners that have a PHP unit.
owner_uids() {
  _acc=""
  for _u in "$UNITS"/turbopanel-php-*.service; do
    [ -f "$_u" ] && [ ! -L "$_u" ] || continue
    # `turbopanel-php-fpm@.service` (and its instances) is the shared php-fpm
    # template: its master runs as root (no User=) and it is no site owner's
    # unit. Matched on the basename and only this template, so an '@' elsewhere
    # in the path, or in any other unit name, is still validated.
    _b="${_u##*/}"
    case "$_b" in turbopanel-php-fpm@*.service) continue ;; esac
    _name="$(sed -n 's/^User=//p' "$_u" | head -1)"
    case "$_name" in ''|-*|*[!A-Za-z0-9_.-]*) tp_die "$_u: bad User=" ;; esac
    _uid="$(uid_of "$_name")"
    # An account that no longer exists cannot run anything.
    [ -n "$_uid" ] || continue
    case "$_uid" in *[!0-9]*) tp_die "$_u: bad uid for $_name" ;; esac
    [ "$_uid" -ge "$PRINCIPAL_ID_MIN" ] && [ "$_uid" -ne 65534 ] ||
      tp_die "$_u: $_name is not a site owner's account"
    _acc="$_acc$_uid
"
  done
  printf '%s' "$_acc" | sort -un
}

# Keep only well-formed CIDRs of one family (4 or 6) from stdin, one per line,
# so a stray value never makes nft refuse the ruleset (which would keep every
# PHP unit down). Prefixes shorter than /8 are dropped with a warning: no
# container network is that wide, and such a value would cut off the internet.
valid_cidrs() {
  awk -v fam="$1" '
    function v4(a,   n, o, i) {
      n = split(a, o, ".")
      if (n != 4) return 0
      for (i = 1; i <= 4; i++)
        if (o[i] !~ /^[0-9]+$/ || length(o[i]) > 3 || o[i] + 0 > 255) return 0
      return 1
    }
    function v6(a,   n, g, i, t) {
      if (a !~ /^[0-9a-f:]+$/ || a !~ /:/ || a ~ /:::/) return 0
      t = a
      if (gsub(/::/, "", t) > 1) return 0
      n = split(a, g, ":")
      if (n > 8) return 0
      for (i = 1; i <= n; i++) if (length(g[i]) > 4) return 0
      return 1
    }
    {
      c = tolower($0)
      if (split(c, p, "/") != 2 || p[2] !~ /^[0-9]+$/ || length(p[2]) > 3) next
      max = (fam == 4) ? 32 : 128
      if (fam == 4 && !v4(p[1])) next
      if (fam == 6 && !v6(p[1])) next
      if (p[2] + 0 > max) next
      if (p[2] + 0 < 8) {
        printf "tp-php-loopback: ignoring %s (wider than /8)\n", c > "/dev/stderr"
        next
      }
      print p[1] "/" (p[2] + 0)
    }
  ' | sort -u
}

# Docker's configured ranges: every `default-address-pools` base and `bip`.
docker_config_ranges() {
  _dj="$P/etc/docker/daemon.json"
  [ -f "$_dj" ] && [ ! -L "$_dj" ] || return 0
  grep -oE '"(base|bip)"[[:space:]]*:[[:space:]]*"[^"]*"' "$_dj" |
    sed 's/.*:[[:space:]]*"\([^"]*\)"$/\1/' || :
}

# `ip -o addr show` (a fixture file in test mode).
ip_addrs() {
  if [ -n "$TP_TEST" ]; then
    [ ! -f "$P/ip-addr" ] || cat "$P/ip-addr"
  else
    ip -o addr show
  fi
}

# The addresses on Docker's bridges right now (docker0 and br-<12 hex>), with
# their prefixes; link-local ones are left to the unit's own filter.
bridge_ranges() {
  ip_addrs | awk '
    ($2 == "docker0" || ($2 ~ /^br-[0-9a-f]+$/ && length($2) == 15)) &&
      ($3 == "inet" || $3 == "inet6") && $0 !~ / scope link / { print $4 }
  '
}

# A set of one family, or nothing when it would be empty.
range_set() {
  [ -n "$3" ] || return 0
  _e=""
  for _r in $3; do _e="${_e:+$_e, }$_r"; done
  cat <<SET
  set $1 {
    type $2
    flags interval
    auto-merge
    elements = { $_e }
  }
SET
}

ruleset() {
  _elems=""
  for _id in $1; do _elems="${_elems:+$_elems, }$_id"; done
  _line=""
  [ -z "$_elems" ] || _line="    elements = { $_elems }"
  _band="$PRINCIPAL_ID_MIN-$PRINCIPAL_ID_MAX"
  _bridge_rules=""
  if [ -n "$2" ]; then
    _bridge_rules="    meta skuid $_band ip daddr @bridge4 meta l4proto tcp reject with tcp reset
    meta skuid $_band ip daddr @bridge4 reject"
  fi
  if [ -n "$3" ]; then
    _bridge_rules="${_bridge_rules:+$_bridge_rules
}    meta skuid $_band ip6 daddr @bridge6 meta l4proto tcp reject with tcp reset
    meta skuid $_band ip6 daddr @bridge6 reject"
  fi
  cat <<RULES
add table inet turbopanel_php
delete table inet turbopanel_php
table inet turbopanel_php {
  set owners {
    type uid
$_line
  }
$(range_set bridge4 ipv4_addr "$2")
$(range_set bridge6 ipv6_addr "$3")
  chain output {
    type filter hook output priority -150; policy accept;
    meta skuid @owners ct state established,related accept
    meta skuid @owners ip daddr 127.0.0.1 tcp dport $DB_PORT accept
    meta skuid @owners ip daddr 127.0.0.1 tcp dport $PG_PORT accept
    meta skuid @owners ip daddr 127.0.0.53 udp dport 53 accept
    meta skuid @owners ip daddr 127.0.0.53 tcp dport 53 accept
    # Per-account loopback openings (a project's own helper containers) go here.
    meta skuid @owners ip daddr 127.0.0.0/8 meta l4proto tcp reject with tcp reset
    meta skuid @owners ip daddr 127.0.0.0/8 reject
    meta skuid @owners ip6 daddr ::1 meta l4proto tcp reject with tcp reset
    meta skuid @owners ip6 daddr ::1 reject
    meta skuid $_band ct state established,related accept
    meta skuid $_band oifname { "docker0", "br-*" } meta l4proto tcp reject with tcp reset
    meta skuid $_band oifname { "docker0", "br-*" } reject
$_bridge_rules
  }
}
RULES
}

_ids="$(owner_uids)"
if [ -z "$TP_TEST" ]; then
  command -v ip >/dev/null 2>&1 || tp_die "ip is not installed (apt install iproute2); site PHP cannot start without its container rules"
fi
_ranges="$({ docker_config_ranges; bridge_ranges; })"
_v4="$(printf '%s\n' "$_ranges" | valid_cidrs 4)"
_v6="$(printf '%s\n' "$_ranges" | valid_cidrs 6)"
_rules="$(ruleset "$_ids" "$_v4" "$_v6")"

if [ -n "$TP_TEST" ]; then
  printf '%s\n' "$_rules"
  exit 0
fi

command -v nft >/dev/null 2>&1 || tp_die "nft is not installed (apt install nftables); site PHP cannot start without its loopback rules"
command -v flock >/dev/null 2>&1 || tp_die "flock is not installed"
exec 9>/run/turbopanel-php-loopback.lock
flock 9
printf '%s\n' "$_rules" | nft -f - || tp_die "nft refused the ruleset"
# Read it back: every owner must be in the live set.
_live="$(nft list table inet turbopanel_php)" || tp_die "ruleset not loaded"
for _id in $_ids; do
  printf '%s\n' "$_live" | grep -Eq "(^|[ ,{])$_id([ ,}]|\$)" ||
    tp_die "uid $_id missing from the loaded set"
done
printf '%s\n' "$_live" | grep -q "meta skuid $PRINCIPAL_ID_MIN-$PRINCIPAL_ID_MAX oifname" ||
  tp_die "container rules not loaded"
