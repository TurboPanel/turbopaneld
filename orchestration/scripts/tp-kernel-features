#!/bin/sh
# tp-kernel-features — named kernel/boot features for a host (POSIX sh,
# root:root 0755). Run by the installer (scripts/run.sh) on a first install and
# by an operator through `tp-orchestrate kernel-features …`. The daemon never
# calls it, and `tp-orchestrate` refuses `apply`/`undo` from the daemon account.
#
#   tp-kernel-features list
#       One feature id per line.
#   tp-kernel-features status [ID]
#       `ID<TAB>STATE<TAB>reason` per feature. STATE is one of
#       not-applicable, switchable, restart-needed, ready, blocked.
#   tp-kernel-features apply ID [--reboot] [--countdown SECONDS]
#       Make the feature true. Idempotent. With --reboot, a feature that needs
#       a restart is followed by a visible countdown and a reboot (see below).
#   tp-kernel-features undo ID
#       Remove what apply added (only when this tool added it: a marker in
#       /var/lib/turbopanel-kernel says so). Never reboots.
#   tp-kernel-features installer-step
#       The last step of a first install (scripts/run.sh). For each feature that
#       applies to this host: say what is about to happen in plain words, save
#       every change, then count down and restart once for all of them. Does
#       nothing on a host the features do not apply to, nothing at all when
#       TURBOPANEL_SKIP_KERNEL_SWITCH=1, leaves out pi-memory-cgroup when
#       TURBOPANEL_SKIP_MEMORY_LIMITS_SWITCH=1, and it never restarts while an
#       update guard is armed. Its exit status is informational: the install
#       has already succeeded.
#
# Features are fixed in this file; nothing the caller passes is used as a path,
# a line of text or a command. A feature declares: an id, a platform test
# (what it needs to be true of the host), the desired state (applied
# idempotently), whether it needs a reboot, how to verify it, and how to undo it.
#
#   pi-4k-pagesize   Raspberry Pi OS on Debian 13 (trixie) boots a 16 KiB-page
#                    kernel by default; the database proxy needs 4 KiB pages.
#                    Desired state: `kernel=kernel8.img` is the first line of
#                    /boot/firmware/config.txt (before any [section]).
#                    Needs a reboot. Verify: `getconf PAGESIZE` prints 4096.
#                    Undo: remove that line (the backup copy is left alone).
#   pi-memory-cgroup Raspberry Pi firmware adds `cgroup_disable=memory` to the
#                    kernel command line, so the memory controller is missing
#                    from /sys/fs/cgroup/cgroup.controllers and memory limits
#                    (MemoryMax=, container memory limits) are not enforced.
#                    Desired state: the single line of /boot/firmware/cmdline.txt
#                    ends with `cgroup_enable=memory` (the kernel applies the
#                    words in order, so it wins over the firmware's word before
#                    it) and holds no `cgroup_disable=memory` of its own.
#                    Needs a reboot. Verify: `memory` is listed in
#                    /sys/fs/cgroup/cgroup.controllers. Undo: put back the line
#                    as it was before (recorded in the marker; the backup copy
#                    is left alone).
#
# Two backends back the features. Only the first is used today:
#   boot-config   edits a fixed boot file with a text transform (this file).
#   modules-load  would write /etc/modules-load.d/turbopanel-<feature>.conf for
#                 any Debian host; no feature uses it yet, so it reports
#                 `unsupported` rather than guessing (src/host/kernel-features
#                 in the daemon repo carries the typed registry and an example).
#
# Reboot safety: a reboot is only ever offered after the change is written and
# read back, and (when the daemon is installed) only once the daemon has saved
# its enrolment (server.id, server-key-id and the saved server key file). The registration
# key is single use, so a restart before that would leave the host unable to
# enrol (it parked a host on 2026-10-04). On a first install it then waits for
# the daemon's first setup run (daemon-converge) to finish: the daemon writes
# /run/turbopanel/boot-converge-done when it has, and that file must be newer
# than the installer's start marker (a restart in the middle of that run cut an
# apt task short on 2026-11-09). Then it waits until no package tool (dpkg,
# apt, unattended-upgrades) and no setup run (ansible-playbook) is running,
# stops the daemon so it starts nothing new, checks once more, and only then
# counts down. Any wait that runs out means no restart, with the manual command
# printed instead. `--countdown` shows one line per second; Ctrl-C cancels the
# reboot, starts the daemon again and prints the manual command. Without a
# terminal the same lines are printed without carriage returns.
#
# Test mode: unprivileged runs with TP_KERNEL_TEST_PREFIX set (paths live under
# that prefix, `reboot` is replaced by TP_KERNEL_TEST_REBOOT_CMD, the page size
# by TP_KERNEL_TEST_PAGESIZE, the daemon's unit by TP_KERNEL_TEST_DAEMON_ACTIVE
# and TP_KERNEL_TEST_SYSTEMCTL_LOG, sleeping is skipped). As root every one of
# those variables is ignored.
set -eu
umask 022

tp_die() {
  printf 'tp-kernel-features: %s\n' "$*" >&2
  exit 1
}

if [ "$(id -u)" = "0" ]; then
  TP_TEST=""
  P=""
else
  [ -n "${TP_KERNEL_TEST_PREFIX:-}" ] || tp_die "must run as root (sudo /opt/turbopanel/share/orchestration/scripts/tp-orchestrate kernel-features …)"
  TP_TEST=1
  P="$TP_KERNEL_TEST_PREFIX"
fi

KF_IDS="pi-4k-pagesize pi-memory-cgroup"
# tp-orchestrate is not on root's sudo PATH, so every command printed to a person
# uses its full path.
KF_CMD="/opt/turbopanel/share/orchestration/scripts/tp-orchestrate"
# Root-owned on purpose (not the daemon's state dir): a note that THIS tool added
# a line, so `undo` never removes a line a person wrote themselves.
KF_MARKER_DIR="$P/var/lib/turbopanel-kernel"
KF_LINE="kernel=kernel8.img"
KF_BOOT_DIR="$P/boot/firmware"
KF_STATE_DIR="$P/var/lib/turbopanel"
# The daemon writes this once its first setup run on this boot has finished.
KF_CONVERGE_DONE="$P/run/turbopanel/boot-converge-done"
KF_DAEMON_UNIT="turbopaneld.service"
KF_MEM_WORD="cgroup_enable=memory"
KF_MEM_OFF_WORD="cgroup_disable=memory"

# --- facts --------------------------------------------------------------------

kf_model() {
  tr -d '\000' < "$P/proc/device-tree/model" 2>/dev/null || true
}

kf_codename() {
  sed -n 's/^VERSION_CODENAME=//p' "$P/etc/os-release" 2>/dev/null | head -n 1 | tr -d '"'
}

kf_pagesize() {
  if [ -n "$TP_TEST" ] && [ -n "${TP_KERNEL_TEST_PAGESIZE:-}" ]; then
    printf '%s\n' "$TP_KERNEL_TEST_PAGESIZE"
    return 0
  fi
  getconf PAGESIZE 2>/dev/null || true
}

# --- backend: boot-config -----------------------------------------------------

# Prints "none", "kernel8-top", "kernel8-later" or "other" for the active
# kernel= lines of FILE (CRLF tolerated). "other" wins: any kernel= line that
# is not kernel8.img means the person chose a kernel themselves, so it is left
# alone. kernel8-top means kernel8.img is chosen before any [section] header.
kf_bootcfg_scan() {
  awk '
    { sub(/\r$/, "") }
    /^[ \t]*\[/ { section = 1; next }
    /^[ \t]*kernel[ \t]*=/ {
      v = $0
      sub(/^[ \t]*kernel[ \t]*=[ \t]*/, "", v)
      sub(/[ \t]+$/, "", v)
      if (v == "kernel8.img") { if (section) later = 1; else top = 1 }
      else other = 1
    }
    END {
      if (other) print "other"
      else if (top) print "kernel8-top"
      else if (later) print "kernel8-later"
      else print "none"
    }
  ' "$1"
}

# Keep the file's own line endings: CRLF only when its first line has one.
kf_bootcfg_cr() {
  if [ "$(head -n 1 "$1" | od -An -c | tr -d ' \n' | sed -n 's/.*\(\\r\\n\)$/crlf/p')" = "crlf" ]; then
    printf '\r'
  fi
}

# Put LINE first in FILE. Copies FILE to FILE.tp-backup-<UTC time> first,
# writes through a temporary name in the same directory and `mv -T`, reads the
# result back, and prints the backup path. The boot partition is FAT, so there
# is no mode or owner to keep.
kf_bootcfg_add_top() {
  _bt_file="$1"
  _bt_line="$2"
  _bt_dir="${_bt_file%/*}"
  _bt_name="${_bt_file##*/}"
  CDPATH='' cd -P -- "$_bt_dir" || tp_die "cannot enter $_bt_dir"
  [ "$(pwd -P)" = "$_bt_dir" ] || tp_die "refusing $_bt_dir: a component is a symlink"
  [ -f "$_bt_name" ] && [ ! -L "$_bt_name" ] || tp_die "$_bt_file is not a plain file"
  _bt_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  _bt_backup="$_bt_name.tp-backup-$_bt_stamp"
  _bt_new=".$_bt_name.tp-new.$$"
  _bt_n=1
  while [ -e "$_bt_backup" ]; do
    _bt_backup="$_bt_name.tp-backup-$_bt_stamp-$_bt_n"
    _bt_n=$((_bt_n + 1))
  done
  trap 'rm -f -- "$_bt_new"' EXIT
  cp -- "$_bt_name" "$_bt_backup" || tp_die "cannot save a backup copy of $_bt_file"
  cmp -s -- "$_bt_name" "$_bt_backup" || tp_die "the backup does not match $_bt_file"
  _bt_cr="$(kf_bootcfg_cr "$_bt_name")"
  (
    set -C
    : > "$_bt_new"
  ) || tp_die "cannot create a temporary file in $_bt_dir"
  {
    printf '%s%s\n' "$_bt_line" "$_bt_cr"
    cat -- "$_bt_name"
  } > "$_bt_new" || tp_die "cannot write the new $_bt_file"
  [ "$(head -n 1 "$_bt_new" | tr -d '\r')" = "$_bt_line" ] ||
    tp_die "the new file does not start with $_bt_line"
  tail -n +2 "$_bt_new" | cmp -s - "$_bt_name" ||
    tp_die "the new file does not keep the old content of $_bt_file"
  mv -T -f -- "$_bt_new" "$_bt_name" || tp_die "cannot replace $_bt_file"
  trap - EXIT
  sync || tp_die "cannot flush $_bt_file to disk"
  [ "$(kf_bootcfg_scan "$_bt_name")" = "kernel8-top" ] ||
    tp_die "$_bt_file does not read back with the line in place"
  printf '%s/%s\n' "$_bt_dir" "$_bt_backup"
}

# Remove every exact LINE that comes before the first [section] header, the
# same way (backup, temporary file, mv -T, read back). Prints the backup path.
kf_bootcfg_remove_top() {
  _br_file="$1"
  _br_line="$2"
  _br_dir="${_br_file%/*}"
  _br_name="${_br_file##*/}"
  CDPATH='' cd -P -- "$_br_dir" || tp_die "cannot enter $_br_dir"
  [ "$(pwd -P)" = "$_br_dir" ] || tp_die "refusing $_br_dir: a component is a symlink"
  [ -f "$_br_name" ] && [ ! -L "$_br_name" ] || tp_die "$_br_file is not a plain file"
  _br_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  _br_backup="$_br_name.tp-backup-$_br_stamp"
  _br_new=".$_br_name.tp-new.$$"
  _br_n=1
  while [ -e "$_br_backup" ]; do
    _br_backup="$_br_name.tp-backup-$_br_stamp-$_br_n"
    _br_n=$((_br_n + 1))
  done
  trap 'rm -f -- "$_br_new"' EXIT
  cp -- "$_br_name" "$_br_backup" || tp_die "cannot save a backup copy of $_br_file"
  cmp -s -- "$_br_name" "$_br_backup" || tp_die "the backup does not match $_br_file"
  (
    set -C
    : > "$_br_new"
  ) || tp_die "cannot create a temporary file in $_br_dir"
  # LINE is "kernel=<value>"; spaces and tabs around the name, the = and the
  # value are tolerated, the same way the scan reads them.
  _br_value="${_br_line#*=}"
  awk -v want="$_br_value" '
    {
      raw = $0
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[ \t]*\[/) section = 1
      if (!section && line ~ /^[ \t]*kernel[ \t]*=/) {
        v = line
        sub(/^[ \t]*kernel[ \t]*=[ \t]*/, "", v)
        sub(/[ \t]+$/, "", v)
        if (v == want) next
      }
      print raw
    }
  ' "$_br_name" > "$_br_new" || tp_die "cannot write the new $_br_file"
  mv -T -f -- "$_br_new" "$_br_name" || tp_die "cannot replace $_br_file"
  trap - EXIT
  sync || tp_die "cannot flush $_br_file to disk"
  case "$(kf_bootcfg_scan "$_br_name")" in
    kernel8-top) tp_die "$_br_file still has the line after removing it" ;;
  esac
  printf '%s/%s\n' "$_br_dir" "$_br_backup"
}

# --- feature: pi-4k-pagesize ----------------------------------------------------

# Prints STATE<TAB>reason.
kf_pi_4k_pagesize_state() {
  _ps="$(kf_pagesize)"
  case "$_ps" in
    ''|*[!0-9]*)
      printf 'not-applicable\tthe memory page size could not be read\n'
      return 0
      ;;
  esac
  if [ "$_ps" -le 4096 ]; then
    printf 'ready\tthis server already uses 4 KiB memory pages\n'
    return 0
  fi
  case "$(kf_model)" in
    *"Raspberry Pi"*) ;;
    *)
      printf 'not-applicable\tthis server is not a Raspberry Pi\n'
      return 0
      ;;
  esac
  if [ "$(kf_codename)" != "trixie" ]; then
    printf 'not-applicable\tonly Raspberry Pi OS based on Debian 13 (trixie) is supported\n'
    return 0
  fi
  if [ "$_ps" != "16384" ]; then
    printf 'not-applicable\tthis server uses %s-byte memory pages, not the 16 KiB Raspberry Pi kernel\n' "$_ps"
    return 0
  fi
  if [ ! -f "$KF_BOOT_DIR/config.txt" ] || [ -L "$KF_BOOT_DIR/config.txt" ]; then
    printf 'blocked\t%s is missing\n' "/boot/firmware/config.txt"
    return 0
  fi
  if [ ! -f "$KF_BOOT_DIR/kernel8.img" ] || [ -L "$KF_BOOT_DIR/kernel8.img" ]; then
    printf 'blocked\tthe 4 KiB kernel (kernel8.img) is not on the boot partition\n'
    return 0
  fi
  _mods=0
  for _m in "$P"/lib/modules/*-rpi-v8; do
    if [ -d "$_m" ]; then _mods=1; fi
  done
  if [ "$_mods" != "1" ]; then
    printf 'blocked\tthe modules for the 4 KiB kernel (*-rpi-v8) are not installed\n'
    return 0
  fi
  if grep -qi '^[[:space:]]*auto_initramfs[[:space:]]*=[[:space:]]*1' "$KF_BOOT_DIR/config.txt" &&
    { [ ! -f "$KF_BOOT_DIR/initramfs8" ] || [ -L "$KF_BOOT_DIR/initramfs8" ]; }; then
    printf 'blocked\tconfig.txt turns on auto_initramfs but initramfs8 is missing from the boot partition\n'
    return 0
  fi
  case "$(kf_bootcfg_scan "$KF_BOOT_DIR/config.txt")" in
    other)
      printf 'blocked\tconfig.txt already chooses a different kernel, so it is left as it is\n'
      ;;
    kernel8-top)
      printf 'restart-needed\tthe switch is saved in config.txt; the server needs a restart\n'
      ;;
    *)
      printf 'switchable\tthis server can switch to the 4 KiB kernel (a restart is needed)\n'
      ;;
  esac
}

# Prints the backup path (nothing when already in place).
kf_pi_4k_pagesize_apply() {
  # The marker goes first: if the edit then fails, a marker without the line is
  # harmless (undo cleans it up); the line without a marker would never be undone.
  mkdir -p -- "$KF_MARKER_DIR" || return 1
  date -u +%Y-%m-%dT%H:%M:%SZ > "$KF_MARKER_DIR/pi-4k-pagesize.applied" || return 1
  _ap_backup="$(kf_bootcfg_add_top "$KF_BOOT_DIR/config.txt" "$KF_LINE")" || {
    # A failure after the replace leaves the line in place: keep the marker so
    # undo can still remove it. Drop it only when the line never got there.
    if [ "$(kf_bootcfg_scan "$KF_BOOT_DIR/config.txt" 2>/dev/null)" != "kernel8-top" ]; then
      rm -f -- "$KF_MARKER_DIR/pi-4k-pagesize.applied"
    fi
    return 1
  }
  [ -n "$_ap_backup" ] || return 1
  printf '%s\n' "$_ap_backup"
}

# Prints the backup path, or nothing when the line is no longer at the top.
# The caller has already checked that the marker exists.
kf_pi_4k_pagesize_undo() {
  _un_marker="$KF_MARKER_DIR/pi-4k-pagesize.applied"
  if [ "$(kf_bootcfg_scan "$KF_BOOT_DIR/config.txt")" != "kernel8-top" ]; then
    rm -f -- "$_un_marker"
    return 0
  fi
  _un_backup="$(kf_bootcfg_remove_top "$KF_BOOT_DIR/config.txt" "$KF_LINE")" || return 1
  [ -n "$_un_backup" ] || return 1
  rm -f -- "$_un_marker"
  printf '%s\n' "$_un_backup"
}

# --- backend: boot-cmdline -----------------------------------------------------

# The first line of FILE without its line ending. The Raspberry Pi firmware
# reads only that one line.
kf_cmdline_line() {
  head -n 1 "$1" | tr -d '\r\n'
}

# True when FILE holds anything but blank lines after its first line.
kf_cmdline_extra_lines() {
  tail -n +2 "$1" | tr -d ' \t\r\n' | grep -q .
}

# Prints "list", "enable", "disable" or "none" for the memory words of LINE.
# "list" wins: a cgroup_disable= word with a comma list that names memory was
# written by a person on purpose. Otherwise the last of cgroup_enable=memory
# and cgroup_disable=memory decides, the way the kernel applies its words in
# order.
kf_cmdline_mem_scan() {
  printf '%s\n' "$1" | awk -v on="$KF_MEM_WORD" -v off="$KF_MEM_OFF_WORD" '
    {
      for (i = 1; i <= NF; i++) {
        w = $i
        if (w == on) last = "enable"
        else if (w == off) last = "disable"
        else if (w ~ /^cgroup_disable=/) {
          v = w
          sub(/^cgroup_disable=/, "", v)
          n = split(v, parts, ",")
          for (j = 1; j <= n; j++) if (parts[j] == "memory") list = 1
        }
      }
    }
    END {
      if (list) print "list"
      else if (last != "") print last
      else print "none"
    }
  '
}

# LINE with memory limits turned on: every cgroup_disable=memory word removed
# (the remaining words joined by one space) and cgroup_enable=memory added at
# the end unless the line already has it. A line with neither word keeps its
# own spacing and only gets the word appended.
kf_cmdline_enable_line() {
  printf '%s\n' "$1" | awk -v on="$KF_MEM_WORD" -v off="$KF_MEM_OFF_WORD" '
    {
      line = $0
      drop = 0
      for (i = 1; i <= NF; i++) if ($i == off) drop = 1
      if (drop) {
        out = ""
        for (i = 1; i <= NF; i++) if ($i != off) out = out (out == "" ? "" : " ") $i
        line = out
      }
      n = split(line, words, /[ \t]+/)
      for (i = 1; i <= n; i++) if (words[i] == on) { print line; next }
      sub(/[ \t]+$/, "", line)
      print (line == "" ? on : line " " on)
    }
  '
}

# The line undo writes: BEFORE when CURRENT is still exactly what apply wrote
# (AFTER); otherwise CURRENT without its cgroup_enable=memory words (the words
# that are left joined by one space), or CURRENT itself when it has none.
kf_cmdline_undo_line() {
  if [ "$1" = "$3" ]; then
    printf '%s\n' "$2"
    return 0
  fi
  printf '%s\n' "$1" | awk -v on="$KF_MEM_WORD" '
    {
      found = 0
      for (i = 1; i <= NF; i++) if ($i == on) found = 1
      if (!found) { print; next }
      out = ""
      for (i = 1; i <= NF; i++) if ($i != on) out = out (out == "" ? "" : " ") $i
      print out
    }
  '
}

# Replace the first line of FILE with LINE and keep everything after it byte
# for byte (the first line's own CR and newline too, or none when the file has
# no line ending). Same steps as the config.txt edits: backup copy, temporary
# name in the same directory, `mv -T`, read back. Prints the backup path.
kf_cmdline_write() {
  _cw_file="$1"
  _cw_line="$2"
  _cw_dir="${_cw_file%/*}"
  _cw_name="${_cw_file##*/}"
  CDPATH='' cd -P -- "$_cw_dir" || tp_die "cannot enter $_cw_dir"
  [ "$(pwd -P)" = "$_cw_dir" ] || tp_die "refusing $_cw_dir: a component is a symlink"
  [ -f "$_cw_name" ] && [ ! -L "$_cw_name" ] || tp_die "$_cw_file is not a plain file"
  _cw_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  _cw_backup="$_cw_name.tp-backup-$_cw_stamp"
  _cw_new=".$_cw_name.tp-new.$$"
  _cw_n=1
  while [ -e "$_cw_backup" ]; do
    _cw_backup="$_cw_name.tp-backup-$_cw_stamp-$_cw_n"
    _cw_n=$((_cw_n + 1))
  done
  trap 'rm -f -- "$_cw_new"' EXIT
  cp -- "$_cw_name" "$_cw_backup" || tp_die "cannot save a backup copy of $_cw_file"
  cmp -s -- "$_cw_name" "$_cw_backup" || tp_die "the backup does not match $_cw_file"
  _cw_cr="$(kf_bootcfg_cr "$_cw_name")"
  _cw_nl=""
  if [ "$(head -n 1 "$_cw_name" | tail -c 1 | od -An -tx1 | tr -d ' \n')" = "0a" ]; then
    _cw_nl=1
  fi
  (
    set -C
    : > "$_cw_new"
  ) || tp_die "cannot create a temporary file in $_cw_dir"
  {
    printf '%s' "$_cw_line"
    if [ -n "$_cw_nl" ]; then printf '%s\n' "$_cw_cr"; fi
    tail -n +2 -- "$_cw_name"
  } > "$_cw_new" || tp_die "cannot write the new $_cw_file"
  [ "$(kf_cmdline_line "$_cw_new")" = "$_cw_line" ] ||
    tp_die "the new $_cw_file does not hold the new line"
  _cw_want=$(($(printf '%s' "$_cw_line" | wc -c) + $(tail -n +2 -- "$_cw_name" | wc -c)))
  if [ -n "$_cw_nl" ]; then
    _cw_want=$((_cw_want + 1 + $(printf '%s' "$_cw_cr" | wc -c)))
  fi
  [ "$(wc -c < "$_cw_new")" -eq "$_cw_want" ] ||
    tp_die "the new file does not keep the rest of $_cw_file"
  mv -T -f -- "$_cw_new" "$_cw_name" || tp_die "cannot replace $_cw_file"
  trap - EXIT
  sync || tp_die "cannot flush $_cw_file to disk"
  [ "$(kf_cmdline_line "$_cw_name")" = "$_cw_line" ] ||
    tp_die "$_cw_file does not read back with the new line"
  printf '%s/%s\n' "$_cw_dir" "$_cw_backup"
}

# --- feature: pi-memory-cgroup ----------------------------------------------------

# Prints STATE<TAB>reason.
kf_pi_memory_cgroup_state() {
  _mc_controllers="$P/sys/fs/cgroup/cgroup.controllers"
  if [ ! -f "$_mc_controllers" ]; then
    printf 'not-applicable\tthis server does not use the unified control group hierarchy (cgroup v2)\n'
    return 0
  fi
  if tr ' \t' '\n\n' < "$_mc_controllers" | grep -qx memory; then
    printf 'ready\tthe memory controller is on, so memory limits are enforced\n'
    return 0
  fi
  case "$(kf_model)" in
    *"Raspberry Pi"*) ;;
    *)
      printf 'not-applicable\tthis server is not a Raspberry Pi\n'
      return 0
      ;;
  esac
  _mc_file="$KF_BOOT_DIR/cmdline.txt"
  if [ ! -f "$_mc_file" ] || [ -L "$_mc_file" ]; then
    printf 'blocked\t%s is missing\n' "/boot/firmware/cmdline.txt"
    return 0
  fi
  if kf_cmdline_extra_lines "$_mc_file"; then
    printf 'blocked\t/boot/firmware/cmdline.txt has more than one line, so it is left as it is\n'
    return 0
  fi
  _mc_running="$(tr '\000\r\n' '   ' 2>/dev/null < "$P/proc/cmdline" || true)"
  case "$(kf_cmdline_mem_scan "$_mc_running")" in
    enable)
      printf 'blocked\tthis kernel was started with cgroup_enable=memory but the memory controller is still missing, so a restart would not turn it on\n'
      return 0
      ;;
    none)
      printf 'not-applicable\tthe memory controller is missing, but not because of the Raspberry Pi boot setting (cgroup_disable=memory is not on the kernel command line)\n'
      return 0
      ;;
  esac
  case "$(kf_cmdline_mem_scan "$(kf_cmdline_line "$_mc_file")")" in
    list)
      printf 'blocked\tcmdline.txt turns off control groups itself, so it is left as it is\n'
      ;;
    enable)
      printf 'restart-needed\tmemory limits are saved in cmdline.txt; the server needs a restart\n'
      ;;
    *)
      printf 'switchable\tthis server can turn on memory limits (a restart is needed)\n'
      ;;
  esac
}

# Prints the backup path. The marker records the line before and after, so
# undo can put the line back exactly as it was.
kf_pi_memory_cgroup_apply() {
  _ma_file="$KF_BOOT_DIR/cmdline.txt"
  _ma_marker="$KF_MARKER_DIR/pi-memory-cgroup.applied"
  _ma_before="$(kf_cmdline_line "$_ma_file")" || return 1
  _ma_after="$(kf_cmdline_enable_line "$_ma_before")" || return 1
  [ -n "$_ma_after" ] && [ "$_ma_after" != "$_ma_before" ] || return 1
  # The marker goes first, as for pi-4k-pagesize: a marker without the change
  # is harmless, the change without a marker would never be undone.
  mkdir -p -- "$KF_MARKER_DIR" || return 1
  {
    printf 'applied=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'before=%s\n' "$_ma_before"
    printf 'after=%s\n' "$_ma_after"
  } > "$_ma_marker" || return 1
  _ma_backup="$(kf_cmdline_write "$_ma_file" "$_ma_after")" || {
    if [ "$(kf_cmdline_line "$_ma_file" 2>/dev/null)" != "$_ma_after" ]; then
      rm -f -- "$_ma_marker"
    fi
    return 1
  }
  [ -n "$_ma_backup" ] || return 1
  printf '%s\n' "$_ma_backup"
}

# Prints the backup path, or nothing when the word is no longer there.
# The caller has already checked that the marker exists.
kf_pi_memory_cgroup_undo() {
  _mu_file="$KF_BOOT_DIR/cmdline.txt"
  _mu_marker="$KF_MARKER_DIR/pi-memory-cgroup.applied"
  if [ ! -f "$_mu_file" ] || [ -L "$_mu_file" ]; then
    rm -f -- "$_mu_marker"
    return 0
  fi
  _mu_current="$(kf_cmdline_line "$_mu_file")"
  _mu_before="$(sed -n 's/^before=//p' "$_mu_marker" | head -n 1)"
  _mu_after="$(sed -n 's/^after=//p' "$_mu_marker" | head -n 1)"
  _mu_new="$(kf_cmdline_undo_line "$_mu_current" "$_mu_before" "$_mu_after")"
  if [ "$_mu_new" = "$_mu_current" ]; then
    rm -f -- "$_mu_marker"
    return 0
  fi
  _mu_backup="$(kf_cmdline_write "$_mu_file" "$_mu_new")" || return 1
  [ -n "$_mu_backup" ] || return 1
  rm -f -- "$_mu_marker"
  printf '%s\n' "$_mu_backup"
}

# --- per-feature words for messages -------------------------------------------------

kf_feature_file() {
  case "$1" in
    pi-4k-pagesize) printf '/boot/firmware/config.txt\n' ;;
    pi-memory-cgroup) printf '/boot/firmware/cmdline.txt\n' ;;
  esac
}

kf_feature_change() {
  case "$1" in
    pi-4k-pagesize) printf 'the line kernel=kernel8.img\n' ;;
    pi-memory-cgroup) printf 'the word cgroup_enable=memory\n' ;;
  esac
}

# True when the feature's change is in its boot file.
kf_feature_saved() {
  case "$1" in
    pi-4k-pagesize)
      [ "$(kf_bootcfg_scan "$KF_BOOT_DIR/config.txt" 2>/dev/null)" = "kernel8-top" ]
      ;;
    pi-memory-cgroup)
      [ -f "$KF_BOOT_DIR/cmdline.txt" ] &&
        [ "$(kf_cmdline_mem_scan "$(kf_cmdline_line "$KF_BOOT_DIR/cmdline.txt" 2>/dev/null)")" = "enable" ]
      ;;
    *) return 1 ;;
  esac
}

kf_needs_reboot() {
  case "$1" in
    pi-4k-pagesize|pi-memory-cgroup) return 0 ;;
  esac
  return 1
}

kf_fn() {
  # pi-4k-pagesize -> kf_pi_4k_pagesize_<what>
  printf 'kf_%s_%s' "$(printf '%s' "$1" | tr '-' '_')" "$2"
}

kf_known() {
  for _k in $KF_IDS; do
    [ "$_k" = "$1" ] && return 0
  done
  return 1
}

# --- reboot ----------------------------------------------------------------------

kf_manual_reboot_hint() {
  printf 'To finish, restart this server yourself when it suits you:\n  sudo reboot\n'
}

# With TP_KF_ENROL_REF set (the installer does this), the three enrolment files
# must be newer than that file, so files left by an earlier enrolment do not
# count. A person running the command on an already enrolled server has no such
# reference and the files simply have to exist.
kf_enrol_files_fresh() {
  [ -n "${TP_KF_ENROL_REF:-}" ] || return 0
  [ -f "$TP_KF_ENROL_REF" ] || return 1
  for _ef in "$KF_STATE_DIR/server.id" "$KF_STATE_DIR/server-key-id" "$1"; do
    [ -n "$(find "$_ef" -newer "$TP_KF_ENROL_REF" 2>/dev/null)" ] || return 1
  done
}

# The daemon must have saved its enrolment before a restart.
kf_wait_enrolled() {
  # Fail closed: with no state folder there is nothing to prove the enrolment
  # is saved, so the server is not restarted.
  [ -d "$KF_STATE_DIR" ] || return 1
  _we_waited=0
  _we_max=120
  [ -z "$TP_TEST" ] || _we_max="${TP_KERNEL_TEST_ENROL_WAIT:-0}"
  while :; do
    # The saved server key file is matched by glob (its name ends in .j*).
    set -- "$KF_STATE_DIR"/server-key.j*
    if [ -s "$KF_STATE_DIR/server.id" ] && [ -s "$KF_STATE_DIR/server-key-id" ] &&
      [ -s "$1" ] && kf_enrol_files_fresh "$1"; then
      return 0
    fi
    [ "$_we_waited" -lt "$_we_max" ] || return 1
    [ "$_we_waited" -gt 0 ] || printf 'Waiting for this server to finish enrolling with TurboPanel before restarting…\n'
    if [ -z "$TP_TEST" ]; then sleep 2; fi
    _we_waited=$((_we_waited + 2))
  done
}

# On a first install (TP_KF_ENROL_REF set), the daemon's first setup run on
# this boot must have finished: it writes KF_CONVERGE_DONE when it has, and
# the file must be newer than the installer's start marker. A person running
# the command by hand on a server that is already set up does not wait here.
kf_wait_converged() {
  [ -n "${TP_KF_ENROL_REF:-}" ] || return 0
  _wc_waited=0
  _wc_max=1200
  [ -z "$TP_TEST" ] || _wc_max="${TP_KERNEL_TEST_CONVERGE_WAIT:-0}"
  while :; do
    if [ -f "$KF_CONVERGE_DONE" ] && [ -f "$TP_KF_ENROL_REF" ] &&
      [ -n "$(find "$KF_CONVERGE_DONE" -newer "$TP_KF_ENROL_REF" 2>/dev/null)" ]; then
      return 0
    fi
    [ "$_wc_waited" -lt "$_wc_max" ] || return 1
    [ "$_wc_waited" -gt 0 ] || printf 'Waiting for TurboPanel to finish setting up this server before restarting (this can take several minutes)…\n'
    if [ -z "$TP_TEST" ]; then sleep 5; fi
    _wc_waited=$((_wc_waited + 5))
  done
}

# Prints the name of the first package tool or setup run that is running and
# returns 0; returns 1 when none is. A restart must never cut one short.
kf_busy() {
  for _bp in "$P"/proc/[0-9]*; do
    [ -d "$_bp" ] || continue
    _bc="$(cat "$_bp/comm" 2>/dev/null || true)"
    case "$_bc" in
      dpkg|dpkg-deb|dpkg-trigger|apt|apt-get|aptitude|apt.systemd.dai*|unattended-upgr*|ansible-playboo*)
        printf '%s\n' "$_bc"
        return 0
        ;;
    esac
    case "$(tr '\000' ' ' 2>/dev/null < "$_bp/cmdline" || true)" in
      *ansible-playbook*|*AnsiballZ_*)
        printf 'ansible-playbook\n'
        return 0
        ;;
    esac
  done
  return 1
}

kf_wait_idle() {
  _wi_waited=0
  _wi_max=600
  [ -z "$TP_TEST" ] || _wi_max="${TP_KERNEL_TEST_IDLE_WAIT:-0}"
  while _wi_what="$(kf_busy)"; do
    [ "$_wi_waited" -lt "$_wi_max" ] || return 1
    [ "$_wi_waited" -gt 0 ] || printf 'Waiting for %s to finish before restarting…\n' "$_wi_what"
    if [ -z "$TP_TEST" ]; then sleep 2; fi
    _wi_waited=$((_wi_waited + 2))
  done
  return 0
}

KF_DAEMON_STOPPED=""

# Stop the daemon so it starts nothing new (a playbook, an apt run) during the
# countdown. Returns 1 when it is running and could not be stopped.
kf_daemon_stop() {
  if [ -n "$TP_TEST" ]; then
    [ "${TP_KERNEL_TEST_DAEMON_ACTIVE:-}" = "1" ] || return 0
    printf 'Stopping the TurboPanel daemon so it starts nothing new before the restart…\n'
    printf 'stop\n' >> "${TP_KERNEL_TEST_SYSTEMCTL_LOG:-/dev/null}"
  else
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl is-active --quiet "$KF_DAEMON_UNIT" 2>/dev/null || return 0
    printf 'Stopping the TurboPanel daemon so it starts nothing new before the restart…\n'
    systemctl stop "$KF_DAEMON_UNIT" || return 1
  fi
  KF_DAEMON_STOPPED=1
}

kf_daemon_start_again() {
  [ -n "$KF_DAEMON_STOPPED" ] || return 0
  KF_DAEMON_STOPPED=""
  if [ -n "$TP_TEST" ]; then
    printf 'start\n' >> "${TP_KERNEL_TEST_SYSTEMCTL_LOG:-/dev/null}"
  else
    systemctl start "$KF_DAEMON_UNIT" || {
      printf 'The TurboPanel daemon could not be started again; start it with: sudo systemctl start %s\n' "$KF_DAEMON_UNIT"
      return 0
    }
  fi
  printf 'The TurboPanel daemon is running again.\n'
}

# Every check that has to pass before a restart, then the countdown. Any check
# that fails means no restart and the manual command instead.
kf_reboot_when_safe() {
  if ! kf_wait_enrolled; then
    printf 'This server has not finished enrolling with TurboPanel yet, so it will not restart on its own.\n'
    kf_manual_reboot_hint
    return 0
  fi
  if ! kf_wait_converged; then
    printf 'TurboPanel has not finished setting up this server yet, so it will not restart on its own.\n'
    printf 'Wait until the server shows as ready in TurboPanel, then restart it.\n'
    kf_manual_reboot_hint
    return 0
  fi
  if ! kf_wait_idle; then
    printf 'Software is still being installed on this server, so it will not restart on its own.\n'
    kf_manual_reboot_hint
    return 0
  fi
  if ! kf_daemon_stop; then
    printf 'The TurboPanel daemon could not be stopped, so this server will not restart on its own.\n'
    kf_manual_reboot_hint
    return 0
  fi
  if _rs_what="$(kf_busy)"; then
    printf '%s started just now, so this server will not restart on its own.\n' "$_rs_what"
    kf_daemon_start_again
    kf_manual_reboot_hint
    return 0
  fi
  kf_countdown_and_reboot "$1"
}

kf_countdown_and_reboot() {
  _cd_total="$1"
  trap 'printf "\n"; printf "Restart cancelled.\n"; kf_daemon_start_again; kf_manual_reboot_hint; exit 130' INT TERM
  _cd_tty=""
  if [ -t 1 ]; then _cd_tty=1; fi
  _cd_n="$_cd_total"
  while [ "$_cd_n" -gt 0 ]; do
    if [ -n "$_cd_tty" ]; then
      printf '\rRestarting in %s second(s)… press Ctrl-C to cancel   ' "$_cd_n"
    else
      printf 'Restarting in %s second(s)…\n' "$_cd_n"
    fi
    if [ -z "$TP_TEST" ]; then sleep 1; fi
    _cd_n=$((_cd_n - 1))
  done
  if [ -n "$_cd_tty" ]; then printf '\r%60s\r' ''; fi
  printf 'Restarting now.\n'
  trap - INT TERM
  sync
  if [ -n "$TP_TEST" ]; then
    # shellcheck disable=SC2086
    ${TP_KERNEL_TEST_REBOOT_CMD:-true}
    return 0
  fi
  systemctl reboot
}

# --- verbs -------------------------------------------------------------------------

kf_verb_list() {
  [ $# -eq 0 ] || tp_die "list takes no arguments"
  for _id in $KF_IDS; do printf '%s\n' "$_id"; done
}

kf_verb_status() {
  [ $# -le 1 ] || tp_die "status takes at most one feature id"
  if [ $# -eq 1 ]; then
    kf_known "$1" || tp_die "unknown feature: $1"
    _ids="$1"
  else
    _ids="$KF_IDS"
  fi
  for _id in $_ids; do
    printf '%s\t' "$_id"
    "$(kf_fn "$_id" state)"
  done
}

# Said when a step of the switch failed. It says what state the file is in,
# because a failure after the replace leaves the new line in place.
kf_apply_failed() {
  _af_file="$(kf_feature_file "$1")"
  if kf_feature_saved "$1"; then
    tp_die "$(kf_feature_change "$1") was written to $_af_file but the change could not be confirmed, so the server will not restart; check that file (a backup copy is next to it) or undo it with the undo command"
  fi
  tp_die "the change could not be saved and $_af_file is unchanged, so the server will not restart"
}

kf_verb_apply() {
  [ $# -ge 1 ] || tp_die "apply needs a feature id"
  _id="$1"
  shift
  kf_known "$_id" || tp_die "unknown feature: $_id"
  _reboot=""
  _countdown=10
  while [ $# -gt 0 ]; do
    case "$1" in
      --reboot) _reboot=1 ;;
      --countdown)
        [ $# -ge 2 ] || tp_die "--countdown needs a number of seconds"
        case "$2" in ''|*[!0-9]*) tp_die "--countdown needs a number of seconds" ;; esac
        [ "$2" -ge 3 ] && [ "$2" -le 300 ] || tp_die "--countdown must be between 3 and 300 seconds"
        _countdown="$2"
        shift
        ;;
      *) tp_die "unknown option: $1" ;;
    esac
    shift
  done
  _line="$("$(kf_fn "$_id" state)")"
  _state="${_line%%"$(printf '\t')"*}"
  _reason="${_line#*"$(printf '\t')"}"
  _changed=no
  _backup=""
  case "$_state" in
    ready)
      printf 'kernel-feature %s state=ready changed=no\n' "$_id"
      printf '%s.\n' "$_reason"
      return 0
      ;;
    not-applicable)
      printf 'kernel-feature %s state=not-applicable changed=no\n' "$_id"
      printf 'Nothing to do: %s.\n' "$_reason"
      return 3
      ;;
    blocked)
      printf 'kernel-feature %s state=blocked changed=no\n' "$_id"
      tp_die "$_reason"
      ;;
    switchable)
      _backup="$("$(kf_fn "$_id" apply)")" || kf_apply_failed "$_id"
      [ -n "$_backup" ] || kf_apply_failed "$_id"
      _post="$("$(kf_fn "$_id" state)")" || tp_die "cannot read back the state, so the server will not restart"
      case "$_post" in
        restart-needed*) ;;
        *) tp_die "the change was written but does not read back as saved, so the server will not restart" ;;
      esac
      _changed=yes
      _state=restart-needed
      printf 'kernel-feature %s state=restart-needed changed=yes backup=%s\n' "$_id" "$_backup"
      printf 'Saved. A copy of the old boot settings is at %s.\n' "$_backup"
      ;;
    restart-needed)
      printf 'kernel-feature %s state=restart-needed changed=no\n' "$_id"
      printf '%s.\n' "$_reason"
      ;;
  esac
  if kf_needs_reboot "$_id" && [ "$_state" = "restart-needed" ]; then
    if [ -z "$_reboot" ]; then
      # The installer applies every feature first and restarts once.
      [ -z "${KF_ONE_RESTART_LATER:-}" ] || return 0
      printf 'The change takes effect after a restart.\n'
      kf_manual_reboot_hint
      return 0
    fi
    kf_reboot_when_safe "$_countdown"
  fi
}

kf_verb_undo() {
  [ $# -eq 1 ] || tp_die "undo needs exactly one feature id"
  kf_known "$1" || tp_die "unknown feature: $1"
  _un_file="$(kf_feature_file "$1")"
  _un_change="$(kf_feature_change "$1")"
  if [ ! -f "$KF_MARKER_DIR/$1.applied" ]; then
    printf 'kernel-feature %s changed=no\n' "$1"
    printf 'Nothing to undo: this tool did not add %s. If you added it yourself, remove it from %s by hand.\n' "$_un_change" "$_un_file"
    return 0
  fi
  _backup="$("$(kf_fn "$1" undo)")" || tp_die "the change could not be undone; $_un_file is as it was"
  if [ -z "$_backup" ]; then
    printf 'kernel-feature %s changed=no\n' "$1"
    printf 'TurboPanel added %s earlier, but it is no longer where it was put in %s (it was changed or removed since), so nothing was removed. Check that file by hand.\n' "$_un_change" "$_un_file"
    return 0
  fi
  printf 'kernel-feature %s changed=yes backup=%s\n' "$1" "$_backup"
  printf 'Removed. A copy of the boot settings from before is at %s. The change takes effect after the next restart.\n' "$_backup"
}

# What the installer says about a feature that is about to change.
kf_installer_why() {
  case "$1" in
    pi-4k-pagesize)
      printf 'This Raspberry Pi runs the 16 KiB kernel, which the database proxy cannot use.\n'
      ;;
    pi-memory-cgroup)
      printf 'This Raspberry Pi starts with memory limits turned off (cgroup_disable=memory), so memory limits on services and containers are not enforced.\n'
      ;;
  esac
}

kf_installer_what() {
  case "$1" in
    pi-4k-pagesize) printf 'switch it to the 4 KiB kernel' ;;
    pi-memory-cgroup) printf 'turn memory limits on' ;;
  esac
}

kf_installer_blocked() {
  case "$1" in
    pi-4k-pagesize) printf 'Not switching this Raspberry Pi to the 4 KiB kernel: %s.\n' "$2" ;;
    pi-memory-cgroup) printf 'Not turning memory limits on for this Raspberry Pi: %s.\n' "$2" ;;
  esac
}

kf_verb_installer_step() {
  [ $# -eq 0 ] || tp_die "installer-step takes no arguments"
  if [ "${TURBOPANEL_SKIP_KERNEL_SWITCH:-}" = "1" ]; then
    printf 'Skipping the kernel switch (TURBOPANEL_SKIP_KERNEL_SWITCH=1).\n'
    return 0
  fi
  _todo=""
  for _id in $KF_IDS; do
    if [ "$_id" = "pi-memory-cgroup" ] && [ "${TURBOPANEL_SKIP_MEMORY_LIMITS_SWITCH:-}" = "1" ]; then
      printf 'Skipping the memory limits switch (TURBOPANEL_SKIP_MEMORY_LIMITS_SWITCH=1).\n'
      continue
    fi
    _line="$("$(kf_fn "$_id" state)")"
    _state="${_line%%"$(printf '\t')"*}"
    _reason="${_line#*"$(printf '\t')"}"
    case "$_state" in
      switchable|restart-needed) _todo="${_todo:+$_todo }$_id" ;;
      blocked) kf_installer_blocked "$_id" "$_reason" ;;
    esac
  done
  [ -n "$_todo" ] || return 0
  if [ "${TP_KF_FIRST_INSTALL:-}" != "1" ]; then
    printf '\n'
    for _id in $_todo; do kf_installer_why "$_id"; done
    printf 'Only a first install restarts the server by itself. To change it yourself:\n'
    for _id in $_todo; do
      printf '  sudo %s kernel-features apply %s\n' "$KF_CMD" "$_id"
    done
    printf 'then restart the server once: sudo reboot\n\n'
    return 0
  fi
  printf '\nInstall finished. TurboPanel is installed and set to start by itself.\n'
  _what=""
  for _id in $_todo; do
    kf_installer_why "$_id"
    _what="${_what:+$_what and }$(kf_installer_what "$_id")"
  done
  printf 'TurboPanel will %s, then restart this server once.\n' "$_what"
  printf 'It comes back by itself in about a minute. To skip this next time, set TURBOPANEL_SKIP_KERNEL_SWITCH=1'
  case " $_todo " in
    *" pi-memory-cgroup "*) printf ' (or TURBOPANEL_SKIP_MEMORY_LIMITS_SWITCH=1 to keep memory limits off)' ;;
  esac
  printf '.\n'
  for _id in $_todo; do
    printf 'To undo it later: sudo %s kernel-features undo %s\n' "$KF_CMD" "$_id"
  done
  printf '\n'
  # Save every change first, then restart once. No `|| true`: that would
  # switch off `set -e` inside the apply, and a failed step could then carry
  # on to a restart. A failure here ends the script (nonzero, with a message)
  # before any countdown.
  KF_ONE_RESTART_LATER=1
  for _id in $_todo; do
    kf_verb_apply "$_id"
  done
  KF_ONE_RESTART_LATER=""
  if [ -f "$P/run/turbopanel/update-guard.json" ]; then
    printf 'An update is still being checked, so this server will not restart on its own.\n'
    kf_manual_reboot_hint
    return 0
  fi
  kf_reboot_when_safe 10
}

_verb="${1:-}"
[ -n "$_verb" ] || tp_die "usage: tp-kernel-features list|status [ID]|apply ID [--reboot] [--countdown N]|undo ID|installer-step"
shift
case "$_verb" in
  list) kf_verb_list "$@" ;;
  status) kf_verb_status "$@" ;;
  apply) kf_verb_apply "$@" ;;
  undo) kf_verb_undo "$@" ;;
  installer-step) kf_verb_installer_step "$@" ;;
  *) tp_die "unknown verb: $_verb" ;;
esac
