#!/bin/sh
# tp-build-loopback — keeps sandboxed builds off the platform's loopback ports
# (POSIX sh, root:root, installed next to tp-host in lib/).
#
# A build (`tp-host build-run`) shares the host's network. Turbopack (Next.js)
# starts helper processes that talk to each other over 127.0.0.1 on ports the
# build picks itself, so the build unit may use loopback. systemd filters by
# address only, so this script adds the port filter: one nftables table,
# `inet turbopanel_build`, whose output hook (same hook and priority as
# tp-php-loopback's table) refuses anything the running build sends to
# 127.0.0.0/8 or ::1 on a port in DENY_PORTS below: every fixed port the
# platform listens on (database proxy and its admin and metrics ports, the
# panel, the hosting web servers and their metrics and admin ports, the site and
# app listen bands). Every other loopback port stays open, and so does the
# resolver stub (53) because it is not listed.
#
# Which traffic is the build's: every build runs as a throwaway user systemd
# creates for that run (DynamicUser=yes), so there is no fixed uid to match.
# The rules match the build unit's own cgroup instead (`socket cgroupv2`):
# every process of turbopanel-build-<id>.service, whatever uid it runs as, and
# nothing else on the host. nftables turns the cgroup path into its id when the
# rules load, so they can only be loaded once the unit's cgroup exists: the unit
# runs `sync <build-id> <owner>` itself, as its `ExecStartPre=+` (inside it),
# before the build's first command (FAILS CLOSED: when this exits non-zero the
# build does not start). A cgroup id is never reused, so rules left behind by a finished build
# match nothing.
#
# Residual risk, accepted by the owner: a loopback service on a port that is
# NOT in DENY_PORTS (for example a Docker port a site owner published on
# 127.0.0.1 with an ephemeral port) is reachable from a build. nftables cannot
# tell "a port this build listens on" from "a port another service listens on".
#
# Replies: `ct state established,related accept` comes first so the build's own
# local servers can answer their clients; its new connections hit the filter.
#
# One verb, `sync`, run as root:
#   sync            by `tp-host build-run` before the unit exists: loads the
#                   table with no build rule (the previous build's go), which
#                   also proves nft works before a build is started.
#   sync BUILD-ID OWNER
#                   by turbopanel-build-<BUILD-ID>.service as `ExecStartPre=+`:
#                   loads the rules for that unit's cgroup, which must be
#                   exactly the one systemd builds for OWNER's build slice.
# The whole table is replaced in one atomic nft transaction and read back.
#
# Needs `nft` and `flock` (Ansible installs the nftables and util-linux
# packages). When either is missing the script exits non-zero and says so.
set -eu
umask 077

# The one list of ports the build is refused on loopback, tcp and udp. Single
# ports and inclusive ranges. Pinned to the code that owns each port by
# src/orchestration/build-loopback.test.ts.
#   22 ssh, 80 443 hosting web server, 2019 2029 2039 web server admin APIs,
#   6032 6070 6132 database proxy admin and metrics, 7080 7081 7443 shared
#   router and its metrics, 8443 the panel, 9400 GPU metrics, 13306 15432
#   database proxy, 19080 19820 web server bootstrap and website, 33001 33002
#   database HA, 18080-18999 and 19100-19799 site and app listen bands,
#   5672 15672 RabbitMQ (AMQP and management, published on 127.0.0.1),
#   5432 platform Postgres (when postgres_expose_port is true), 3306 legacy
#   ProxySQL. Nothing is denied inside the kernel ephemeral range
#   (32768-60999): a build worker may be handed any port there.
DENY_PORTS="22 80 443 2019 2029 2039 5672 6032 6070 6132 7080 7081 7443 8443 9400 13306 15432 15672 19080 19820 33001 33002 5432 3306 18080-18999 19100-19799"
PATH=/usr/sbin:/usr/bin:/sbin:/bin

tp_die() {
  printf 'tp-build-loopback: %s\n' "$*" >&2
  exit 1
}

if [ "$(id -u)" = "0" ]; then
  TP_TEST=""
  P=""
else
  [ -n "${TP_HOST_TEST_PREFIX:-}" ] || tp_die "must run as root"
  TP_TEST=1
  P="$TP_HOST_TEST_PREFIX"
fi

# The unit runs this with its own stdin, the build spec: never read it.
exec </dev/null

{ [ "$#" -eq 1 ] || [ "$#" -eq 3 ]; } && [ "$1" = "sync" ] || tp_die "only: sync [BUILD-ID OWNER]"

# The cgroup systemd builds for build $1 of owner $2 (kept equal to tp-host's
# tp_build_cgroup): the owner's slice is turbopanel-<owner>.slice with each `-`
# made `.` (a dash is a slice level), its build slice the same name plus
# `-build`; a build with no owner (tpbuild) sits in turbopanel-tpbuild.slice.
# Sets _cg (no leading slash) and _level (its depth).
expected_cgroup() {
  case "$1" in
    ''|-*|*[!a-z0-9-]*) tp_die "refusing build id $1" ;;
  esac
  [ "${#1}" -le 64 ] || tp_die "refusing build id $1"
  case "$2" in
    ''|-*|*-|*--*|*[!A-Za-z0-9_-]*) tp_die "refusing owner $2" ;;
  esac
  [ "${#2}" -le 32 ] || tp_die "refusing owner $2"
  if [ "$2" = "tpbuild" ]; then
    _cg="turbopanel.slice/turbopanel-tpbuild.slice/turbopanel-build-$1.service"
    _level=3
    return
  fi
  case "$2" in containers|tp*) tp_die "refusing owner $2" ;; esac
  _owner_slice="turbopanel-$(printf '%s' "$2" | tr -- '-' '.')"
  _cg="turbopanel.slice/$_owner_slice.slice/$_owner_slice-build.slice/turbopanel-build-$1.service"
  _level=4
}

# This script runs inside the build unit (its own ExecStartPre=+), so its
# cgroup must be exactly the expected one; run from anywhere else, it refuses.
_match=""
if [ "$#" -eq 3 ]; then
  expected_cgroup "$2" "$3"
  if [ -n "$TP_TEST" ]; then
    _self="$(cat -- "$P/run/self-cgroup" 2>/dev/null || true)"
  else
    _self="$(sed -n 's/^0:://p' /proc/self/cgroup)"
  fi
  [ "$_self" = "/$_cg" ] ||
    tp_die "not running in turbopanel-build-$2.service's own cgroup; builds cannot start without their network rules"
  _match="socket cgroupv2 level $_level \"$_cg\""
fi

ruleset() {
  _elems=""
  for _p in $DENY_PORTS; do _elems="${_elems:+$_elems, }$_p"; done
  cat <<RULES
add table inet turbopanel_build
delete table inet turbopanel_build
table inet turbopanel_build {
  set denied_ports {
    type inet_service
    flags interval
    elements = { $_elems }
  }
  chain output {
    type filter hook output priority -150; policy accept;
RULES
  if [ -n "$_match" ]; then
    cat <<RULES
    $_match ct state established,related accept
    $_match ip daddr 127.0.0.0/8 tcp dport @denied_ports reject with tcp reset
    $_match ip daddr 127.0.0.0/8 udp dport @denied_ports reject
    $_match ip6 daddr ::1 tcp dport @denied_ports reject with tcp reset
    $_match ip6 daddr ::1 udp dport @denied_ports reject
RULES
  fi
  printf '  }\n}\n'
}

_rules="$(ruleset)"

if [ -n "$TP_TEST" ]; then
  printf '%s\n' "$_rules"
  exit 0
fi

command -v nft >/dev/null 2>&1 || tp_die "nft is not installed (apt install nftables); builds cannot start without their network rules"
command -v flock >/dev/null 2>&1 || tp_die "flock is not installed (apt install util-linux)"
exec 9>/run/turbopanel-build-loopback.lock
flock 9
printf '%s\n' "$_rules" | nft -f - || tp_die "nft refused the build network rules; builds cannot start"
_live="$(nft list table inet turbopanel_build)" || tp_die "build network rules did not load"
printf '%s\n' "$_live" | grep -q "13306" || tp_die "build rules loaded without the port list"
if [ -n "$_match" ]; then
  printf '%s\n' "$_live" | grep -qF "socket cgroupv2 level $_level " ||
    tp_die "the build's cgroup is missing from the loaded build rules"
fi
