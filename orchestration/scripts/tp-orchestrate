#!/bin/sh
# TurboPanel root helper for the daemon account (POSIX sh).
#
# The only thing `tp` may run as root through sudo besides a fixed list of
# host utilities (see roles/turbopanel-user/templates/sudoers.j2). It exists
# because Ansible `become` from an unprivileged account needs `sudo /bin/sh`,
# which is a root shell — so production orchestration runs *this* as root
# instead, and `become: true` becomes a no-op.
#
# Verbs:
#   playbook -i localhost, -c local [-e key=value|-e '{json}']... <playbook.yml>
#       Run one of the shipped playbooks (a basename resolved under this
#       tree's playbooks/ — never a caller-supplied path). Each extra-var key
#       must be on the allowlist below with a value of the expected shape;
#       JSON objects are limited to TP_JSON_EXTRA_VAR_KEYS; @file is refused.
#       Everything else on the command line is refused.
#   galaxy-docker-role
#       Fetch the geerlingguy.docker role pinned in requirements-docker.yml
#       into the root-owned vendor roles dir (codeload tag tarball).
#   update --license <b64url> [--host URL] [--dl-base URL]
#          [--instance-ca /etc/turbopanel/instance-ca.pem] [--channel NAME]
#          [--manifest-url https://…] --no-start
#       Fetch run.sh (the CDN, or the control plane for an HTTPS overlay
#       host) and run it as root with exactly those flags. The
#       script body is never accepted from the caller, --insecure-tls is not
#       a recognised flag here, and the only CA the fetch trusts beyond the
#       system store is the daemon's canonical Platform CA file.
#
# Every input that could steer root is taken from this root-owned tree, not
# from the caller: the orchestration dir is derived from $0, ansible.cfg and
# ANSIBLE_ROLES_PATH are fixed, PATH is rebuilt, and Ansible's temp/home live
# in a root-only scratch directory (never a tp-writable one, which would let
# tp swap a staged module before root executes it).
set -eu

tp_die() {
  printf 'tp-orchestrate: %s\n' "$1" >&2
  exit 1
}

[ "$(id -u)" = "0" ] || tp_die "must run as root (sudo -n tp-orchestrate …)"

ORCH_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
INSTALL_ROOT="$(cd "$ORCH_DIR/../.." && pwd -P)"
VENDOR_DIR="$INSTALL_ROOT/vendor"
PLAYBOOKS_DIR="$ORCH_DIR/playbooks"
GALAXY_ROLES_DIR="$VENDOR_DIR/ansible/galaxy-roles"
ANSIBLE_PLAYBOOK_BIN="$VENDOR_DIR/ansible/current/bin/ansible-playbook"
# Root-only scratch. The well-known name is reused while it is a root-owned
# directory (so `exec ansible-playbook` leaves nothing behind per run). /tmp is
# sticky: another account can pre-create that name, and we cannot remove it.
# Never use such a path, and never let it block root either — take a private,
# unpredictable `mktemp -d` directory for this run instead.
ROOT_SCRATCH="/tmp/turbopanel-orchestrate"

tp_scratch_is_ours() {
  [ -d "$1" ] && [ ! -L "$1" ] &&
    [ "$(stat -c %u "$1" 2>/dev/null || echo -1)" = "$(id -u)" ]
}

tp_require_root_scratch() {
  if tp_scratch_is_ours "$ROOT_SCRATCH"; then
    chmod 0700 "$ROOT_SCRATCH"
    return 0
  fi
  if [ ! -e "$ROOT_SCRATCH" ] && [ ! -L "$ROOT_SCRATCH" ] &&
    mkdir -m 0700 "$ROOT_SCRATCH" 2>/dev/null; then
    return 0
  fi
  # Squatted (a symlink, or a directory another account created): not ours.
  ROOT_SCRATCH="$(mktemp -d /tmp/turbopanel-orchestrate.XXXXXXXX)" ||
    tp_die "cannot create a private scratch directory"
  chmod 0700 "$ROOT_SCRATCH"
}

tp_export_runtime_env() {
  PATH="$VENDOR_DIR/node/current/bin:$VENDOR_DIR/deno/current:$VENDOR_DIR/caddy/current:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  # Apple Silicon hypervisors advertise SVE2 they do not implement; see
  # src/orchestration/exec.ts runtimeEnv().
  OPENSSL_armcap=0
  ANSIBLE_CONFIG="$ORCH_DIR/ansible.cfg"
  ANSIBLE_EXECUTABLE=/bin/bash
  ANSIBLE_HOME="$ROOT_SCRATCH/home"
  ANSIBLE_LOCAL_TEMP="$ROOT_SCRATCH/local-tmp"
  ANSIBLE_ROLES_PATH="$ORCH_DIR/roles:$GALAXY_ROLES_DIR"
  export PATH OPENSSL_armcap ANSIBLE_CONFIG ANSIBLE_EXECUTABLE ANSIBLE_HOME \
    ANSIBLE_LOCAL_TEMP ANSIBLE_ROLES_PATH
}

# Every key=value extra-var the daemon passes to a playbook through this
# helper, and what its value may be. The caller is the daemon account, so a
# key is data it chooses: anything not listed here is refused, and so is every
# `ansible_*` key (interpreter, connection, become — Ansible itself, not a
# TurboPanel role) and every `turbopanel_dev_*` key (co-located development
# ownership; a managed host never has a dev user). Values are checked per key;
# paths that decide where root reads or writes are pinned to this tree rather
# than trusted. A new key the daemon starts passing must be added here, or the
# playbook fails before Ansible starts (src/orchestration/tp-orchestrate-argv.test.ts
# runs the daemon's real argv builders through this function).
tp_extra_var_value_ok() {
  _xk="$1"
  _xv="$2"
  # Jinja delimiters: Ansible templates a string extra-var when a role uses it.
  case "$_xv" in
    *'{{'*|*'{%'*|*'{#'*) return 1 ;;
  esac
  # key=value extra-vars split on whitespace: `a=1 b=2` is two variables.
  case "$_xv" in
    *[[:space:]]*|*[[:cntrl:]]*) return 1 ;;
  esac
  case "$_xk" in
    turbopanel_ui_mode)
      case "$_xv" in dev|static) return 0 ;; esac
      ;;
    turbopanel_instance_run_mode)
      case "$_xv" in source|compiled) return 0 ;; esac
      ;;
    turbopanel_instance_runtime)
      case "$_xv" in deno|workers) return 0 ;; esac
      ;;
    postgres_expose_port|force_build|force_compile|turbopanel_after_instance_service)
      case "$_xv" in true|false) return 0 ;; esac
      ;;
    turbopanel_install_root|turbopanel_instance_dir)
      # A managed host's instance lies flat in the install root; root must
      # never run a generator or restore a backup from a tree the caller names.
      [ "$_xv" = "$INSTALL_ROOT" ] && return 0
      ;;
    turbopanel_backup_dir)
      tp_backup_dir_ok "$_xv" && return 0
      ;;
    turbopanel_hostname)
      tp_hostname_ok "$_xv" && return 0
      ;;
    turbopanel_public_urls)
      tp_host_list_ok "$_xv" && return 0
      ;;
    turbopanel_hostnames_json)
      # Compact JSON of {host, source, cert_id} rows; the roles re-check each
      # host. Structural characters only — no quotes-in-strings, no escapes.
      # A host is stored as an install origin (https://panel.example.com:8443),
      # so `/` and `:` are part of the set; the roles strip scheme, path and
      # port before a host names anything.
      case "$_xv" in
        '['*']') ;;
        *) return 1 ;;
      esac
      # \133 \135 are [ ]: a bracket inside a case pattern's own brackets is
      # not portable across shells, so strip the allowed set and require
      # nothing to remain.
      [ -z "$(printf '%s' "$_xv" | tr -d 'A-Za-z0-9{}":,._/\133\135-')" ] &&
        return 0
      ;;
    turbopanel_acme_email)
      tp_email_ok "$_xv" && return 0
      ;;
    turbopanel_acme_directory)
      case "$_xv" in
        https://?*) ;;
        *) return 1 ;;
      esac
      case "${_xv#https://}" in
        *[!A-Za-z0-9._~/:-]*|*/../*|*/..|*/./*) return 1 ;;
      esac
      return 0
      ;;
    turbopanel_upgrade_id)
      case "$_xv" in
        ''|*[!A-Za-z0-9_-]*) return 1 ;;
      esac
      [ "${#_xv}" -le 128 ] && return 0
      ;;
    turbopanel_instance_version)
      case "$_xv" in
        ''|*[!0-9A-Za-z.+-]*) return 1 ;;
      esac
      return 0
      ;;
    turbopanel_instance_revision)
      case "$_xv" in
        ''|*[!0-9A-Za-z]*) return 1 ;;
      esac
      return 0
      ;;
  esac
  return 1
}

# RFC 1123 host name: dot-separated LDH labels, 1-63 characters each, no
# leading or trailing hyphen, 253 characters in all.
tp_hostname_ok() {
  _hn="$1"
  [ -n "$_hn" ] && [ "${#_hn}" -le 253 ] || return 1
  case "$_hn" in
    *[!A-Za-z0-9.-]*|.*|*.|*..*) return 1 ;;
  esac
  _hn_rest="$_hn"
  while [ -n "$_hn_rest" ]; do
    _hn_label="${_hn_rest%%.*}"
    case "$_hn_rest" in
      *.*) _hn_rest="${_hn_rest#*.}" ;;
      *) _hn_rest="" ;;
    esac
    [ -n "$_hn_label" ] && [ "${#_hn_label}" -le 63 ] || return 1
    case "$_hn_label" in
      -*|*-) return 1 ;;
    esac
  done
  return 0
}

# One control-plane host as the daemon passes it: a host name, IPv4 or IPv6
# literal, or the install origin the control plane stores for it
# (https://<host>[:port][/], IPv6 bracketed). No wildcards, no userinfo, no
# path, query or fragment.
tp_host_token_ok() {
  _ht="$1"
  case "$_ht" in
    https://*)
      _ht="${_ht#https://}"
      _ht="${_ht%/}"
      case "$_ht" in
        '['*)
          _ht_port="${_ht##*]}"
          _ht="${_ht#?}"
          _ht="${_ht%]"$_ht_port"}"
          ;;
        *:*)
          _ht_port=":${_ht##*:}"
          _ht="${_ht%:*}"
          ;;
        *) _ht_port="" ;;
      esac
      case "$_ht_port" in
        '') ;;
        :[0-9]|:[0-9][0-9]|:[0-9][0-9][0-9]|:[0-9][0-9][0-9][0-9]|:[0-9][0-9][0-9][0-9][0-9])
          [ "${_ht_port#:}" -le 65535 ] || return 1
          ;;
        *) return 1 ;;
      esac
      ;;
  esac
  case "$_ht" in
    '') return 1 ;;
    *:*)
      case "$_ht" in
        *[!0-9A-Fa-f:.]*) return 1 ;;
      esac
      ;;
    *)
      tp_hostname_ok "$_ht" || return 1
      ;;
  esac
  return 0
}

# Comma-separated host tokens for the certificate SANs (see
# tp_host_token_ok). No empty entries.
tp_host_list_ok() {
  _hl="$1"
  [ -n "$_hl" ] || return 1
  case "$_hl" in
    ,*|*,|*,,*) return 1 ;;
  esac
  _hl_rest="$_hl"
  while [ -n "$_hl_rest" ]; do
    _hl_tok="${_hl_rest%%,*}"
    case "$_hl_rest" in
      *,*) _hl_rest="${_hl_rest#*,}" ;;
      *) _hl_rest="" ;;
    esac
    tp_host_token_ok "$_hl_tok" || return 1
  done
  return 0
}

# A deliberately small email shape: local@domain with an RFC 1123 domain.
tp_email_ok() {
  _em="$1"
  case "$_em" in
    ?*@?*) ;;
    *) return 1 ;;
  esac
  _em_local="${_em%@*}"
  _em_domain="${_em##*@}"
  [ "$_em_local@$_em_domain" = "$_em" ] || return 1
  case "$_em_local" in
    *[!A-Za-z0-9._+-]*|.*|*.) return 1 ;;
  esac
  [ "${#_em_local}" -le 64 ] || return 1
  case "$_em_domain" in
    *.*) ;;
    *) return 1 ;;
  esac
  tp_hostname_ok "$_em_domain"
}

# Backups are the one path an operator may repoint (a second disk, a NAS
# mount), so this is a set of storage roots rather than one value: absolute,
# normalised, and under /backup, /srv, /mnt, /media, /data, or /var/backups.
# Anywhere else (/etc, /usr, /root, /var/spool, …) would let the daemon aim a
# root-run backup at a system directory.
tp_backup_dir_ok() {
  _bd="$1"
  case "$_bd" in
    *[!A-Za-z0-9._/-]*|*//*|*/./*|*/../*|*/.|*/..) return 1 ;;
  esac
  case "$_bd" in
    /backup|/backup/?*|/srv/?*|/mnt/?*|/media/?*|/data|/data/?*|/var/backups|/var/backups/?*) return 0 ;;
  esac
  return 1
}

# Keys a JSON-object extra-var may carry (-e '{"k": …}'), for the playbooks
# whose inputs are lists or booleans: time sync, Docker addressing, native
# app runtimes, site engines. Checked by tp_json_extra_var_ok.
TP_JSON_EXTRA_VAR_KEYS="turbopanel_timezone turbopanel_ntp_servers turbopanel_ntp_fallback_servers turbopanel_ntp_enabled turbopanel_apply_ntp_config turbopanel_docker_address_pools turbopanel_docker_default_bridge_cidr turbopanel_docker_clear_addressing node_app_versions turbopanel_php_fpm_install php_fpm_versions php_fpm_extensions turbopanel_lsphp_install openlitespeed_lsphp_versions"

# A single-line JSON object whose keys are all in TP_JSON_EXTRA_VAR_KEYS and
# whose leaf strings carry no Jinja delimiter or control character and no
# whitespace (host names, versions, CIDRs, zone names). Parsed with the
# vendored Ansible interpreter — the same Python that will read it.
tp_json_extra_var_ok() {
  _jv="$1"
  case "$_jv" in
    '{'*'}') ;;
    *) return 1 ;;
  esac
  _jpy="$VENDOR_DIR/ansible/current/bin/python3"
  [ -x "$_jpy" ] || return 1
  TP_JSON_KEYS="$TP_JSON_EXTRA_VAR_KEYS" "$_jpy" -I -S -c '
import json, os, re, sys
allowed = set(os.environ["TP_JSON_KEYS"].split())
map_key = re.compile(r"[A-Za-z0-9._-]{1,64}")
bad = ("{{", "{%", "{#")
def leaf_ok(v, depth=0):
    if depth > 4:
        return False
    if isinstance(v, bool) or v is None:
        return True
    if isinstance(v, int):
        return abs(v) < 2**31
    if isinstance(v, str):
        return (len(v) <= 253 and not any(b in v for b in bad)
                and all(c.isprintable() and not c.isspace() for c in v))
    if isinstance(v, list):
        return len(v) <= 64 and all(leaf_ok(x, depth + 1) for x in v)
    if isinstance(v, dict):
        return (len(v) <= 16 and all(isinstance(k, str) and map_key.fullmatch(k)
                and leaf_ok(x, depth + 1) for k, x in v.items()))
    return False
try:
    doc = json.loads(sys.argv[1])
except ValueError:
    sys.exit(1)
if not isinstance(doc, dict) or not doc:
    sys.exit(1)
if any(k not in allowed for k in doc):
    sys.exit(1)
sys.exit(0 if all(leaf_ok(v) for v in doc.values()) else 1)
' "$_jv"
}

# One -e value: `key=value` (key and value checked by tp_extra_var_value_ok)
# or a JSON object (tp_json_extra_var_ok). `@file` references are refused.
tp_valid_extra_var() {
  _nl="$(printf '\nx')"
  _nl="${_nl%x}"
  case "$1" in
    *"$_nl"*) return 1 ;;
    '{'*) tp_json_extra_var_ok "$1"; return $? ;;
    [a-z_]*=*) ;;
    *) return 1 ;;
  esac
  _key="${1%%=*}"
  case "$_key" in
    *[!a-z0-9_]*) return 1 ;;
  esac
  tp_extra_var_value_ok "$_key" "${1#*=}"
}

tp_verb_playbook() {
  tp_require_root_scratch
  _inventory=""
  _connection=""
  _playbook=""
  set -- "$@"
  # Rebuild argv with only validated entries.
  _n=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -i)
        [ $# -ge 2 ] || tp_die "-i requires a value"
        [ "$2" = "localhost," ] || tp_die "only -i localhost, is allowed"
        _inventory="$2"
        shift 2
        ;;
      -c)
        [ $# -ge 2 ] || tp_die "-c requires a value"
        [ "$2" = "local" ] || tp_die "only -c local is allowed"
        _connection="$2"
        shift 2
        ;;
      -e)
        [ $# -ge 2 ] || tp_die "-e requires a value"
        tp_valid_extra_var "$2" ||
          tp_die "refusing extra-var ${2%%=*} (not an allowed key, or its value is out of shape)"
        eval "_extra_$_n=\$2"
        _n=$((_n + 1))
        shift 2
        ;;
      -*)
        tp_die "refusing option $1"
        ;;
      *)
        [ -z "$_playbook" ] || tp_die "exactly one playbook is allowed"
        _playbook="$1"
        shift
        ;;
    esac
  done
  [ "$_inventory" = "localhost," ] || tp_die "missing -i localhost,"
  [ "$_connection" = "local" ] || tp_die "missing -c local"
  [ -n "$_playbook" ] || tp_die "missing playbook"

  # A basename only — callers pass the daemon's absolute constant and we keep
  # nothing of it but the file name, resolved under the root-owned tree.
  _name="${_playbook##*/}"
  case "$_name" in
    *.yml) ;;
    *) tp_die "playbook must be a .yml file name" ;;
  esac
  case "$_name" in
    .*|*/*) tp_die "refusing playbook name $_name" ;;
  esac
  _resolved="$PLAYBOOKS_DIR/$_name"
  [ -f "$_resolved" ] || tp_die "no such shipped playbook: $_name"
  if [ -L "$_resolved" ]; then
    tp_die "refusing symlinked playbook $_name"
  fi
  [ -x "$ANSIBLE_PLAYBOOK_BIN" ] || tp_die "ansible-playbook missing at $ANSIBLE_PLAYBOOK_BIN"

  tp_export_runtime_env
  mkdir -p -m 0700 "$ANSIBLE_HOME" "$ANSIBLE_LOCAL_TEMP"
  cd "$INSTALL_ROOT"

  set -- -i localhost, -c local
  _i=0
  while [ "$_i" -lt "$_n" ]; do
    eval "_v=\$_extra_$_i"
    set -- "$@" -e "$_v"
    _i=$((_i + 1))
  done
  exec "$ANSIBLE_PLAYBOOK_BIN" "$@" "$_resolved"
}

tp_verb_galaxy_docker_role() {
  tp_require_root_scratch
  _req="$ORCH_DIR/requirements-docker.yml"
  [ -f "$_req" ] || tp_die "missing $_req"
  # Exact pin, same regex family as parseGalaxyDockerRoleVersion.
  _version="$(sed -n 's/^[[:space:]]*version:[[:space:]]*"\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*$/\1/p' "$_req" | head -1)"
  [ -n "$_version" ] || tp_die "requirements-docker.yml must pin geerlingguy.docker to an exact version"
  _dest="$GALAXY_ROLES_DIR/geerlingguy.docker"
  if [ -f "$_dest/.turbopanel-version" ] \
    && [ "$(cat "$_dest/.turbopanel-version")" = "$_version" ]; then
    printf 'tp-orchestrate: geerlingguy.docker %s already installed\n' "$_version"
    return 0
  fi
  tp_export_runtime_env
  _url="https://codeload.github.com/geerlingguy/ansible-role-docker/tar.gz/refs/tags/${_version}"
  _work="$ROOT_SCRATCH/galaxy-docker.$$"
  rm -rf "$_work"
  mkdir -m 0700 "$_work"
  if ! curl -fsSL --max-time 120 -o "$_work/role.tar.gz" "$_url"; then
    rm -rf "$_work"
    tp_die "failed to download $_url"
  fi
  tar -xzf "$_work/role.tar.gz" -C "$_work"
  _extracted="$_work/ansible-role-docker-${_version}"
  [ -d "$_extracted" ] || { rm -rf "$_work"; tp_die "archive missing ansible-role-docker-${_version}/"; }
  printf '%s\n' "$_version" > "$_extracted/.turbopanel-version"
  install -d -m 0750 -o root -g "$(stat -c %G "$VENDOR_DIR")" "$GALAXY_ROLES_DIR"
  rm -rf "$_dest.new"
  # Same filesystem as the destination so the swap is a rename.
  cp -a "$_extracted" "$_dest.new"
  chown -R root:root "$_dest.new"
  chmod -R u=rwX,g=rX,o= "$_dest.new"
  chgrp -R "$(stat -c %G "$VENDOR_DIR")" "$_dest.new"
  rm -rf "$_dest"
  mv "$_dest.new" "$_dest"
  rm -rf "$_work"
  printf 'tp-orchestrate: geerlingguy.docker %s installed\n' "$_version"
}

CANONICAL_INSTANCE_CA="/etc/turbopanel/instance-ca.pem"
CANONICAL_INSTANCE_UPLOADED_TRUST="/etc/turbopanel/instance-uploaded-trust.pem"
CDN_RUN_SCRIPT="https://turbopanel.sh"
# Root-pinned update origin, written by run.sh (as root) at install time into
# the root-owned lib/ tree: the control plane this host enrolled with, the
# overlay catalog (dev hosts only) and the Platform CA it trusts. The caller
# cannot choose where root fetches run.sh from or which control plane the
# installer records — every origin flag must match this file or be absent.
# /etc/turbopanel is daemon-owned, which is why the pin does not live there.
UPDATE_ORIGIN_PIN="$INSTALL_ROOT/lib/update-origin"

tp_valid_url() {
  case "$1" in
    *"$(printf ' ')"*|*"'"*|*'"'*) return 1 ;;
    https://[A-Za-z0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}

tp_pin_field() {
  sed -n "s/^$1=//p" "$UPDATE_ORIGIN_PIN" | head -1
}

tp_read_update_origin_pin() {
  if [ -L "$UPDATE_ORIGIN_PIN" ] || [ ! -f "$UPDATE_ORIGIN_PIN" ]; then
    tp_die "update origin pin missing at $UPDATE_ORIGIN_PIN — re-run the installer (run.sh) once as root to write it"
  fi
  _pin_owner="$(stat -c %u "$UPDATE_ORIGIN_PIN" 2>/dev/null || echo -1)"
  [ "$_pin_owner" = "0" ] || tp_die "$UPDATE_ORIGIN_PIN is not root-owned; refusing"
  _pin_host="$(tp_pin_field host)"
  _pin_dl_base="$(tp_pin_field dl_base)"
  _pin_ca="$(tp_pin_field instance_ca)"
  _pin_uploaded="$(tp_pin_field uploaded_trust)"
  [ -n "$_pin_host" ] || tp_die "$UPDATE_ORIGIN_PIN carries no host"
}

# Manifest pins may only name the release rail run.sh itself trusts for
# that package: `update --manifest-url` the daemon rail, `update-instance
# --manifest-url` the control-plane rail, `--ui-manifest-url` the UI rail.
# Release-rail manifest URL check, on the raw string: https only, exact host,
# no %, @, :, ?, #, \, whitespace or controls, no empty, "." or ".." path
# segment, and one exact rail shape per kind (daemon, instance, ui):
#   daemon    https://dl.trbp.nl/channels/<channel>/manifest*.json
#   any kind  https://github.com/TurboPanel/<repo>/releases/download/<tag>/manifest*.json
#             https://github.com/TurboPanel/<repo>/releases/latest/download/manifest*.json
# Byte-identical in scripts/run.sh and orchestration/scripts/tp-orchestrate;
# src/update/urls.ts releaseManifestUrlAllowed is the TypeScript copy, and
# src/testing/release-manifest-url-corpus.json pins all three together.
tp_release_manifest_url_ok() {
  _rmu_kind="$1"
  _rmu_url="$2"
  case "$_rmu_kind" in
    daemon) _rmu_repo="turbopaneld" ;;
    instance) _rmu_repo="turbopanel" ;;
    ui) _rmu_repo="ui" ;;
    *) return 1 ;;
  esac
  case "$_rmu_url" in
    https://*) ;;
    *) return 1 ;;
  esac
  _rmu_rest="${_rmu_url#https://}"
  case "$_rmu_rest" in
    ""|*[!A-Za-z0-9._~/+-]*) return 1 ;;
  esac
  _rmu_host="${_rmu_rest%%/*}"
  _rmu_path="${_rmu_rest#"$_rmu_host"}"
  case "$_rmu_path" in
    ""|*/|*//*|*/./*|*/../*|*/.|*/..) return 1 ;;
  esac
  case "${_rmu_path##*/}" in
    manifest.json|manifest-?*.json) ;;
    *) return 1 ;;
  esac
  case "$_rmu_host" in
    dl.trbp.nl)
      [ "$_rmu_kind" = daemon ] || return 1
      _rmu_mid="${_rmu_path#/channels/}"
      ;;
    github.com)
      _rmu_mid="${_rmu_path#/TurboPanel/"$_rmu_repo"/releases/}"
      ;;
    *) return 1 ;;
  esac
  [ "$_rmu_mid" != "$_rmu_path" ] || return 1
  case "$_rmu_mid" in
    */*) _rmu_mid="${_rmu_mid%/*}" ;;
    *) return 1 ;;
  esac
  if [ "$_rmu_host" = dl.trbp.nl ]; then
    case "$_rmu_mid" in
      */*) return 1 ;;
    esac
    return 0
  fi
  case "$_rmu_mid" in
    latest/download) return 0 ;;
    download/*/*) return 1 ;;
    download/?*) return 0 ;;
  esac
  return 1
}

# Download run.sh into $_script from the root-pinned origin. The caller has
# already read the pin. TLS is never relaxed: CDN public trust, the pinned
# Platform CA, or the pinned private uploaded issuer. The issuer is --cacert
# only and is never passed as --instance-ca.
tp_fetch_pinned_run_script() {
  _script_url="$CDN_RUN_SCRIPT"
  set -- curl -fsSL --max-time 120
  case "$_pin_host" in
    http://*)
      tp_die "refusing plaintext update origin $_pin_host — the control plane is https://<host>:8443"
      ;;
    https://*)
      if [ -n "$_pin_dl_base" ]; then
        _script_url="${_pin_host%/}/run.sh"
        if [ -n "$_pin_ca" ]; then
          [ -f "$_pin_ca" ] || tp_die "Platform CA missing at $_pin_ca — re-run the installer with --instance-ca"
          set -- "$@" --cacert "$_pin_ca"
        elif [ -n "$_pin_uploaded" ]; then
          [ "$_pin_uploaded" = "$CANONICAL_INSTANCE_UPLOADED_TRUST" ] || tp_die "refusing uploaded trust pin $_pin_uploaded"
          [ -f "$_pin_uploaded" ] || tp_die "private uploaded issuer missing at $_pin_uploaded — re-run the installer"
          set -- "$@" --cacert "$_pin_uploaded"
        fi
      fi
      ;;
  esac

  _script="$ROOT_SCRATCH/run.sh.$$"
  rm -f "$_script"
  if ! "$@" -o "$_script" "$_script_url"; then
    rm -f "$_script"
    tp_die "failed to download $_script_url (TLS is never relaxed for automatic updates)"
  fi
  [ -s "$_script" ] || { rm -f "$_script"; tp_die "empty run.sh from $_script_url"; }
}

tp_verb_update() {
  tp_require_root_scratch
  tp_read_update_origin_pin
  _license=""
  _host=""
  _dl_base=""
  _ca=""
  _channel=""
  _manifest_url=""
  _progress_markers=false
  _no_start=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --license)
        [ $# -ge 2 ] || tp_die "--license requires a value"
        case "$2" in
          *[!A-Za-z0-9_=-]*|"") tp_die "refusing malformed --license" ;;
        esac
        _license="$2"
        shift 2
        ;;
      --host)
        [ $# -ge 2 ] || tp_die "--host requires a value"
        [ "${2%/}" = "${_pin_host%/}" ] || tp_die "refusing --host $2: this host enrolled with $_pin_host"
        _host="$2"
        shift 2
        ;;
      --dl-base)
        [ $# -ge 2 ] || tp_die "--dl-base requires a value"
        [ -n "$_pin_dl_base" ] || tp_die "refusing --dl-base: this host was not installed from an overlay"
        [ "${2%/}" = "${_pin_dl_base%/}" ] || tp_die "refusing --dl-base $2: pinned overlay is $_pin_dl_base"
        _dl_base="$2"
        shift 2
        ;;
      --instance-ca)
        [ $# -ge 2 ] || tp_die "--instance-ca requires a value"
        [ "$2" = "$CANONICAL_INSTANCE_CA" ] || tp_die "--instance-ca must be $CANONICAL_INSTANCE_CA"
        [ "$_pin_ca" = "$2" ] || tp_die "refusing --instance-ca: no Platform CA is pinned for this host"
        _ca="$2"
        shift 2
        ;;
      --channel)
        [ $# -ge 2 ] || tp_die "--channel requires a value"
        case "$2" in
          trunk|edge|canary|rc|release) ;;
          *) tp_die "refusing --channel $2" ;;
        esac
        _channel="$2"
        shift 2
        ;;
      --manifest-url)
        [ $# -ge 2 ] || tp_die "--manifest-url requires a value"
        tp_release_manifest_url_ok daemon "$2" || tp_die "refusing --manifest-url $2: not a TurboPanel release rail"
        tp_valid_url "$2" || tp_die "refusing --manifest-url $2"
        _manifest_url="$2"
        shift 2
        ;;
      --no-start)
        _no_start=true
        shift
        ;;
      --progress-markers)
        _progress_markers=true
        shift
        ;;
      *)
        # --insecure-tls lands here on purpose: automatic updates never
        # relax TLS (src/instance/run-reconcile.ts resolveAutomaticUpdateTrust).
        tp_die "refusing update flag $1"
        ;;
    esac
  done
  [ -n "$_license" ] || tp_die "update requires --license"
  [ "$_no_start" = true ] || tp_die "update requires --no-start (the daemon restarts itself)"
  # Absent flags take the pinned values, so the installer always records the
  # control plane, overlay and CA this host was enrolled with.
  [ -n "$_host" ] || _host="$_pin_host"
  [ -n "$_dl_base" ] || _dl_base="$_pin_dl_base"
  [ -n "$_ca" ] || _ca="$_pin_ca"

  # Where run.sh comes from, and how it is trusted — the same three answers
  # as the daemon's resolveAutomaticUpdateTrust, decided here from the pinned
  # origin rather than from anything the caller downloaded or passed.
  # After the checks above, absent flags have been filled from the pin, so
  # the host / overlay / CA the installer records are the pinned ones.
  tp_fetch_pinned_run_script

  set -- --license "$_license"
  [ -n "$_host" ] && set -- "$@" --host "$_host"
  [ -n "$_dl_base" ] && set -- "$@" --dl-base "$_dl_base"
  [ -n "$_ca" ] && set -- "$@" --instance-ca "$_ca"
  [ -n "$_channel" ] && set -- "$@" --channel "$_channel"
  [ -n "$_manifest_url" ] && set -- "$@" --manifest-url "$_manifest_url"
  [ "$_progress_markers" = true ] && set -- "$@" --progress-markers
  set -- "$@" --no-start
  cd "$INSTALL_ROOT"
  _rc=0
  sh "$_script" "$@" || _rc=$?
  rm -f "$_script"
  exit "$_rc"
}

# Reconcile an already-installed control plane (`run.sh --instance`).
# Distinct from `update`: no license, no host, no overlay, no Platform CA.
# The pin only chooses where this helper downloads run.sh. `--instance`
# refuses those daemon-enrolment flags, and it already knows its own config.
# `--manifest-url` here is the control-plane pin; it is passed to run.sh as
# `--instance-manifest-url` so it does not set TURBOPANEL_MANIFEST_URL (that
# pin is the daemon package. This verb always passes --skip-daemon-package
# so a panel update does not replace the running daemon binary.
tp_verb_update_instance() {
  tp_require_root_scratch
  _channel=""
  _manifest_url=""
  _ui_manifest_url=""
  _no_start=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel)
        [ $# -ge 2 ] || tp_die "--channel requires a value"
        case "$2" in
          trunk|edge|canary|rc|release) ;;
          *) tp_die "refusing --channel $2" ;;
        esac
        _channel="$2"
        shift 2
        ;;
      --manifest-url)
        [ $# -ge 2 ] || tp_die "--manifest-url requires a value"
        tp_release_manifest_url_ok instance "$2" || tp_die "refusing --manifest-url $2: not a TurboPanel release rail"
        tp_valid_url "$2" || tp_die "refusing --manifest-url $2"
        _manifest_url="$2"
        shift 2
        ;;
      --ui-manifest-url)
        [ $# -ge 2 ] || tp_die "--ui-manifest-url requires a value"
        tp_release_manifest_url_ok ui "$2" || tp_die "refusing --ui-manifest-url $2: not the UI release rail"
        tp_valid_url "$2" || tp_die "refusing --ui-manifest-url $2"
        _ui_manifest_url="$2"
        shift 2
        ;;
      --no-start)
        _no_start=true
        shift
        ;;
      *)
        # --insecure-tls, --license, --host, --dl-base, --instance-ca land
        # here on purpose. This verb does not enrol a daemon.
        tp_die "refusing update-instance flag $1"
        ;;
    esac
  done
  [ -n "$_channel" ] || tp_die "update-instance requires --channel"
  case "$_channel" in
    canary|rc|release) ;;
    *)
      tp_die "--instance needs --channel canary, rc or release (the instance and UI packages publish only through GitHub Releases; got ${_channel})"
      ;;
  esac
  [ "$_no_start" = true ] || tp_die "update-instance requires --no-start (the daemon restarts the control plane)"
  tp_read_update_origin_pin
  tp_fetch_pinned_run_script

  set -- --instance --channel "$_channel"
  [ -n "$_manifest_url" ] && set -- "$@" --instance-manifest-url "$_manifest_url"
  [ -n "$_ui_manifest_url" ] && set -- "$@" --ui-manifest-url "$_ui_manifest_url"
  set -- "$@" --no-start --skip-daemon-package --progress-markers
  cd "$INSTALL_ROOT"
  _rc=0
  sh "$_script" "$@" || _rc=$?
  rm -f "$_script"
  exit "$_rc"
}

# The instance unit's Environment= line is the Postgres URL. runtime.env does
# not carry it on a managed host, and this verb refuses caller-supplied
# credentials (no arguments, and any inherited URL is discarded).
tp_verb_migrate() {
  [ $# -eq 0 ] || tp_die "migrate takes no arguments"
  unset TURBOPANEL_DATABASE_URL
  _unit="/etc/systemd/system/turbopanel-instance.service"
  [ -f "$_unit" ] || tp_die "missing $_unit"
  _url="$(sed -n 's/^Environment="\{0,1\}TURBOPANEL_DATABASE_URL=//p' "$_unit" | head -1 | tr -d '\r' | sed 's/"$//')"
  [ -n "$_url" ] || tp_die "TURBOPANEL_DATABASE_URL is missing from $_unit"
  _bin="/opt/turbopanel/bin/turbopanel"
  [ -x "$_bin" ] || tp_die "missing $_bin"
  timeout 120 env TURBOPANEL_DATABASE_URL="$_url" "$_bin" migrate
}

[ $# -ge 1 ] || tp_die "usage: tp-orchestrate playbook|galaxy-docker-role|update|update-instance|migrate …"
_verb="$1"
shift
case "$_verb" in
  playbook) tp_verb_playbook "$@" ;;
  galaxy-docker-role) tp_verb_galaxy_docker_role "$@" ;;
  update) tp_verb_update "$@" ;;
  update-instance) tp_verb_update_instance "$@" ;;
  migrate) tp_verb_migrate "$@" ;;
  *) tp_die "unknown verb $_verb" ;;
esac
