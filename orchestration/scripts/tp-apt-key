#!/usr/bin/env python3
"""Install an apt repository signing key under a trust policy.

usage: tp-apt-key NAME DEST [--policy warn|enforce|bundled] [--keys-dir DIR]

NAME is an entry in apt-keys/keys.json (url, bundled file, expected
fingerprints, expiry). The live key is fetched from the vendor's URL and its
primary-key fingerprints are compared with the expected list shipped in the
release:

  match                 install silently
  mismatch, warn        install the fetched key anyway (apt still verifies
                        package signatures; TLS is the transport trust) and
                        print one WARN line saying which list to update
  mismatch, enforce     refuse
  fetch failed          fall back to the bundled copy (refuse under enforce)
  policy bundled        never fetch; use the bundled copy

A key within 60 days of expiry prints a WARN, and an expired or sooner-expiring
fetched key loses to a bundled copy that is still good. Environment:
TP_GPG overrides the gpg binary (tests). Exit 0 and one "installed ..." line on
success; WARN lines go to stderr.
"""
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request

SOON = 60 * 86400


def warn(msg):
    print("WARN tp-apt-key: " + msg, file=sys.stderr)


def die(msg):
    print("ERROR tp-apt-key: " + msg, file=sys.stderr)
    sys.exit(1)


def key_info(path):
    """Return (primary fingerprints, earliest primary expiry epoch or None)."""
    gpg = os.environ.get("TP_GPG", "gpg")
    out = subprocess.run(
        [gpg, "--batch", "--show-keys", "--with-colons", path],
        capture_output=True, text=True, check=False,
    )
    if out.returncode != 0:
        raise ValueError("gpg could not read the key: " + out.stderr.strip())
    fprs, expiry, want_fpr = [], None, False
    for line in out.stdout.splitlines():
        f = line.split(":")
        if f[0] == "pub":
            want_fpr = True
            if len(f) > 6 and f[6]:
                exp = int(f[6])
                expiry = exp if expiry is None else min(expiry, exp)
        elif f[0] == "fpr" and want_fpr:
            fprs.append(f[9].upper())
            want_fpr = False
        elif f[0] == "sub":
            want_fpr = False
    if not fprs:
        raise ValueError("no public key found")
    return fprs, expiry


def expired_or_soon(expiry, now):
    return expiry is not None and expiry - now < SOON


def fetch(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": "turbopanel"})
    with urllib.request.urlopen(req, timeout=30) as resp, open(dest, "wb") as fh:
        fh.write(resp.read())


def write_keyring(src, dest):
    """Install src (binary or armored) at dest as a binary keyring."""
    with open(src, "rb") as fh:
        head = fh.read(32)
    tmp = dest + ".tmp"
    if b"BEGIN PGP" in head:
        gpg = os.environ.get("TP_GPG", "gpg")
        if os.path.exists(tmp):
            os.unlink(tmp)
        subprocess.run([gpg, "--batch", "--dearmor", "-o", tmp, src], check=True)
    else:
        with open(src, "rb") as fh, open(tmp, "wb") as out:
            out.write(fh.read())
    os.chmod(tmp, 0o644)
    os.replace(tmp, dest)


def main(argv):
    args = [a for a in argv[1:]]
    policy, keys_dir = "warn", None
    pos = []
    while args:
        a = args.pop(0)
        if a == "--policy":
            policy = args.pop(0)
        elif a == "--keys-dir":
            keys_dir = args.pop(0)
        else:
            pos.append(a)
    if len(pos) != 2 or policy not in ("warn", "enforce", "bundled"):
        die("usage: tp-apt-key NAME DEST [--policy warn|enforce|bundled] [--keys-dir DIR]")
    name, dest = pos
    keys_dir = keys_dir or os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "..", "apt-keys")
    with open(os.path.join(keys_dir, "keys.json")) as fh:
        meta = json.load(fh).get(name)
    if meta is None:
        die("no key named %s in %s/keys.json" % (name, keys_dir))
    expected = [x.upper() for x in meta["fingerprints"]]
    bundled = os.path.join(keys_dir, meta["bundled"])
    where = "orchestration/apt-keys/keys.json (%s)" % name
    now = time.time()

    b_fprs, b_exp = key_info(bundled)
    if not set(b_fprs) <= set(expected):
        die("bundled key %s does not match its own fingerprint list; fix %s"
            % (name, where))

    chosen, source = bundled, "bundled copy"
    if policy != "bundled":
        with tempfile.TemporaryDirectory() as tmp:
            live = os.path.join(tmp, "live.key")
            try:
                fetch(meta["url"], live)
                l_fprs, l_exp = key_info(live)
            except Exception as exc:  # network, parse, or gpg trouble
                if policy == "enforce":
                    die("could not fetch %s from %s: %s" % (name, meta["url"], exc))
                warn("could not fetch %s from %s (%s); using the bundled copy"
                     % (name, meta["url"], exc))
                l_fprs = None
            if l_fprs is not None:
                matches = set(l_fprs) <= set(expected)
                if not matches and policy == "enforce":
                    die("fingerprint of %s changed: got %s, expected one of %s; "
                        "update the list in %s after checking with the vendor"
                        % (name, ",".join(l_fprs), ",".join(expected), where))
                if not matches:
                    warn("fingerprint of %s changed: got %s, expected one of %s. "
                         "Proceeding with the fetched key (package signatures are "
                         "still verified). Update the list in %s after checking "
                         "with the vendor." % (name, ",".join(l_fprs),
                                               ",".join(expected), where))
                live_bad = expired_or_soon(l_exp, now) and not expired_or_soon(b_exp, now)
                if live_bad:
                    warn("fetched key %s is expired or near expiry; using the "
                         "bundled copy instead" % name)
                else:
                    write_keyring(live, dest)
                    chosen, source = None, "vendor URL"
    if chosen is not None:
        write_keyring(chosen, dest)
    exp = key_info(dest)[1]
    if exp is not None and exp - now < SOON:
        warn("key %s expires %s (within 60 days); refresh the bundled copy"
             % (name, time.strftime("%Y-%m-%d", time.gmtime(exp))))
    print("installed %s from %s" % (name, source))


main(sys.argv)
