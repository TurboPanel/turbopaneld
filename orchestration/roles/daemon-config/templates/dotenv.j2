TURBOPANEL_INSTANCE_URL={{ turbopanel_instance_url }}
{# Plaintext http:// control plane is development-only; the daemon refuses it
   unless this flag is set. Derive from the URL so --host http://… installs
   (Add Server → :8880) opt in automatically without a separate installer flag. #}
{% if turbopanel_instance_url is string and turbopanel_instance_url.startswith('http://') %}
TURBOPANEL_DEV_HTTP_CONTROL_PLANE=1
{% endif %}
TURBOPANEL_RUNTIMES_DIR={{ turbopanel_vendor_dir }}
TURBOPANEL_ORCHESTRATION_DIR={{ turbopanel_orchestration_dir }}
TURBOPANEL_CONFIG_DIR={{ turbopanel_config_dir }}
TURBOPANEL_STATE_DIR={{ turbopanel_daemon_state_dir }}
TURBOPANEL_DAEMON_STATE_DIR={{ turbopanel_daemon_state_dir }}
TURBOPANEL_SERVICE_NAME={{ turbopanel_service_name | default('turbopaneld') }}
{% if turbopanel_instance_ca | length > 0 %}
TURBOPANEL_INSTANCE_CA={{ turbopanel_instance_ca }}
{% if turbopanel_instance_ca_fingerprint | default('') | length > 0 %}
TURBOPANEL_INSTANCE_CA_FINGERPRINT={{ turbopanel_instance_ca_fingerprint }}
{% endif %}
{% endif %}
TURBOPANEL_UPDATE_CHANNEL={{ turbopanel_update_channel | default('trunk') }}
{% if turbopanel_dl_base | default('') | length > 0 %}
TURBOPANEL_DL_BASE={{ turbopanel_dl_base }}
{% endif %}
