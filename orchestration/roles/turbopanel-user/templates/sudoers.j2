# Managed by TurboPanel (roles/turbopanel-user). Do not edit by hand.
#
# What the daemon account may run as root. Every entry is an absolute path;
# there is no shell, no ALL, and no raw host utility:
#
# - TP_HOST (lib/tp-host) is the only way to change host files, services,
#   accounts and networking. It accepts the argument shapes the daemon
#   produces, confines every path to the trees TurboPanel owns, never follows
#   a symlink, and checks systemd unit content before installing it.
# - TP_ORCHESTRATE runs a shipped playbook with allowlisted extra-vars.
#
# Residual root-equivalent access, documented in AGENTS.md (Managed-host
# privilege boundary) until each is replaced:
# - Docker: there is no sudo grant for it, but `tp` is in the `docker` group
#   and Docker access is root-equivalent.
# - TP_ENGINE_VALIDATE: the engines' own config tests run as root against the
#   configs under /etc/turbopanel, pinned to those exact files here.
#
# src/orchestration/sudoers-contract.test.ts pins this file.
Defaults:{{ turbopanel_user }} !requiretty
Defaults:{{ turbopanel_user }} env_reset

Cmnd_Alias TP_HOST = {{ turbopanel_install_root }}/lib/tp-host
Cmnd_Alias TP_ORCHESTRATE = {{ turbopanel_orchestration_dir }}/scripts/tp-orchestrate
# tp-update-guard runs only as root via systemd OnFailure=/timer — no sudo entry.
Cmnd_Alias TP_ENGINE_VALIDATE = {{ turbopanel_vendor_dir }}/apache/current/bin/httpd -t -f /etc/turbopanel/apache/httpd.conf, /usr/sbin/php-fpm[0-9].[0-9] --fpm-config /etc/turbopanel/php/[0-9].[0-9]/php-fpm.conf --test

{{ turbopanel_user }} ALL=(root) NOPASSWD: TP_HOST, TP_ORCHESTRATE, TP_ENGINE_VALIDATE
# Re-exec as itself: `sudo -n -u tp -- docker …` picks up a fresh group set
# after Docker install, and native builds wrap in `sudo -n -u tp -- env … sh -c`.
{{ turbopanel_user }} ALL=({{ turbopanel_user }}) NOPASSWD: ALL
# Config validation as the unprivileged engine service accounts
# (`sudo -n -u tpnginx -- nginx -t`, `… tpols -- openlitespeed -t`,
# `… tpcaddysite -- env XDG_DATA_HOME=… caddy validate`).
{{ turbopanel_user }} ALL=(tpnginx, tpols, tpcaddysite) NOPASSWD: {{ turbopanel_vendor_dir }}/nginx/*/sbin/nginx, {{ turbopanel_vendor_dir }}/openlitespeed/*/bin/openlitespeed, {{ turbopanel_vendor_dir }}/caddy/*/caddy, /usr/bin/env
