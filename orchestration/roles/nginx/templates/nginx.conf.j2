# Managed by TurboPanel — do not edit by hand.
# Site vhosts live in {{ turbopanel_config_dir }}/nginx/sites/*.conf
# (written by the daemon traditional-web apply path).
#
# No `user` directive: turbopanel-nginx.service runs the master as tpnginx
# (high-port vhosts only). The nginx.org binary's compiled-in default user
# ("nginx") is unused when the process is already unprivileged.

worker_processes auto;
error_log {{ turbopanel_log_dir }}/nginx/error.log notice;
pid {{ turbopanel_run_dir }}/nginx/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       {{ turbopanel_config_dir }}/nginx/mime.types;
    default_type  application/octet-stream;

    access_log {{ turbopanel_log_dir }}/nginx/access.log;

    sendfile        on;
    keepalive_timeout  65;

    client_body_temp_path {{ turbopanel_state_dir }}/nginx/client_temp;
    proxy_temp_path       {{ turbopanel_state_dir }}/nginx/proxy_temp;
    fastcgi_temp_path     {{ turbopanel_state_dir }}/nginx/fastcgi_temp;
    uwsgi_temp_path       {{ turbopanel_state_dir }}/nginx/uwsgi_temp;
    scgi_temp_path        {{ turbopanel_state_dir }}/nginx/scgi_temp;

    # Hosting Caddy owns public :80/:443. Traditional-web vhosts listen on
    # loopback (and optionally docker-bridge) high ports only.
    include {{ turbopanel_config_dir }}/nginx/sites/*.conf;
}
