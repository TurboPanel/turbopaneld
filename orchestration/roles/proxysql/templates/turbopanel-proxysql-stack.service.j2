[Unit]
Description=TurboPanel ProxySQL managed ingress
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The managed-engine network is per-organization and named by the control
# plane; the daemon creates it on reconcile (and re-creates it on self-heal),
# so this unit never guesses a name.
# Likewise the compose project: it is the allocated managed-ingress
# serviceId, which Ansible cannot know at converge time. The daemon writes it
# into the compose file's top-level `name:` key, so no `-p` is passed here.
# Compose is daemon-written under configDir/proxysql. Before the first
# managed.ingress.reconcile there is no docker-compose.yml — exit 0 so the unit
# can enable on a fresh host without failing converge.
ExecStart=/bin/sh -c 'if [ -f {{ proxysql_config_dir }}/docker-compose.yml ]; then /usr/bin/docker compose -f {{ proxysql_config_dir }}/docker-compose.yml up -d --remove-orphans; else echo "proxysql compose not yet provisioned; skipping up"; fi'
ExecStart=/bin/sh -c 'if [ -f {{ proxysql_config_dir }}/docker-compose.yml ]; then {{ proxysql_config_dir }}/wait-ready.sh; fi'
ExecStop=/bin/sh -c 'if [ -f {{ proxysql_config_dir }}/docker-compose.yml ]; then /usr/bin/docker compose -f {{ proxysql_config_dir }}/docker-compose.yml down; fi'

[Install]
WantedBy=multi-user.target
