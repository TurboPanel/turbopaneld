# Managed by TurboPanel — do not edit by hand.
# Per-site blocks live in {{ turbopanel_config_dir }}/caddy/sites/*.conf
# (written by the daemon site apply path).
{
	admin {{ site_caddy_admin_addr }}
	# This process never terminates TLS — the edge Caddy does, and forwards
	# here over loopback. `auto_https off` (not `disable_redirects`) keeps it
	# from trying to issue certificates for site blocks.
	auto_https off
	# Caddy has exactly one admin listener per process (the address above) —
	# there is no supported way to bind a second, metrics-only admin API.
	# The global `metrics` option is what actually exposes Prometheus text at
	# `/metrics` on that admin listener; `servers { metrics }` only turns on
	# per-server instrumentation and, on its own, leaves `/metrics` 404. The
	# daemon's traffic collector (`src/metrics/collector/proxy/caddy.ts`)
	# scrapes both together at the same loopback address as
	# `site_caddy_admin_addr` above.
	metrics
	servers {
		metrics
	}
}

# An import whose glob matches nothing is an ERROR, not an empty set, so
# `caddy validate` would fail on a host with no sites yet. 00-empty.conf keeps
# the glob non-empty; the daemon's `tp-<envId>-` prefix sweep leaves it alone.
import {{ turbopanel_config_dir }}/caddy/sites/*.conf
