# Managed by TurboPanel — do not edit by hand.
# Per-site blocks live in {{ site_caddy_config_dir }}/sites/*.conf
# (written by the daemon site apply path).
{
	# Unix socket only (see site_caddy_admin_socket): never loopback TCP.
	admin unix/{{ site_caddy_admin_socket }}|0600
	# This process never terminates TLS — the edge Caddy does, and forwards
	# here over loopback. `auto_https off` (not `disable_redirects`) keeps it
	# from trying to issue certificates for site blocks.
	auto_https off
	# Bounded shutdown: close open connections 5 s after SIGTERM instead of
	# waiting forever (keep below the unit's TimeoutStopSec).
	grace_period 5s
	# The global `metrics` option turns on HTTP instrumentation for every
	# server; `servers { metrics }` alone leaves the counters empty. The
	# Prometheus text is served read-only by the `metrics` handler on
	# `site_caddy_metrics_port` below, which the daemon's traffic collector
	# (`src/metrics/collector/ingress/caddy.ts`) scrapes at `/metrics`.
	metrics
	servers {
		metrics
	}
}

# Metrics only: this server has no other handler, and the admin API is not
# on it. Each scrape is itself one request on this server. `bind` keeps it on
# loopback; a site address alone listens on every interface.
http://127.0.0.1:{{ site_caddy_metrics_port }} {
	bind 127.0.0.1
	metrics
}

# An import whose glob matches nothing is an ERROR, not an empty set, so
# `caddy validate` would fail on a host with no sites yet. 00-empty.conf keeps
# the glob non-empty; the daemon's `tp-<envId>-` prefix sweep leaves it alone.
import {{ site_caddy_config_dir }}/sites/*.conf
