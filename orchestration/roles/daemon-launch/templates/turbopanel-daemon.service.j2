[Unit]
Description=TurboPanel daemon
After=network-online.target{% if turbopanel_after_instance_service | bool %} turbopanel-instance.service{% endif %}

Wants=network-online.target{% if turbopanel_after_instance_service | bool %} turbopanel-instance.service{% endif %}

[Service]
Type=simple
User={{ turbopanel_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_daemon_dir }}
Environment=TURBOPANEL_DAEMON_ROOT={{ turbopanel_daemon_dir }}
Environment=TURBOPANEL_SERVICE_NAME={{ turbopanel_service_name }}
ExecStartPre={{ turbopanel_daemon_dir }}/orchestration/scripts/ensure-single-daemon.sh
{% if turbopanel_daemon_run_mode | default('binary') == 'source' %}
ExecStart=/usr/bin/flock -n /run/turbopanel/daemon.lock /usr/local/bin/deno run --quiet --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env --env-file=.env main.ts
{% else %}
EnvironmentFile={{ turbopanel_daemon_dir }}/.env
ExecStart=/usr/bin/flock -n /run/turbopanel/daemon.lock {{ turbopanel_daemon_binary }}
{% endif %}
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ turbopanel_daemon_dir }}/logs/daemon.log
StandardError=append:{{ turbopanel_daemon_dir }}/logs/daemon.err.log

[Install]
WantedBy=multi-user.target
