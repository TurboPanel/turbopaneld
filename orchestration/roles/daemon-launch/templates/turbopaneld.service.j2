[Unit]
Description=TurboPanel daemon
{# Inline expressions, never an if/endif block tag at the end of a line: Ansible
   renders with trim_blocks, which eats the newline after a block tag and ran
   After=, Wants= and OnFailure= together on one line on every host.
   docker.service is ordering only (After=, never Wants=): at shutdown the
   daemon stops before Docker kills the engine containers, so the managed
   Postgres probe never watches a host shutdown as a dead primary. On a managed
   host the Docker gate is ordered the same way (After=, never Wants=: a
   site-only host has no gate service), and ExecStartPre waits for its socket. #}
After=network-online.target docker.service{{ ' ' ~ turbopanel_docker_gate_service if (turbopanel_dev_user | default('') | length == 0) else '' }}{{ ' turbopanel-instance.service' if (turbopanel_after_instance_service | bool) else '' }}
Wants=network-online.target{{ ' turbopanel-instance.service' if (turbopanel_after_instance_service | bool) else '' }}
OnFailure=turbopaneld-update-guard.service
{# Never give up: with a limit, a full disk made the daemon fail a few times in a
   row, systemd stopped retrying, and it stayed down after space returned. The
   rollback guard is armed by its own timer, not by this unit failing. #}
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ turbopanel_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_daemon_workdir }}
Environment=TURBOPANEL_SERVICE_NAME={{ turbopanel_service_name }}
{% if turbopanel_daemon_env_file | default('') | length > 0 %}
EnvironmentFile=-{{ turbopanel_daemon_env_file }}
{% endif %}
Environment=TURBOPANEL_RUN_DIR={{ runtime_socket_dir | default('/run/turbopanel') }}
Environment=TURBOPANEL_RUNTIME_SOCKET_OWNER={{ runtime_socket_owner | default(turbopanel_user) }}
Environment=TURBOPANEL_RUNTIME_SOCKET_GROUP={{ runtime_socket_group | default(turbopanel_group) }}
Environment=TURBOPANEL_RUNTIME_SOCKET_MODE={{ runtime_socket_mode | default('3770') }}
{% if (turbopanel_dev_user | default('') | length) == 0 %}
{# After the EnvironmentFile, so an old daemon.env line cannot point Docker
   back at the engine's own socket. DOCKER_HOST is for the docker client the
   daemon spawns (and, through sudo, `env`); TURBOPANEL_DOCKER_SOCKET is for the
   in-process client; compose and buildx calls use a context on the build
   socket (src/deploy/docker-cli.ts). #}
Environment=DOCKER_HOST=unix://{{ turbopanel_docker_gate_run_dir }}/docker.sock
Environment=TURBOPANEL_DOCKER_SOCKET={{ turbopanel_docker_gate_run_dir }}/docker.sock
Environment=TURBOPANEL_DOCKER_BUILD_SOCKET={{ turbopanel_docker_gate_build_dir }}/docker.sock
{% endif %}
ExecStartPre={{ turbopanel_orchestration_dir }}/scripts/ensure-single-daemon.sh
{% if (turbopanel_dev_user | default('') | length) == 0 %}
{# Root, failure ignored (no docker group, not a member): the daemon always
   starts without the docker group, so a host converged from an already-grouped
   process never keeps it. The converge removal covers the group file; this
   covers the process. #}
ExecStartPre=+-/usr/bin/gpasswd -d {{ turbopanel_user }} docker
ExecStartPre=/bin/sh {{ turbopanel_orchestration_dir }}/scripts/wait-docker-gate.sh {{ turbopanel_docker_gate_service }} {{ turbopanel_docker_gate_run_dir }}/docker.sock {{ turbopanel_docker_gate_wait_seconds }}
{% endif %}
{% if turbopanel_daemon_exec_mode | default('source') == 'native' %}
ExecStart=/usr/bin/flock -n {{ runtime_socket_dir }}/daemon.lock {{ turbopanel_daemon_bin }}
{% elif turbopanel_daemon_exec_mode | default('source') == 'js' %}
{# The JS fallback runs under the same scoped grants the native binary is
   compiled with — one contract, rendered by src/permissions/daemon-permissions.ts and
   pinned by src/permissions/daemon-permissions.test.ts. DENO_DIR keeps the runtime cache
   in daemon-writable state rather than the root-owned install root. #}
Environment=DENO_DIR={{ turbopanel_daemon_state_dir | default('/var/lib/turbopanel') }}/deno-cache
ExecStart=/usr/bin/flock -n {{ runtime_socket_dir }}/daemon.lock {{ turbopanel_daemon_deno_bin }} run --quiet --allow-read=/opt/turbopanel,/etc/turbopanel,/var/lib/turbopanel,/var/lib/turbopanel-build,/var/log/turbopanel,/run/turbopanel,/backup,/srv/users,/run/turbopanel-gate,/tmp,/proc,/sys,/dev,/etc/os-release,/etc/hostname,/etc/machine-id,/etc/passwd,/etc/group,/etc/localtime,/etc/timezone,/etc/ssl,/etc/ssh,/etc/systemd,/etc/docker,/etc/php,/var/lib/dpkg/status,/var/lib/dpkg/updates,/etc/apache2,/etc/nginx,/etc/caddy,/etc/wireguard,/etc/sysctl.d,/usr,/bin,/sbin,/lib,/lib64 --allow-write=/etc/turbopanel,/var/lib/turbopanel,/var/lib/turbopanel-build,/var/log/turbopanel,/run/turbopanel,/backup,/srv/users,/run/turbopanel-gate,/tmp,/opt/turbopanel/vendor/uv/cache,/opt/turbopanel/vendor/cloudflared,/opt/turbopanel/vendor/uv,/opt/turbopanel/vendor/python,/opt/turbopanel/vendor/ansible --allow-run=sudo,sh,/bin/sh,cat,ls,df,dmesg,getconf,getent,id,/usr/bin/id,test,smartctl,nvidia-smi,timedatectl,ss,ip,iptables,ip6tables,iptables-restore,ip6tables-restore,iptables-save,ip6tables-save,wg,sysctl,tee,chmod,mkdir,cp,ln,setfacl,getfacl,systemctl,sshd,git,curl,/usr/bin/curl,tar,/usr/bin/tar,openssl,/usr/bin/openssl,/usr/bin/env,docker,/usr/bin/docker,/opt/turbopanel/vendor/railpack/current/railpack,/opt/turbopanel/bin/turbopaneld,/opt/turbopanel/vendor/deno/bin/deno,/opt/turbopanel/vendor/deno/current/deno,/opt/turbopanel/vendor/uv/0.11.21/uv,/opt/turbopanel/vendor/uv/0.11.21/uvx,/opt/turbopanel/vendor/ansible/2.20/bin/ansible-playbook,/opt/turbopanel/vendor/ansible/2.20/bin/ansible-galaxy,/opt/turbopanel/vendor/ansible/2.20/bin/ansible-lint,/opt/turbopanel/vendor/cloudflared/2026.11.1/cloudflared --allow-env=TURBOPANEL_*,HOME,PATH,USER,LOGNAME --ignore-env --allow-net --deny-net=169.254.169.254,metadata.google.internal,[fd00:ec2::254] --allow-sys=networkInterfaces,hostname,statfs,uid --allow-ffi=/usr/lib,/usr/lib64,/lib,/lib64 {{ turbopanel_daemon_js }}
{% else %}
ExecStart=/usr/bin/flock -n {{ runtime_socket_dir }}/daemon.lock {{ turbopanel_daemon_deno_bin }} run --quiet --allow-net --allow-sys=networkInterfaces,hostname,statfs --allow-read --allow-write --allow-run --allow-env --allow-ffi main.ts
{% endif %}
Restart=on-failure
{# Delay grows from 5 s to 120 s (systemd 254 and newer; Debian 13 and Ubuntu
   24.04 ship 257 and 255; older systemd only warns about the two keys) so a host
   that cannot start is not hammered. #}
RestartSec=5
RestartSteps=10
RestartMaxDelaySec=120
StandardOutput=append:{{ daemon_log_dir }}/daemon.log
StandardError=append:{{ daemon_log_dir }}/daemon.err.log

[Install]
WantedBy=multi-user.target
