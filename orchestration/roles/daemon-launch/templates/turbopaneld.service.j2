[Unit]
Description=TurboPanel daemon
After=network-online.target{% if turbopanel_after_instance_service | bool %} turbopanel-instance.service{% endif %}
Wants=network-online.target{% if turbopanel_after_instance_service | bool %} turbopanel-instance.service{% endif %}
OnFailure=turbopaneld-update-guard.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ turbopanel_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_daemon_workdir }}
Environment=TURBOPANEL_SERVICE_NAME={{ turbopanel_service_name }}
{% if turbopanel_daemon_env_file | default('') | length > 0 %}
EnvironmentFile=-{{ turbopanel_daemon_env_file }}
{% endif %}
Environment=TURBOPANEL_RUN_DIR={{ runtime_socket_dir | default('/run/turbopanel') }}
Environment=TURBOPANEL_RUNTIME_SOCKET_OWNER={{ runtime_socket_owner | default(turbopanel_user) }}
Environment=TURBOPANEL_RUNTIME_SOCKET_GROUP={{ runtime_socket_group | default(turbopanel_group) }}
Environment=TURBOPANEL_RUNTIME_SOCKET_MODE={{ runtime_socket_mode | default('2770') }}
ExecStartPre={{ turbopanel_orchestration_dir }}/scripts/ensure-single-daemon.sh
{% if turbopanel_daemon_exec_mode | default('source') == 'native' %}
ExecStart=/usr/bin/flock -n {{ runtime_socket_dir }}/daemon.lock {{ turbopanel_daemon_bin }}
{% elif turbopanel_daemon_exec_mode | default('source') == 'js' %}
{# The JS fallback runs under the same scoped grants the native binary is
   compiled with — one contract, rendered by src/permissions/daemon-permissions.ts and
   pinned by src/permissions/daemon-permissions.test.ts. DENO_DIR keeps the runtime cache
   in daemon-writable state rather than the root-owned install root. #}
Environment=DENO_DIR={{ turbopanel_daemon_state_dir | default('/var/lib/turbopanel') }}/deno-cache
ExecStart=/usr/bin/flock -n {{ runtime_socket_dir }}/daemon.lock {{ turbopanel_daemon_deno_bin }} run --quiet --allow-read=/opt/turbopanel,/etc/turbopanel,/var/lib/turbopanel,/var/log/turbopanel,/run/turbopanel,/backup,/srv/users,/run/docker.sock,/var/run/docker.sock,/tmp,/proc,/sys,/dev,/etc/os-release,/etc/hostname,/etc/machine-id,/etc/passwd,/etc/group,/etc/localtime,/etc/timezone,/etc/ssl,/etc/ssh,/etc/systemd,/etc/docker,/etc/php,/etc/apache2,/etc/nginx,/etc/caddy,/etc/wireguard,/etc/sysctl.d,/usr,/bin,/sbin,/lib,/lib64 --allow-write=/etc/turbopanel,/var/lib/turbopanel,/var/log/turbopanel,/run/turbopanel,/backup,/srv/users,/run/docker.sock,/var/run/docker.sock,/tmp,/opt/turbopanel/vendor/uv/cache,/opt/turbopanel/vendor/cloudflared,/opt/turbopanel/vendor/uv,/opt/turbopanel/vendor/python,/opt/turbopanel/vendor/ansible --allow-run=sudo,sh,/bin/sh,bash,cat,ls,df,dmesg,getconf,getent,id,/usr/bin/id,test,smartctl,nvidia-smi,ss,ip,iptables,ip6tables,iptables-restore,ip6tables-restore,iptables-save,ip6tables-save,wg,sysctl,tee,chmod,mkdir,cp,ln,systemctl,sshd,git,curl,/usr/bin/curl,tar,/usr/bin/tar,openssl,/usr/bin/openssl,/usr/bin/env,/usr/bin/prlimit,docker,/usr/bin/docker,/opt/turbopanel/vendor/buildkit/current/buildctl,/opt/turbopanel/vendor/buildkit/current/buildkitd,/opt/turbopanel/vendor/railpack/current/railpack,/opt/turbopanel/bin/turbopaneld,/opt/turbopanel/vendor/deno/bin/deno,/opt/turbopanel/vendor/deno/current/deno,/opt/turbopanel/vendor/uv/0.11.21/uv,/opt/turbopanel/vendor/uv/0.11.21/uvx,/opt/turbopanel/vendor/ansible/2.20/bin/ansible-playbook,/opt/turbopanel/vendor/ansible/2.20/bin/ansible-galaxy,/opt/turbopanel/vendor/ansible/2.20/bin/ansible-lint,/opt/turbopanel/vendor/cloudflared/2026.5.2/cloudflared --allow-env --allow-net --deny-net=169.254.169.254,metadata.google.internal,[fd00:ec2::254] --allow-sys=networkInterfaces,hostname,statfs,uid --allow-ffi=/usr/lib,/usr/lib64,/lib,/lib64 {{ turbopanel_daemon_js }}
{% else %}
ExecStart=/usr/bin/flock -n {{ runtime_socket_dir }}/daemon.lock {{ turbopanel_daemon_deno_bin }} run --quiet --allow-net --allow-sys=networkInterfaces,hostname,statfs --allow-read --allow-write --allow-run --allow-env --allow-ffi main.ts
{% endif %}
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ daemon_log_dir }}/daemon.log
StandardError=append:{{ daemon_log_dir }}/daemon.err.log

[Install]
WantedBy=multi-user.target
