#!/bin/sh
# tp-backup-run <policyId>: run one scheduled backup.
#
# Rendered by the daemon-launch role for this host's exec mode and installed
# root-owned (0750, group {{ turbopanel_group }}) at {{ turbopanel_backup_run_bin }},
# outside the replaceable orchestration tree. A policy's systemd service
# (turbopanel-backup-<policyId>.service) execs it as the daemon account; the
# host's unit check pins that ExecStart to exactly this path plus one
# lower-case UUID, so this script takes no other input. It hands the one
# argument to the daemon's `backup-run` verb, which reads the policy from the
# host's policies file and spools the result; it never takes daemon.lock.
set -eu

tp_backup_run_die() {
  _message="$1"
  printf 'tp-backup-run: %s\n' "$_message" >&2
  exit 2
}

[ "$#" -eq 1 ] || tp_backup_run_die "usage: tp-backup-run <policyId>"
policy_id="$1"
hex='[0123456789abcdef]'
# Unquoted on purpose: each $hex expands to a bracket pattern.
case "$policy_id" in
  $hex$hex$hex$hex$hex$hex$hex$hex-$hex$hex$hex$hex-$hex$hex$hex$hex-$hex$hex$hex$hex-$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex) ;;
  *) tp_backup_run_die "policy id must be a lower-case UUID" ;;
esac

# The per-engine lock lives under the run dir: it must be the daemon's own, or
# a scheduled run and a manual backup would not exclude each other.
export TURBOPANEL_RUN_DIR="${TURBOPANEL_RUN_DIR:-{{ runtime_socket_dir | default('/run/turbopanel') }}}"

{% if turbopanel_daemon_exec_mode | default('source') == 'native' %}
exec {{ turbopanel_daemon_bin }} backup-run "$policy_id"
{% elif turbopanel_daemon_exec_mode | default('source') == 'js' %}
{# The runner's own, much smaller grant set (it only drives the Docker CLI and a few
   folders): src/permissions/daemon-permissions.ts renderBackupRunnerPermissionFlags(),
   pinned by src/permissions/daemon-permissions.test.ts. Not the daemon's set. #}
export DENO_DIR={{ turbopanel_daemon_state_dir | default('/var/lib/turbopanel') }}/deno-cache
exec {{ turbopanel_daemon_deno_bin }} run --quiet --allow-read=/var/lib/turbopanel/backup,/run/turbopanel/managed-locks,/run/turbopanel/copy-locks,/backup,/usr/bin/docker --allow-write=/var/lib/turbopanel/backup,/run/turbopanel/managed-locks,/run/turbopanel/copy-locks,/backup --allow-run=/usr/bin/docker --allow-env --allow-sys=statfs {{ turbopanel_daemon_js }} backup-run "$policy_id"
{% else %}
cd {{ turbopanel_daemon_workdir }}
exec {{ turbopanel_daemon_deno_bin }} run --quiet --allow-net --allow-sys=networkInterfaces,hostname,statfs --allow-read --allow-write --allow-run --allow-env --allow-ffi main.ts backup-run "$policy_id"
{% endif %}
