#!/bin/sh
# Always-on egress block for Docker containers and builds (audit P1-4).
#
# Installed by the docker role and run as root by turbopanel-docker-egress.service
# after every (re)start of docker.service, so it survives a dockerd restart and a
# reboot. It is deliberately NOT part of the opt-in TP-FWD / TP-INPUT firewall:
# that one is off by default and would not reach every host.
#
# One chain, TP-EGRESS, hung off two hooks for traffic that ENTERS on a
# container-side interface (docker0, br-+ = every user-defined Docker bridge):
#   - DOCKER-USER  forwarded traffic: a site owner's container or build reaching
#                  a cloud metadata service or anything else on a link-local
#                  address through the host.
#   - INPUT        the same destinations when they are the host's own addresses.
# Nothing else is matched, so ingress/Caddy, ProxySQL, the daemon, traffic
# between containers on a project network, published ports and replies to all of
# them pass exactly as before. What is dropped:
#   IPv4  169.254.0.0/16 (link-local, 169.254.169.254 metadata on AWS, GCP, Azure,
#         Oracle, DigitalOcean, Hetzner), 168.63.129.16 (Azure wireserver),
#         100.100.100.200 (Alibaba metadata)
#   IPv6  fe80::/10 (ICMPv6 stays allowed so neighbour discovery works),
#         fd00:ec2::254 (AWS metadata)
# Exception: DNS (tcp/udp 53) to the link-local resolvers clouds hand out
# (169.254.169.253 AWS, 169.254.169.254 GCP, 168.63.129.16 Azure, fd00:ec2::253
# AWS v6), plus any nameserver in the host's resolv.conf files that sits on a
# dropped address. Metadata is HTTP, not 53.
#
# Not covered, by design: fetches made by the BuildKit engine itself (`ADD
# http://...`, remote/git build contexts) run in dockerd's own network namespace
# and never traverse these hooks.
#
# Usage: turbopanel-docker-egress apply | remove | print4 | print6
#   apply   idempotent: --noflush restore of the TP-EGRESS chain only, then the
#           jumps (-C then -I, re-inserted if something pushed them down).
#   remove  take the jumps out and delete the chain (uninstall / role switch off).
#   print4 / print6  the iptables-restore document; touches nothing, needs no root.
# Overrides for tests: TP_EGRESS_IPTABLES, TP_EGRESS_IP6TABLES,
# TP_EGRESS_IPTABLES_RESTORE, TP_EGRESS_IP6TABLES_RESTORE, TP_EGRESS_RESOLV_FILES.
set -eu

CHAIN=TP-EGRESS
IPT4="${TP_EGRESS_IPTABLES:-iptables}"
IPT6="${TP_EGRESS_IP6TABLES:-ip6tables}"
RESTORE4="${TP_EGRESS_IPTABLES_RESTORE:-iptables-restore}"
RESTORE6="${TP_EGRESS_IP6TABLES_RESTORE:-ip6tables-restore}"
RESOLV_FILES="${TP_EGRESS_RESOLV_FILES:-/etc/resolv.conf /run/systemd/resolve/resolv.conf}"
# Container-side interfaces; same set the firewall module treats as container ingress.
IFACES="docker0 br-+"
# Forwarded traffic is matched on every ingress interface: a network created
# with a custom bridge name (`com.docker.network.bridge.name`) is not docker0 or
# br-*, and nothing legitimate forwards to the addresses the chain drops.
FORWARD_IFACES="any"
HOOKS="INPUT DOCKER-USER"

die() {
  printf 'turbopanel-docker-egress: %s\n' "$1" >&2
  exit 1
}

# Link-local nameservers: the fixed cloud resolvers plus the host's own.
link_local_resolvers() {
  {
    printf '%s\n' 169.254.169.253 169.254.169.254 168.63.129.16
    for _f in $RESOLV_FILES; do
      [ -r "$_f" ] || continue
      awk '$1 == "nameserver" && $2 ~ /^(169\.254\.[0-9]+\.[0-9]+|168\.63\.129\.16|100\.100\.100\.200)$/ { print $2 }' "$_f"
    done
  } | sort -u
}

print4() {
  printf '*filter\n:%s - [0:0]\n' "$CHAIN"
  for _ns in $(link_local_resolvers); do
    for _p in udp tcp; do
      printf -- '-A %s -p %s -m %s --dport 53 -d %s/32 -j RETURN\n' "$CHAIN" "$_p" "$_p" "$_ns"
    done
  done
  printf -- '-A %s -d 169.254.0.0/16 -j DROP\n' "$CHAIN"
  printf -- '-A %s -d 168.63.129.16/32 -j DROP\n' "$CHAIN"
  printf -- '-A %s -d 100.100.100.200/32 -j DROP\n' "$CHAIN"
  printf 'COMMIT\n'
}

print6() {
  printf '*filter\n:%s - [0:0]\n' "$CHAIN"
  printf -- '-A %s -p ipv6-icmp -j RETURN\n' "$CHAIN"
  for _p in udp tcp; do
    printf -- '-A %s -p %s -m %s --dport 53 -d fd00:ec2::253/128 -j RETURN\n' "$CHAIN" "$_p" "$_p"
  done
  printf -- '-A %s -d fe80::/10 -j DROP\n' "$CHAIN"
  printf -- '-A %s -d fd00:ec2::254/128 -j DROP\n' "$CHAIN"
  printf 'COMMIT\n'
}

have_chain() { "$1" -w 5 -S "$2" >/dev/null 2>&1; }

# Our jumps are the first rules of the chain (rule 1 is the `-N` line in -S).
jumps_first() {
  _want=$(ifaces_for "$2" | wc -w | tr -d ' ')
  _n=$("$1" -w 5 -S "$2" | sed -n "2,$((_want + 1))p" | grep -c -- "-j $CHAIN" || true)
  [ "$_n" = "$_want" ]
}

# Interfaces a hook is matched on: forwarded traffic on all, host-bound on the bridges.
ifaces_for() {
  if [ "$1" = DOCKER-USER ]; then printf '%s' "$FORWARD_IFACES"; else printf '%s' "$IFACES"; fi
}

# `-i <iface>` for a named interface, nothing for "any".
iface_args() {
  if [ "$1" = any ]; then return 0; fi
  printf '%s\n%s\n' -i "$1"
}

jump() {
  _op=$1 _bin=$2 _hook=$3 _if=$4
  # shellcheck disable=SC2046
  if [ "$_op" = -I ]; then
    "$_bin" -w 5 -I "$_hook" 1 $(iface_args "$_if") -j "$CHAIN"
  else
    "$_bin" -w 5 "$_op" "$_hook" $(iface_args "$_if") -j "$CHAIN"
  fi
}

drop_jumps() {
  for _i in $(ifaces_for "$2"); do
    while jump -C "$1" "$2" "$_i" 2>/dev/null; do
      jump -D "$1" "$2" "$_i"
    done
  done
}

ensure_jumps() {
  for _i in $(ifaces_for "$2"); do
    jump -C "$1" "$2" "$_i" 2>/dev/null || jump -I "$1" "$2" "$_i"
  done
  if ! jumps_first "$1" "$2"; then
    drop_jumps "$1" "$2"
    for _i in $(ifaces_for "$2"); do
      jump -I "$1" "$2" "$_i"
    done
  fi
}

apply_family() {
  _bin=$1 _restore=$2 _doc=$3
  _tmp=$(mktemp)
  trap 'rm -f "$_tmp"' EXIT
  "$_doc" > "$_tmp"
  "$_restore" -w 5 --noflush --test < "$_tmp"
  "$_restore" -w 5 --noflush < "$_tmp"
  for _h in $HOOKS; do
    # DOCKER-USER is Docker's; it may not exist for this family (ip6tables off).
    if [ "$_h" = DOCKER-USER ] && ! have_chain "$_bin" DOCKER-USER; then continue; fi
    ensure_jumps "$_bin" "$_h"
  done
  rm -f "$_tmp"
}

remove_family() {
  _bin=$1
  for _h in $HOOKS; do
    if have_chain "$_bin" "$_h"; then drop_jumps "$_bin" "$_h"; fi
  done
  if have_chain "$_bin" "$CHAIN"; then
    "$_bin" -w 5 -F "$CHAIN"
    "$_bin" -w 5 -X "$CHAIN"
  fi
}

# TP_EGRESS_ALLOW_NONROOT exists for the stubbed tests only; a real iptables
# refuses a non-root caller on its own.
need_root() {
  [ "$(id -u)" = 0 ] || [ -n "${TP_EGRESS_ALLOW_NONROOT:-}" ] || die "must run as root"
}

case "${1:-}" in
  print4) print4 ;;
  print6) print6 ;;
  apply)
    need_root
    command -v "$IPT4" >/dev/null 2>&1 || die "iptables is not installed; the egress block cannot be applied"
    apply_family "$IPT4" "$RESTORE4" print4
    if command -v "$IPT6" >/dev/null 2>&1; then
      # IPv6 disabled in the kernel (ipv6.disable=1): ip6tables exists but has no
      # filter table. IPv4 is already applied; log and skip, never fail converge.
      if "$IPT6" -w 5 -S >/dev/null 2>&1; then
        apply_family "$IPT6" "$RESTORE6" print6
      else
        printf 'turbopanel-docker-egress: ip6tables has no usable filter table (IPv6 disabled?); IPv6 rules skipped\n' >&2
      fi
    else
      printf 'turbopanel-docker-egress: ip6tables not installed; IPv6 rules skipped\n' >&2
    fi
    ;;
  remove)
    need_root
    if command -v "$IPT4" >/dev/null 2>&1; then remove_family "$IPT4"; fi
    if command -v "$IPT6" >/dev/null 2>&1 && "$IPT6" -w 5 -S >/dev/null 2>&1; then
      remove_family "$IPT6"
    fi
    ;;
  *) die "usage: turbopanel-docker-egress apply|remove|print4|print6" ;;
esac
