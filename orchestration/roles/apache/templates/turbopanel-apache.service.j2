[Unit]
Description=TurboPanel Apache httpd (site hosting)
After=network.target
# Prefer the vendored unit over any leftover distro apache2 package unit.
Conflicts=apache2.service
# Never give up retrying: a start limit left this unit failed after a burst of
# failed starts (a full disk, for example) until someone logged in.
StartLimitIntervalSec=0

[Service]
Type=forking
# The whole unit runs as tpapache: no root master. Apache needs no privilege —
# every site listens on a loopback high port behind the hosting Caddy, and PHP
# runs elsewhere. systemd creates the log and pidfile directories owned by
# tpapache. The logs sit in /var/log/turbopanel/apache with the other engines'
# (reached through group tp, which the web service accounts belong to); the
# pidfile folder is top level in /run.
User={{ apache_service_user }}
Group={{ apache_service_group }}
LogsDirectory={{ apache_logs_directory }}
LogsDirectoryMode=0750
RuntimeDirectory={{ apache_runtime_directory }}
RuntimeDirectoryMode=0750
PIDFile=/run/{{ apache_runtime_directory }}/httpd.pid
ExecStart={{ turbopanel_vendor_dir }}/apache/current/bin/httpd -f {{ turbopanel_config_dir }}/apache/httpd.conf -k start
ExecReload={{ turbopanel_vendor_dir }}/apache/current/bin/httpd -f {{ turbopanel_config_dir }}/apache/httpd.conf -k graceful
ExecStop={{ turbopanel_vendor_dir }}/apache/current/bin/httpd -f {{ turbopanel_config_dir }}/apache/httpd.conf -k graceful-stop
Restart=on-failure
RestartSec=5
RestartSteps=10
RestartMaxDelaySec=120

[Install]
WantedBy=multi-user.target
