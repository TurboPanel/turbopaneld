<?xml version="1.0"?>
<!--
  TurboPanel ClickHouse — config.d overlay.

  Mounted read-only at /etc/clickhouse-server/config.d/turbopanel.xml inside the
  official clickhouse/clickhouse-server image; the base image config is preserved
  and this overlay only adjusts what we care about. Paths point at the image's
  in-container defaults under /var/lib/clickhouse and /var/log/clickhouse-server
  (the log dir is bind-mounted to {{ clickhouse_log_dir }} on the host). HTTP/TCP
  ports keep the base-image defaults — the container listens on 0.0.0.0 inside the
  Docker network; host exposure is already limited to the loopback -p publish.

  Memory caps (small co-located / single-server installs; defaults in
  roles/clickhouse/defaults/main.yml):
  - max_server_memory_usage = {{ clickhouse_max_server_memory_usage }} (absolute)
  - mark_cache_size = {{ clickhouse_mark_cache_size }}
  Docker also applies memory and cpus resource flags from the same defaults.

  Idle-CPU tuning (single otherwise-idle server): slow the async-metrics cadence,
  shrink always-awake background merge/schedule pools, cap the global thread pool
  and idle retention (max_thread_pool_size / max_thread_pool_free_size /
  thread_pool_queue_size), shrink eager-spawn schedule/move/fetch pools unused by
  the metrics-only workload, and disable the full ClickHouse 26.x system *_log
  MergeTree set so idle boxes do not keep ~100+ warm threads.
-->
<clickhouse>
    <logger>
        <level>information</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>

    <max_server_memory_usage>{{ clickhouse_max_server_memory_usage }}</max_server_memory_usage>
    <mark_cache_size>{{ clickhouse_mark_cache_size }}</mark_cache_size>

    <mlock_executable>false</mlock_executable>

    <builtin_dictionaries_reload_interval>3600</builtin_dictionaries_reload_interval>

    <max_session_timeout>3600</max_session_timeout>
    <default_session_timeout>60</default_session_timeout>

    <!-- Idle-CPU tuning: stop the 1s async-metrics wakeups. -->
    <asynchronous_metrics_update_period_s>120</asynchronous_metrics_update_period_s>
    <asynchronous_heavy_metrics_update_period_s>120</asynchronous_heavy_metrics_update_period_s>

    <!-- Shrink always-awake background pools on an idle single-server box. -->
    <background_pool_size>2</background_pool_size>
    <background_schedule_pool_size>2</background_schedule_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>
    <!-- Global thread pool: keep the ceiling low and do not retain ~1000 idle threads. -->
    <max_thread_pool_size>64</max_thread_pool_size>
    <max_thread_pool_free_size>8</max_thread_pool_free_size>
    <thread_pool_queue_size>64</thread_pool_queue_size>
    <!-- Eager-spawn schedule pools (spawn full count at startup; unused by metrics). -->
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
    <!-- On-demand background pools: cap ceiling (no tiered storage / replication). -->
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <tables_loader_foreground_pool_size>2</tables_loader_foreground_pool_size>
    <tables_loader_background_pool_size>2</tables_loader_background_pool_size>

    <merge_tree>
        <!-- Stop the constant merge-selector wakeups when there is nothing to merge. -->
        <merge_selecting_sleep_ms>30000</merge_selecting_sleep_ms>
        <!--
          ClickHouse 26.x refuses to start when these defaults (20 / 8 / 25) exceed
          background_pool_size * background_merges_mutations_concurrency_ratio
          (2 * 1 = 2 above). Keep each threshold ≤ that product so idle-CPU pool
          shrinks stay valid.
        -->
        <number_of_free_entries_in_pool_to_execute_mutation>1</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>1</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>1</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <!-- Disable system *_log MergeTree tables (each adds flush + merge scheduler threads). -->
    <query_log remove="remove"/>
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <session_log remove="remove"/>
    <part_log remove="remove"/>
    <text_log remove="remove"/>
    <error_log remove="remove"/>
    <crash_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <latency_log remove="remove"/>
    <backup_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <blob_storage_log remove="remove"/>
    <filesystem_cache_log remove="remove"/>
    <filesystem_read_prefetches_log remove="remove"/>
    <s3queue_log remove="remove"/>
    <background_schedule_pool_log remove="remove"/>
    <zookeeper_log remove="remove"/>
    <zookeeper_connection_log remove="remove"/>
    <aggregated_zookeeper_log remove="remove"/>
{% if turbopanel_dev_user | default('') | length > 0 %}
    <!--
      Dev-only CORS preflight response for the loopback Tabix browser client
      (http://127.0.0.1:{{ tabix_web_port | default('8125') }}). This block only
      answers the OPTIONS preflight; the actual response CORS header is emitted
      per-request via add_http_cors_header=1 carried on every Tabix query
      (CH_PARAMS). Gated on turbopanel_dev_user so managed/prod config is
      byte-for-byte unchanged.
    -->
    <http_options_response>
        <header>
            <name>Access-Control-Allow-Origin</name>
            <value>*</value>
        </header>
        <header>
            <name>Access-Control-Allow-Headers</name>
            <value>origin, x-requested-with, content-type, accept, authorization, x-clickhouse-user, x-clickhouse-key, x-clickhouse-format, x-clickhouse-database</value>
        </header>
        <header>
            <name>Access-Control-Allow-Methods</name>
            <value>GET, POST, OPTIONS</value>
        </header>
        <header>
            <name>Access-Control-Max-Age</name>
            <value>86400</value>
        </header>
    </http_options_response>
{% endif %}
</clickhouse>
