[Unit]
Description=TurboPanel instance
After=network-online.target docker.service turbopanel-system-stack.service
Wants=network-online.target turbopanel-system-stack.service
Requires=docker.service

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_instance_runtime_dir }}
Environment=XDG_DATA_HOME={{ turbopanel_instance_runtime_dir }}/share
Environment=XDG_STATE_HOME={{ turbopanel_instance_runtime_dir }}/state
Environment=XDG_CONFIG_HOME={{ turbopanel_instance_config_dir }}
Environment=TURBOPANEL_NODE={{ turbopanel_node }}
Environment=PATH={{ turbopanel_runtime_path }}
Environment="GIT_SSH_COMMAND=ssh -i {{ turbopanel_github_key }} -o IdentitiesOnly=yes -o UserKnownHostsFile={{ turbopanel_ssh_dir }}/known_hosts -o StrictHostKeyChecking=yes"
{# Only needed for a non-standard unit name — the instance defaults to
   turbopanel-instance (src/developer/system-routes.ts). #}
{% if instance_service_name != 'turbopanel-instance' %}
Environment=TURBOPANEL_INSTANCE_SERVICE={{ instance_service_name }}
{% endif %}
# UI serving mode: "dev" proxies to Expo, "static" serves the exported build.
# Caddy/Expo selection only — never an application dev-mode signal.
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
{% if turbopanel_dev_user | length > 0 and turbopanel_ui_mode == 'dev' and (turbopanel_instance_run_mode | default('source')) == 'source' and (turbopanel_instance_runtime | default('deno')) == 'deno' %}
# Explicit opt-in for the dev-only developer surface (fleet/diagnostics/shell/
# dev-sync/tunnel + /ws/developer) plus the dev-only auth relaxations
# (ephemeral secrets, PAM bypass, verification logging). This template is the
# sole managed writer of the flag, and only for co-located Deno source-mode dev
# (the src/deno-dev.ts ExecStart below). Never emitted on managed/production
# hosts, compiled binaries, Workers, or after switching to a static build. See
# ../turbopanel src/dev-mode.ts (isExplicitDevelopmentMode) — it honors this
# flag alone and fails closed without it.
Environment=TURBOPANEL_DEV_SURFACE=1
{% endif %}
{% if turbopanel_dev_user | length > 0 %}
# Docs site (turbopanel-website on WEBSITE_PORT) fetches OpenAPI from Caddy cross-origin.
Environment=TURBOPANEL_UI_CORS_ORIGINS={{ website_cors_origins }}
{% endif %}
{% if turbopanel_pg_password is defined and (turbopanel_instance_runtime | default('deno')) == 'deno' %}
Environment=TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@/{{ postgres_db }}?host={{ postgres_socket_dir }}
{% endif %}
{% if turbopanel_amqp_url is defined and (turbopanel_instance_runtime | default('deno')) == 'deno' %}
Environment=TURBOPANEL_AMQP_URL={{ turbopanel_amqp_url }}
{% endif %}
Environment=TURBOPANEL_REDIS_SOCKET={{ redis_socket_path }}
{% if turbopanel_dev_user | length > 0 %}
Environment=TURBOPANEL_DEV_USER={{ turbopanel_dev_user }}
{% endif %}
{% if turbopanel_dev_user | length > 0 and (turbopanel_instance_runtime | default('deno')) == 'deno' %}
Environment=TURBOPANEL_SYSTEM_EMAIL__PROVIDER=mailpit-smtp
Environment=TURBOPANEL_SYSTEM_EMAIL__MAILPIT_SMTP_PORT={{ mailpit_smtp_port | default(1025) }}
{% endif %}
Environment=TURBOPANEL_DAEMON_STATE_DIR={{ turbopanel_daemon_state_dir }}
Environment=TURBOPANEL_METRICS_DIR={{ turbopanel_metrics_dir }}
Environment=TURBOPANEL_USER={{ turbopanel_user }}
Environment=TURBOPANEL_CONFIG_DIR={{ turbopanel_config_dir }}
Environment=TURBOPANEL_RUN_DIR={{ turbopanel_run_dir }}
Environment=TURBOPANEL_INSTANCE_RUNTIME_ENV={{ turbopanel_instance_runtime_env }}
Environment=TURBOPANEL_INSTANCE_RUNTIME_DEV_VARS={{ turbopanel_instance_runtime_dev_vars }}
{% if (turbopanel_instance_runtime | default('deno')) != 'workers' %}
{# Deno/compiled: non-secret runtime.env first, then secrets from runtime.dev-vars. #}
EnvironmentFile=-{{ turbopanel_instance_runtime_env }}
{% endif %}
EnvironmentFile=-{{ turbopanel_instance_runtime_dev_vars }}
{# No Stripe env here on purpose. Billing exists only in the Workers build;
   self-hosted Deno is free software with no billing surface, so it must never
   be handed a Stripe key. The dev-only stripe-listen role keeps its own
   stripe.env for the CLI and the test-clock harness. #}
# turbopanel_instance_run_mode: "source" (deno run) | "compiled" (single binary)
StandardOutput=append:{{ instance_log_dir }}/instance.log
StandardError=append:{{ instance_log_dir }}/instance.err.log
{% if turbopanel_instance_runtime | default('deno') == 'workers' %}
Environment=WRANGLER_SEND_METRICS=false
Environment=CI=1
Environment=NO_COLOR=1
Environment=WRANGLER_DEV_PORT={{ wrangler_dev_port }}
ExecStart={{ turbopanel_instance_dir }}/scripts/workers-serve.sh
{% elif turbopanel_instance_run_mode == 'compiled' %}
{# deno compile self-extracts the duckdb.node addon but not its companion
   libduckdb.so (the dynamic linker cannot see the binary's virtual FS), so the
   compiled instance loads the vendored copy via LD_LIBRARY_PATH. Source mode
   needs no equivalent: both files are real siblings under node_modules. #}
Environment=LD_LIBRARY_PATH={{ turbopanel_duckdb_lib_dir }}
{% if turbopanel_dev_user | length == 0 %}
# Sandbox: production (tpctrl) compiled instance only. Co-located dev keeps its
# source checkout under the dev user's home, which these would hide.
# What the instance touches: its own state and the runtime socket dir (the
# listen socket Caddy and the daemon connect to, plus the Postgres/Redis/Caddy
# sockets under it), its logs, and /tmp (Deno extracts the embedded DuckDB
# addon to /tmp/deno-native-addons; PrivateTmp gives it a private one). The
# DuckDB library is read from /opt/turbopanel/lib.
# NOT set, on purpose: NoNewPrivileges (sudo is setuid: credentials.ts runs
# `sudo pamtester`, upgrades run `sudo systemctl restart`),
# MemoryDenyWriteExecute (V8 JIT), SystemCallFilter and a positive CapabilityBoundingSet (the sudo
# targets run as root and are not proven under a filter). The reasoning is in
# src/orchestration/instance-unit-sandbox.test.ts.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# /run/sudo, /var/lib/sudo and /run/faillock: sudo's timestamp dir (either
# distro layout) and PAM's failure counter, written by the root children
# (sudo, pamtester) of the host-credential login.
ReadWritePaths=-{{ turbopanel_run_dir }} -{{ turbopanel_daemon_state_dir }} -{{ turbopanel_metrics_dir }} -{{ turbopanel_instance_runtime_dir }} -{{ turbopanel_instance_config_dir }} -{{ instance_log_dir }} -/run/sudo -/run/faillock -/var/lib/sudo
# AF_NETLINK: os.networkInterfaces() (getifaddrs) and sudo's audit socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Capabilities nothing the instance (or its sudo targets) uses.
CapabilityBoundingSet=~CAP_SYS_PTRACE CAP_SYS_BOOT CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_NET_ADMIN CAP_NET_RAW CAP_LINUX_IMMUTABLE CAP_WAKE_ALARM
{% endif %}
ExecStart={{ turbopanel_instance_binary }}
{% else %}
{# Outbound network is unrestricted on self-hosted (decided 2026-09-18): the
   instance talks to whatever the operator configures — webhooks, chat, push
   relays, a self-managed forge — and the host firewall is the boundary. Deno
   2.9+ also treats Unix-domain connect as --allow-net (not --allow-read), so
   the flag must stay even with no host list. The one carve-out is the cloud
   metadata endpoints (--deny-net), the same list the daemon denies. #}
{% if turbopanel_dev_user | length > 0 and turbopanel_ui_mode == 'dev' %}
ExecStart={{ turbopanel_deno }} run --allow-env --allow-sys=networkInterfaces,hostname --allow-ffi={{ turbopanel_instance_dir }}/node_modules --allow-read={{ turbopanel_run_dir }},{{ postgres_socket_dir }},{{ turbopanel_daemon_dir }},{{ turbopanel_instance_dir }},{{ turbopanel_instance_runtime_dir }},{{ turbopanel_daemon_state_dir }},{{ turbopanel_metrics_dir }} --allow-write={{ turbopanel_run_dir }},{{ postgres_socket_dir }},{{ turbopanel_instance_runtime_dir }},{{ turbopanel_daemon_state_dir }},{{ turbopanel_metrics_dir }} --allow-net --deny-net=169.254.169.254,metadata.google.internal,[fd00:ec2::254] --allow-run=git,systemctl,tar,sudo,/usr/bin/sudo,/bin/sh,mkfifo,/usr/bin/mkfifo,pamtester,/usr/bin/pamtester,openssl,/usr/bin/openssl,{{ turbopanel_node }},{{ turbopanel_deno }} src/deno-dev.ts
{% else %}
ExecStart={{ turbopanel_deno }} run --allow-env --allow-sys=networkInterfaces,hostname --allow-ffi={{ turbopanel_instance_dir }}/node_modules --allow-read={{ turbopanel_run_dir }},{{ postgres_socket_dir }},{{ turbopanel_daemon_dir }},{{ turbopanel_instance_dir }},{{ turbopanel_instance_runtime_dir }},{{ turbopanel_daemon_state_dir }},{{ turbopanel_metrics_dir }} --allow-write={{ turbopanel_run_dir }},{{ postgres_socket_dir }},{{ turbopanel_instance_runtime_dir }},{{ turbopanel_daemon_state_dir }},{{ turbopanel_metrics_dir }} --allow-net --deny-net=169.254.169.254,metadata.google.internal,[fd00:ec2::254] --allow-run=sudo,/usr/bin/sudo,/bin/sh,pamtester,/usr/bin/pamtester,openssl,/usr/bin/openssl src/deno.ts
{% endif %}
{% endif %}
Restart=always
RestartSec=2
# On SIGTERM the instance flushes its queues and metrics, ends its database
# pool and exits by itself in about a second (src/platform/deno/
# instance-shutdown.ts; it force-exits at 6 s). Deno.serve alone would wait on
# long-lived daemon WebSockets and the idle Postgres pool, so this timeout is
# only the backstop before SIGKILL.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
