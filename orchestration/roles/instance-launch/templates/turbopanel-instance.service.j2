[Unit]
Description=TurboPanel instance
After=network-online.target docker.service turbopanel-postgres.service turbopanel-rabbitmq.service
Wants=network-online.target turbopanel-postgres.service turbopanel-rabbitmq.service
Requires=docker.service

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_instance_runtime_dir }}
Environment=XDG_DATA_HOME={{ turbopanel_instance_runtime_dir }}/share
Environment=XDG_STATE_HOME={{ turbopanel_instance_runtime_dir }}/state
Environment=XDG_CONFIG_HOME={{ turbopanel_instance_config_dir }}
Environment=TURBOPANEL_NODE={{ turbopanel_node }}
Environment=PATH={{ turbopanel_runtime_path }}
Environment="GIT_SSH_COMMAND=ssh -i {{ turbopanel_github_key }} -o IdentitiesOnly=yes -o UserKnownHostsFile={{ turbopanel_ssh_dir }}/known_hosts -o StrictHostKeyChecking=yes"
Environment=TURBOPANEL_INSTANCE_SERVICE={{ instance_service_name }}
Environment=TURBOPANEL_UI_SERVICE={{ ui_service_name }}
# Gates the dev-only developer surface (dev != static). See ../instance src/dev-mode.ts.
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
# Docs site (turbopanel-website on WEBSITE_PORT) fetches OpenAPI from Caddy cross-origin.
Environment=TURBOPANEL_UI_CORS_ORIGINS={{ website_cors_origins }}
{% if turbopanel_pg_password is defined and (turbopanel_instance_runtime | default('deno')) == 'deno' %}
Environment=TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@/{{ postgres_db }}?host={{ postgres_socket_dir }}
{% endif %}
{% if turbopanel_amqp_url is defined %}
Environment=TURBOPANEL_AMQP_URL={{ turbopanel_amqp_url }}
{% endif %}
Environment=TURBOPANEL_REDIS_SOCKET={{ redis_socket_path }}
{% if turbopanel_dev_user | length > 0 %}
Environment=TURBOPANEL_DEV_USER={{ turbopanel_dev_user }}
{% endif %}
{% if turbopanel_dev_user | length > 0 %}
Environment=TURBOPANEL_SYSTEM_EMAIL__PROVIDER=smtp
Environment=TURBOPANEL_SYSTEM_EMAIL__SMTP_HOST=127.0.0.1
Environment=TURBOPANEL_SYSTEM_EMAIL__SMTP_PORT={{ mailpit_smtp_port | default(1025) }}
{% endif %}
Environment=TURBOPANEL_DAEMON_STATE_DIR={{ turbopanel_daemon_state_dir }}
Environment=TURBOPANEL_CONFIG_DIR={{ turbopanel_config_dir }}
Environment=TURBOPANEL_RUN_DIR={{ turbopanel_run_dir }}
Environment=TURBOPANEL_INSTANCE_RUNTIME_ENV={{ turbopanel_instance_runtime_env }}
Environment=TURBOPANEL_INSTANCE_RUNTIME_DEV_VARS={{ turbopanel_instance_runtime_dev_vars }}
EnvironmentFile=-{{ turbopanel_instance_runtime_dev_vars }}
# turbopanel_instance_run_mode: "source" (deno run) | "compiled" (single binary)
StandardOutput=append:{{ instance_log_dir }}/instance.log
StandardError=append:{{ instance_log_dir }}/instance.err.log
{% if turbopanel_instance_runtime | default('deno') == 'workers' %}
Environment=WRANGLER_SEND_METRICS=false
Environment=CI=1
Environment=NO_COLOR=1
Environment=WRANGLER_DEV_PORT={{ wrangler_dev_port }}
ExecStart={{ turbopanel_instance_dir }}/scripts/workers-serve.sh
{% elif turbopanel_instance_run_mode == 'compiled' %}
ExecStart={{ turbopanel_instance_binary }}
{% else %}
ExecStart={{ turbopanel_deno }} run --allow-env --allow-sys=networkInterfaces,hostname --allow-read={{ turbopanel_run_dir }},{{ postgres_socket_dir }},{{ turbopanel_daemon_dir }},{{ turbopanel_instance_dir }},{{ turbopanel_instance_runtime_dir }} --allow-write={{ turbopanel_run_dir }},{{ postgres_socket_dir }},{{ turbopanel_instance_runtime_dir }},{{ turbopanel_daemon_state_dir }} --allow-net=127.0.0.1:{{ drizzle_studio_port | default(4983) }},127.0.0.1:{{ rabbitmq_amqp_port }},127.0.0.1:{{ mailpit_smtp_port | default(1025) }},dl.trbp.nl:443,unix:{{ turbopanel_run_dir }}/instance.sock --allow-run=git,systemctl,tar,sudo,/usr/bin/sudo,/bin/sh,mkfifo,/usr/bin/mkfifo,pamtester,/usr/bin/pamtester,{{ turbopanel_node }},{{ turbopanel_deno }} src/deno.ts
{% endif %}
Restart=always
RestartSec=2
# Deno.serve waits for active WS connections to drain on SIGTERM which can hang
# indefinitely with long-lived daemon connections. Kill promptly instead.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
