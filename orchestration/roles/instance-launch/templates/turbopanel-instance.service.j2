[Unit]
Description=TurboPanel instance
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_instance_dir }}
Environment=PATH={{ turbopanel_runtimes_dir }}/node/current/bin:{{ turbopanel_runtimes_dir }}/deno/current:{{ turbopanel_runtimes_dir }}/caddy/current:/usr/local/bin:/usr/bin:/bin
Environment="GIT_SSH_COMMAND=ssh -i {{ turbopanel_github_key }} -o IdentitiesOnly=yes -o UserKnownHostsFile={{ turbopanel_ssh_dir }}/known_hosts -o StrictHostKeyChecking=yes"
Environment=TURBOPANEL_INSTANCE_SERVICE={{ instance_service_name }}
Environment=TURBOPANEL_UI_SERVICE={{ ui_service_name }}
# Gates the dev-only developer surface (dev != static). See ../turbopanel src/dev-mode.ts.
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
Environment=TURBOPANEL_PG_USER={{ postgres_user }}
Environment=TURBOPANEL_PG_DB={{ postgres_db }}
Environment=TURBOPANEL_PG_PORT={{ postgres_port }}
{% if lookup('ansible.builtin.file', turbopanel_config_dir + '/postgres/.pgpass', errors='ignore') %}
Environment=TURBOPANEL_PG_PASSWORD={{ lookup('ansible.builtin.file', turbopanel_config_dir + '/postgres/.pgpass') | trim }}
{% endif %}
Environment=TURBOPANEL_PG_SOCKET={{ postgres_socket_dir }}/.s.PGSQL.{{ postgres_port }}
ExecStart={{ turbopanel_runtimes_dir }}/deno/current/deno run --allow-env --allow-sys=networkInterfaces --allow-read=/run/turbopanel,{{ postgres_socket_dir }},{{ turbopanel_daemon_dir }},{{ turbopanel_instance_dir }} --allow-write=/run/turbopanel,{{ postgres_socket_dir }} --allow-net=127.0.0.1:{{ drizzle_studio_port | default(4983) }} --allow-run=git,systemctl,tar,sudo,/usr/bin/sudo,/bin/sh,mkfifo,/usr/bin/mkfifo,pamtester,/usr/bin/pamtester,{{ turbopanel_runtimes_dir }}/node/current/bin/node,tmux src/deno.ts
Restart=always
RestartSec=2
# Deno.serve waits for active WS connections to drain on SIGTERM which can hang
# indefinitely with long-lived daemon connections. Kill promptly instead.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
