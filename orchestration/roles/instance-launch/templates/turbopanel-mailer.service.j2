[Unit]
Description=TurboPanel mailer
After=turbopanel-instance.service turbopanel-system-stack.service
Requires=turbopanel-system-stack.service

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_instance_runtime_dir }}
{# Load runtime.env + runtime.dev-vars so the mailer sees TURBOPANEL_SECRET and
   TURBOPANEL_SECRETS and can derive the data-encryption keyring for DB-backed
   email secrets (MAILGUN_API_KEY / SMTP_PASS). Placed before the explicit
   Environment= lines below so the mailer-specific overrides still win. #}
EnvironmentFile=-{{ turbopanel_instance_runtime_env }}
EnvironmentFile=-{{ turbopanel_instance_runtime_dev_vars }}
{% if turbopanel_amqp_url is defined %}
Environment=TURBOPANEL_AMQP_URL={{ turbopanel_amqp_url }}
{% endif %}
{% if turbopanel_pg_password is defined %}
Environment=TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@/{{ postgres_db }}?host={{ postgres_socket_dir }}
{% endif %}
Environment=TURBOPANEL_MAILER_RATE_LIMIT_PER_MINUTE=60
Environment=MAILPIT_SMTP_PORT={{ mailpit_smtp_port | default(1025) }}
{% if turbopanel_dev_user | length > 0 %}
Environment=TURBOPANEL_SYSTEM_EMAIL__PROVIDER=mailpit
Environment=MAILPIT_API_URL=http://127.0.0.1:{{ mailpit_web_port | default(8025) }}
{% endif %}
{# Deno 2.9+ treats Unix-domain connect as --allow-net (not --allow-read).
   postgres.js also needs --allow-write on the socket path to connect. #}
ExecStart={{ turbopanel_deno }} run \
  --allow-env \
  --allow-net=127.0.0.1:{{ rabbitmq_amqp_port }},127.0.0.1:{{ mailpit_smtp_port | default(1025) }},127.0.0.1:{{ mailpit_web_port | default(8025) }},127.0.0.1:{{ drizzle_studio_port | default(4983) }}{% if turbopanel_pg_password is defined %},unix:{{ postgres_socket_dir }}/.s.PGSQL.5432{% endif %} \
  --allow-read={{ turbopanel_instance_dir }},{{ turbopanel_instance_runtime_dir }}{% if turbopanel_pg_password is defined %},{{ postgres_socket_dir }}{% endif %} \
{% if turbopanel_pg_password is defined %}
  --allow-write={{ postgres_socket_dir }} \
{% endif %}
  mailer/main.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
