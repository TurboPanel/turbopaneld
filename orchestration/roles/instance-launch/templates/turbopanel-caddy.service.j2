[Unit]
Description=TurboPanel Caddy reverse proxy
After=network-online.target {{ instance_service_name }}.service
Wants=network-online.target

[Service]
Type=simple
User={{ caddy_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_caddy_runtime_dir }}
Environment=XDG_DATA_HOME={{ turbopanel_caddy_runtime_dir }}/share
Environment=XDG_STATE_HOME={{ turbopanel_caddy_runtime_dir }}/state
Environment=XDG_CONFIG_HOME={{ turbopanel_caddy_config_dir }}
Environment=CADDY_PORT={{ caddy_port }}
Environment=TURBOPANEL_RUN_DIR={{ turbopanel_run_dir }}
Environment=TURBOPANEL_SOCKET_DIAL={{ (turbopanel_run_dir ~ '/instance.sock') | regex_replace('^/+', '') }}
Environment=TURBOPANEL_UI_ROOT={{ turbopanel_ui_dist_dir }}
{% if turbopanel_dev_user | default('') | length > 0 %}
Environment=CADDY_HTTP_PORT={{ caddy_http_port }}
Environment=TURBOPANEL_INSTANCE_RUNTIME={{ turbopanel_instance_runtime | default('deno') }}
Environment=WRANGLER_DEV_PORT={{ wrangler_dev_port | default(18787) }}
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
Environment=EXPO_PORT={{ expo_port }}
Environment=TURBOPANEL_DEV_ORCHESTRATION_DIR={{ turbopanel_dev_root }}/dev/orchestration
{% if turbopanel_ui_mode == 'dev' %}
Environment=TURBOPANEL_DAEMON_REPO={{ turbopanel_daemon_dir }}
{% endif %}
{% endif %}
Environment=GOMAXPROCS=1
ExecStart={{ turbopanel_vendor_dir }}/caddy/current/caddy run --config {{ turbopanel_caddyfile }} --adapter caddyfile
ExecReload={{ turbopanel_vendor_dir }}/caddy/current/caddy reload --config {{ turbopanel_caddyfile }} --adapter caddyfile
# Rescue path when reload fails: cap stop so cert-apply cannot hang on Caddy's
# eternal grace shutdown (admin should be localhost-only so reload usually works).
TimeoutStopSec=20
Restart=always
RestartSec=2
CPUQuota=100%

[Install]
WantedBy=multi-user.target
