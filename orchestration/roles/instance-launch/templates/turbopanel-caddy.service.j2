[Unit]
Description=TurboPanel Caddy reverse proxy
After=network-online.target {{ instance_service_name }}.service
Wants=network-online.target

[Service]
Type=simple
User={{ caddy_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_caddy_runtime_dir }}
# XDG_DATA_HOME is this unit's Caddy data directory. It must stay distinct
# from hosting Caddy (<state>/hosting-caddy) and from site Caddy
# (<state>/site-caddy). The processes must never share on-disk storage.
Environment=XDG_DATA_HOME={{ turbopanel_caddy_runtime_dir }}/share
Environment=XDG_STATE_HOME={{ turbopanel_caddy_runtime_dir }}/state
Environment=XDG_CONFIG_HOME={{ turbopanel_caddy_config_dir }}
{# The managed Caddyfile binds literal :8443 and does not read caddy_port.
   The CADDY_* env below stays for the co-located dev overlay Caddyfile, which
   still reads it. self-signed.* remains a symlink to platform-ca.* for one
   release. #}
Environment=CADDY_PORT={{ caddy_port }}
{% if turbopanel_tls_mode | default('self_signed') == 'upload' %}
Environment=CADDY_TLS_CERT={{ turbopanel_instance_certs_dir }}/uploaded.crt
Environment=CADDY_TLS_KEY={{ turbopanel_instance_certs_dir }}/uploaded.key
{% else %}
Environment=CADDY_TLS_CERT={{ turbopanel_instance_certs_dir }}/self-signed.crt
Environment=CADDY_TLS_KEY={{ turbopanel_instance_certs_dir }}/self-signed.key
{% endif %}
{# Both Caddyfiles dial unix/<run dir>/instance.sock — the same run-dir +
   filename contract as the instance (src/server-paths.ts). #}
Environment=TURBOPANEL_RUN_DIR={{ turbopanel_run_dir }}
Environment=TURBOPANEL_UI_ROOT={{ turbopanel_ui_dist_dir }}
{% if turbopanel_dev_user | default('') | length > 0 %}
Environment=TURBOPANEL_INSTANCE_RUNTIME={{ turbopanel_instance_runtime | default('deno') }}
Environment=WRANGLER_DEV_PORT={{ wrangler_dev_port | default(18787) }}
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
Environment=TURBOPANEL_DEV_ORCHESTRATION_DIR={{ turbopanel_dev_root }}/dev/orchestration
Environment=TURBOPANEL_DAEMON_REPO={{ turbopanel_daemon_dir }}
{% if turbopanel_ui_mode == 'dev' %}
Environment=EXPO_PORT={{ expo_port }}
{% endif %}
{% endif %}
Environment=GOMAXPROCS=1
{% if turbopanel_dev_user | default('') | length == 0 %}
# `+` runs as root despite User=, so the socket directory exists before
# Caddy binds turbopanel_caddy_admin_socket. Mode 0750, owned by caddy_user.
ExecStartPre=+/usr/bin/install -d -o {{ caddy_user }} -g {{ caddy_primary_group }} -m 0750 {{ turbopanel_caddy_admin_socket | dirname }}
{% endif %}
ExecStart={{ turbopanel_vendor_dir }}/caddy/current/caddy run --config {{ turbopanel_caddyfile }} --adapter caddyfile
{% if turbopanel_dev_user | default('') | length > 0 %}
# The dev overlay Caddyfile keeps its own admin listener. Omitting --address
# uses that listener. Managed installs target the Unix socket below.
ExecReload={{ turbopanel_vendor_dir }}/caddy/current/caddy reload --config {{ turbopanel_caddyfile }} --adapter caddyfile --force
{% else %}
ExecReload={{ turbopanel_vendor_dir }}/caddy/current/caddy reload --config {{ turbopanel_caddyfile }} --adapter caddyfile --address unix/{{ turbopanel_caddy_admin_socket }} --force
{% endif %}
# Rescue path when reload fails: cap stop so cert-apply cannot hang on Caddy's
# eternal grace shutdown. Managed reload uses the admin Unix socket.
TimeoutStopSec=20
Restart=always
RestartSec=2
CPUQuota=100%

[Install]
WantedBy=multi-user.target
