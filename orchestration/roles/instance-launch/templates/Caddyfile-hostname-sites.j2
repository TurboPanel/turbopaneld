{#
  One named :8443 site per uploaded or ready Let's Encrypt hostname. Included
  by Caddyfile.j2 (managed install) and Caddyfile-dev-sites.j2 (co-located
  development); the including template sets _certs_dir and defines the
  (turbopanel_app) snippet, or imports a Caddyfile that does.

  A DNS-01 pair the control plane issued reaches the daemon as `uploaded`
  with its certificate id, so it renders here like an operator upload.
  A Let's Encrypt name renders only when letsencrypt-<host>.{crt,key} exist
  (turbopanel_letsencrypt_ready, from letsencrypt-files.yml), so the first
  apply cannot fail Caddy validate or load.
#}
{% for h in turbopanel_hostnames | default([]) %}
{% if h.source == 'lets-encrypt' or h.source == 'uploaded' %}
{% set _site = h.host | regex_replace('^https?://', '') | regex_replace('/.*$', '') | regex_replace(':.*$', '') %}
{% if _site | length > 0 %}
{% if h.source == 'uploaded' %}
{% set _id = h.cert_id | default('') %}
{% set _leaf = ('uploaded-' ~ _id) if (_id | length > 0) else 'uploaded' %}
{{ _site }}:8443 {
        tls {{ _certs_dir }}/{{ _leaf }}.crt {{ _certs_dir }}/{{ _leaf }}.key
        import turbopanel_app
}
{% elif _site in (turbopanel_letsencrypt_ready | default([])) %}
{{ _site }}:8443 {
        tls {{ _certs_dir }}/letsencrypt-{{ _site }}.crt {{ _certs_dir }}/letsencrypt-{{ _site }}.key
        import turbopanel_app
}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
