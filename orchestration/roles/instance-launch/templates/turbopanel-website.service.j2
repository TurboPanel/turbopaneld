[Unit]
Description=TurboPanel website (Next.js docs dev server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_website_dir }}
Environment=HOME={{ turbopanel_website_runtime_dir }}
Environment=XDG_DATA_HOME={{ turbopanel_website_runtime_dir }}/share
Environment=XDG_STATE_HOME={{ turbopanel_website_runtime_dir }}/state
Environment=XDG_CONFIG_HOME={{ turbopanel_website_config_dir }}
Environment=PATH=/usr/local/bin:{{ turbopanel_runtimes_dir }}/node/current/bin:/usr/bin:/bin
Environment=WEBSITE_PORT={{ website_port }}
Environment=NEXT_PUBLIC_WEBSITE_PORT={{ website_port }}
Environment=CADDY_PORT={{ caddy_port }}
Environment=NEXT_PUBLIC_CADDY_PORT={{ caddy_port }}
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Invoke next via node — pnpm exec can prompt when HOME differs from install user.
ExecStart={{ turbopanel_runtimes_dir }}/node/current/bin/node {{ turbopanel_website_dir }}/node_modules/next/dist/bin/next dev --port {{ website_port }}
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
