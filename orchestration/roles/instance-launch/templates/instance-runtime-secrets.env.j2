# Managed by instance-launch. Root-only (0600): systemd reads it as root, so
# these values stay out of the unit text, `systemctl cat` and the journal.
# Shared by the instance unit (Deno/compiled) and the Drizzle Studio unit.
{% if turbopanel_pg_password is defined %}
{% if (turbopanel_instance_runtime | default('deno')) == 'workers' %}
TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@localhost:{{ postgres_port }}/{{ postgres_db }}
{% else %}
TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@/{{ postgres_db }}?host={{ postgres_socket_dir }}
{% endif %}
{% endif %}
{% if turbopanel_amqp_url is defined and (turbopanel_instance_runtime | default('deno')) == 'deno' %}
TURBOPANEL_AMQP_URL={{ turbopanel_amqp_url }}
{% endif %}
