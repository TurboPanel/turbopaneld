# Managed by instance-launch (Workers runtime). Lives under platform config, not the git checkout.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@localhost:{{ postgres_port }}/{{ postgres_db }}
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@localhost:{{ postgres_port }}/{{ postgres_db }}
TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@localhost:{{ postgres_port }}/{{ postgres_db }}
TURBOPANEL_SERVER_METRICS_RETENTION_DAYS={{ turbopanel_server_metrics_retention_days | default(90) }}
{% if turbopanel_instance_revision | default('') | length > 0 %}
TURBOPANEL_REVISION={{ turbopanel_instance_revision }}
{% endif %}
