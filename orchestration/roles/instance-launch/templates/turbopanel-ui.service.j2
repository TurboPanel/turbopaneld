[Unit]
Description=TurboPanel UI (Expo web dev server)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_ui_dir }}
Environment=HOME={{ turbopanel_ui_runtime_dir }}
Environment=XDG_DATA_HOME={{ turbopanel_ui_runtime_dir }}/share
Environment=XDG_STATE_HOME={{ turbopanel_ui_runtime_dir }}/state
Environment=XDG_CONFIG_HOME={{ turbopanel_ui_config_dir }}
Environment=PATH=/usr/local/bin:{{ turbopanel_runtimes_dir }}/node/current/bin:/usr/bin:/bin
Environment=BROWSER=none
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Do not set CI=1 — Expo/Metro disable Fast Refresh (hot=false) in CI mode.
# Use the linked expo binary directly — `pnpm exec` runs an implicit install that
# prompts to purge node_modules when HOME differs from the turbopanel-user install.
# Runtime state (Expo, pnpm XDG dirs) lives under {{ turbopanel_ui_runtime_dir }} (gitignored).
ExecStart=/usr/bin/tmux new-session -d -s expo-ui {{ turbopanel_ui_dir }}/node_modules/.bin/expo start --web --port {{ expo_port }}
ExecStop=/usr/bin/tmux kill-session -t expo-ui
KillMode=process
RemainAfterExit=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
