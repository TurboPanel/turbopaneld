[Unit]
Description=TurboPanel Drizzle Studio
After=network-online.target docker.service turbopanel-system-stack.service {{ instance_service_name }}.service
Wants=network-online.target turbopanel-system-stack.service {{ instance_service_name }}.service
# Never give up retrying: the default start limit (5 starts in 10 s) left this
# unit failed after a burst of quick failures until someone logged in.
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_instance_runtime_dir }}
Environment=XDG_CONFIG_HOME={{ turbopanel_instance_config_dir }}
Environment=TURBOPANEL_NODE={{ turbopanel_node }}
Environment=PATH={{ turbopanel_runtime_path }}
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
Environment=TURBOPANEL_DRIZZLE_STUDIO_PORT={{ drizzle_studio_port | default(4983) }}
Environment=TURBOPANEL_DRIZZLE_STUDIO_HOST=127.0.0.1
{% if turbopanel_pg_password is defined %}
EnvironmentFile={{ turbopanel_instance_runtime_secrets }}
{% endif %}
StandardOutput=append:{{ instance_log_dir }}/dbstudio.log
StandardError=append:{{ instance_log_dir }}/dbstudio.err.log
ExecStart={{ turbopanel_instance_dir }}/scripts/drizzle-studio-serve.sh
Restart=on-failure
RestartSec=2
RestartSteps=10
RestartMaxDelaySec=120

[Install]
WantedBy=multi-user.target
