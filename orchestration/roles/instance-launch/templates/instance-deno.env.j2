# Managed by instance-launch (Deno runtime). Lives under platform config, not the git checkout.
{% if turbopanel_public_urls | default('', true) | trim | length > 0 %}
TURBOPANEL_PUBLIC_URLS={{ turbopanel_public_urls }}
{% endif %}
{% if turbopanel_tls_public_effective | default(false) | bool %}
TURBOPANEL_TLS_PUBLIC=1
{% endif %}
TURBOPANEL_SERVER_METRICS_RETENTION_DAYS={{ turbopanel_server_metrics_retention_days | default(90) }}
{% if turbopanel_instance_revision | default('') | length > 0 %}
TURBOPANEL_REVISION={{ turbopanel_instance_revision }}
{% endif %}
