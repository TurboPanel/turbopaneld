{#
  TurboPanel reverse proxy for managed (self-hosted) installs.

  One template, rendered by the instance-launch role to
  {{ turbopanel_caddyfile }} ({{ turbopanel_config_dir }}/caddy/Caddyfile).
  This process binds exactly one TCP port, literal :8443. An extra-var
  cannot move it. It never binds :80 or :443 and never runs Let's Encrypt.
  The admin API is the Unix socket turbopanel_caddy_admin_socket.
  Per-hostname sites come from
  turbopanel_hostnames (uploaded always; lets-encrypt only when
  letsencrypt-<host>.{crt,key} exist — see letsencrypt-files.yml). The bare
  :8443 site is the Platform CA catch-all for IPs and other names.
  turbopanel_tls_mode is a display-only derivation of sources.

  Co-located development does not use this template: the turbopanel/dev
  overlay ships its own Caddyfile.
#}
{% set ns = namespace(uploaded=false, acme=false) %}
{% for h in turbopanel_hostnames | default([]) %}
{% if h.source == 'uploaded' %}{% set ns.uploaded = true %}{% endif %}
{% if h.source == 'lets-encrypt' %}{% set ns.acme = true %}{% endif %}
{% endfor %}
{% set mode = namespace(name='self_signed') %}
{% if ns.uploaded %}{% set mode.name = 'upload' %}
{% elif ns.acme %}{% set mode.name = 'lets_encrypt' %}
{% endif %}
{% set _certs_dir = turbopanel_instance_certs_dir %}
# TurboPanel reverse proxy (managed install, tls mode: {{ mode.name }}).
# Rendered by the turbopaneld instance-launch role from
# roles/instance-launch/templates/Caddyfile.j2 — do not edit in place.
#
#   /api/*, /ws/*, /webhook/*  -> Deno instance (Unix socket)
#   everything else            -> static UI export
#
# The catch-all below answers `try_files {path} /index.html`, so ANY prefix the
# instance owns must be matched before it. A missed prefix does not 404 — it
# serves the SPA shell with HTTP 200, and a Git provider reads that as a
# delivered webhook and never retries. Add the matcher when you add the surface.
{
        # Unix socket in a directory owned by caddy_user. Not a TCP listener.
        admin unix/{{ turbopanel_caddy_admin_socket }}
        auto_https off
        # Hosting Caddy (and cloudflared) dial this process from loopback and
        # set X-Forwarded-For. {client_ip} then keeps the original client on
        # X-Real-IP. A direct peer has that header stripped above, so
        # {client_ip} is the peer itself.
        servers {
                trusted_proxies static 127.0.0.0/8 ::1
        }
}

(turbopanel_app) {
        # Forwarding headers are believable only from a connector on this host — a
        # `cloudflared` tunnel beside Caddy, or another local proxy. Strip any
        # client-supplied copy so a daemon dialling this proxy over the network
        # cannot declare its own address; the instance reads CF-Connecting-IP /
        # X-Forwarded-For only when its immediate peer is loopback
        # (TURBOPANEL_TRUSTED_PROXY_CIDRS widens that set).
        @remote_peer not remote_ip 127.0.0.0/8 ::1
        request_header @remote_peer -CF-Connecting-IP
        request_header @remote_peer -True-Client-IP
        request_header @remote_peer -X-Forwarded-For

        # Baseline response headers. HSTS is safe even on the self-signed
        # default: a browser that already trusts the leaf (Organization CA, or a
        # manually-imported cert) should not be downgraded to plaintext on a later
        # visit, and a real browser will remember and enforce it.
        # This never applies to tenant hosting sites — those are a separate,
        # per-server Caddy config the daemon generates, not this file.
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
        }

        @api path /api/*
        handle @api {
                # Defense in depth only — the app itself enforces the real per-route
                # budgets (a few KB for auth, 2 MB for the largest daemon body) via
                # streaming readers that never buffer past the limit either way. This
                # just keeps an oversized request from reaching the app socket at all.
                request_body {
                        max_size 8MB
                }
                reverse_proxy unix/{{ turbopanel_run_dir }}/instance.sock {
                        header_up X-Real-IP {client_ip}
                }
        }

        @ws path /ws/*
        handle @ws {
                reverse_proxy unix/{{ turbopanel_run_dir }}/instance.sock {
                        header_up X-Real-IP {client_ip}
                }
        }

        # Inbound Git provider webhooks. Its own top-level prefix because the caller
        # is GitHub or GitLab — no session, no daemon JWT, no Origin — so it is a
        # different class of traffic from /api. X-Real-IP is load-bearing here: the
        # webhook rate limiter keys per peer address, and without it every delivery
        # on the instance shares one bucket.
        @webhook path /webhook/*
        handle @webhook {
                # Defense in depth — GITHUB_WEBHOOK_MAX_BODY_BYTES / GITLAB_WEBHOOK_MAX_BODY_BYTES
                # are both 1 MB; the app's own streaming reader is the authoritative limit.
                request_body {
                        max_size 2MB
                }
                reverse_proxy unix/{{ turbopanel_run_dir }}/instance.sock {
                        header_up X-Real-IP {client_ip}
                }
        }

        # Serve the exported UI (turbopanel-ui-<version>.tar.gz → share/ui).
        handle {
                root * {{ turbopanel_ui_dist_dir }}
                try_files {path} /index.html
                file_server
        }

        # Upstream 502/503/504 while the instance socket is down (package
        # swap and restart). API and websocket callers get a JSON 503 they
        # can retry; Git webhooks get a bare 503; HTML navigation gets
        # updating.html, which refreshes itself.
        # Named matchers are unique per site, including inside handle_errors.
        # Reusing @api/@ws/@webhook here makes Caddy refuse to start
        # ("matcher is defined more than once").
        handle_errors {
                @updating `{http.error.status_code} in [502, 503, 504]`
                handle @updating {
                        @updating_api path /api/*
                        handle @updating_api {
                                header Content-Type "application/json"
                                header Retry-After "5"
                                respond `{"ok":false,"error":"control_plane_updating"}` 503
                        }
                        @updating_ws path /ws/*
                        handle @updating_ws {
                                header Content-Type "application/json"
                                header Retry-After "5"
                                respond `{"ok":false,"error":"control_plane_updating"}` 503
                        }
                        @updating_webhook path /webhook/*
                        handle @updating_webhook {
                                respond "" 503
                        }
                        handle {
                                header Content-Type "text/html; charset=utf-8"
                                header Retry-After "5"
                                root * {{ turbopanel_caddyfile | dirname }}
                                rewrite * /updating.html
                                file_server
                        }
                }
        }
}

# Always-on recovery listener. The Platform CA leaf covers every platform-ca
# hostname, operator extra SANs, and the machine name (instance-certs), and
# is still minted when the operator has configured none. IPs and names
# without a dedicated site land here. An unlisted public install name has to
# be one of those SANs; the license route refuses a name the leaf does not
# cover.
:8443 {
        tls {{ _certs_dir }}/platform-ca.crt {{ _certs_dir }}/platform-ca.key
        import turbopanel_app
}

{% for h in turbopanel_hostnames | default([]) %}
{% if h.source == 'lets-encrypt' or h.source == 'uploaded' %}
{% set _site = h.host | regex_replace('^https?://', '') | regex_replace('/.*$', '') | regex_replace(':.*$', '') %}
{% if _site | length > 0 %}
{% if h.source == 'uploaded' %}
{% set _id = h.cert_id | default('') %}
{% set _leaf = ('uploaded-' ~ _id) if (_id | length > 0) else 'uploaded' %}
{{ _site }}:8443 {
        tls {{ _certs_dir }}/{{ _leaf }}.crt {{ _certs_dir }}/{{ _leaf }}.key
        import turbopanel_app
}
{% elif _site in (turbopanel_letsencrypt_ready | default([])) %}
{{ _site }}:8443 {
        tls {{ _certs_dir }}/letsencrypt-{{ _site }}.crt {{ _certs_dir }}/letsencrypt-{{ _site }}.key
        import turbopanel_app
}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
