#!/bin/sh
# Managed by TurboPanel. Edits are overwritten on the next converge.
#
# Resolves which co-installed PHP series a bare `php` means for the calling
# account, then execs the real binary.
#
# Every installed series may be run by every site owner's Linux user, so the
# choice is ergonomics, not access: without this wrapper, which series a bare
# `php` resolves to is decided by host-global `update-alternatives` priority,
# so two site owners on different series would both land on whichever one apt
# installed last.
#
# It lives in /usr/local/bin, which precedes /usr/bin in Debian's default PATH,
# so it shadows sury's alternatives link without removing it. Removing that
# link would break every other package that expects `php` to exist.
set -eu

self=$(basename "$0")

tp_die() {
  printf '%s: %s\n' "$self" "$1" >&2
  exit 127
}

# Installed series, found on disk each time so a series another deploy
# installed is seen too (a list rendered by the last playbook run would only
# name that run's series). Names that are not exactly `<major>.<minor>` (for
# example php8.4-config) are skipped. Version-ordered, so the highest is last
# and 8.10 comes after 8.4.
tp_installed_series() {
  for binary in /usr/bin/php[0-9]*.[0-9]*; do
    series=${binary#/usr/bin/php}
    case "$series" in
      *[!0-9.]*) continue ;;
      [0-9]*.[0-9]*) ;;
      *) continue ;;
    esac
    case "$series" in
      *.*.*) continue ;;
    esac
    [ -x "$binary" ] && printf '%s\n' "$series"
  done | sort -V
}

installed=$(tp_installed_series)
if [ -z "$installed" ]; then
  tp_die "no PHP version is installed on this server."
fi

# Explicit request wins, then a root-owned per-account pin, then the highest
# installed series. Only ever selected from what is installed, so a request for
# a missing series says so instead of failing at `execve`.
requested=${TURBOPANEL_PHP:-}
if [ -z "$requested" ]; then
  pin_file="{{ turbopanel_config_dir }}/php/pins/$(id -un)"
  if [ -r "$pin_file" ]; then
    requested=$(head -n 1 "$pin_file" | tr -d '[:space:]')
  fi
fi

if [ -n "$requested" ]; then
  selected=''
  for series in $installed; do
    [ "$series" = "$requested" ] && selected=$series
  done
  if [ -z "$selected" ]; then
    tp_die "PHP $requested is not installed on this server. Installed: $(echo $installed | tr '\n' ' ')"
  fi
else
  selected=$(printf '%s\n' $installed | tail -n 1)
fi

binary="/usr/bin/php${selected}"
[ -x "$binary" ] || tp_die "PHP $selected is not installed on this server."

exec "$binary" "$@"
