; Managed by TurboPanel — baseline php.ini for vendored php-fpm.
; Per-site overrides use php_admin_value in pool fragments under pools/.

[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1
zend.enable_gc = On
expose_php = Off
max_execution_time = 30
max_input_time = 60
memory_limit = 128M
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = {{ turbopanel_log_dir }}/php/php-error.log
variables_order = "GPCS"
request_order = "GP"
register_argc_argv = Off
post_max_size = 32M
upload_max_filesize = 32M
max_file_uploads = 20
default_charset = "UTF-8"
file_uploads = On
allow_url_fopen = On
allow_url_include = Off
default_socket_timeout = 60

[opcache]
; Baseline caching for legacy (daemon-owned) document roots, whose path never
; contains a symlink that moves under a running worker.
;
; Release-backed sites serve from `<siteRoot>/current/<root>` and an ordinary
; promote only moves `current` — deliberately without a php-fpm reload. These
; two values would then let workers keep serving the *previous* release:
; `revalidate_freq = 2` delays the timestamp check, and the default
; `opcache.revalidate_path = 0` reuses the cached resolution of the unresolved
; include path so the moved link is never noticed at all. The realpath cache
; (`realpath_cache_ttl`, 120s by default) hides the swap the same way.
;
; Rather than weaken the baseline for every site, TurboPanel overrides all three
; per pool, and only for release-backed pools, via
; `RELEASE_SYMLINK_SWAP_PHP_DIRECTIVES` in `src/deploy/traditional-web.ts`
; (`realpath_cache_ttl = 0`, `opcache.revalidate_path = 1`,
; `opcache.validate_timestamps = 1`, `opcache.revalidate_freq = 0`).
zend_extension = opcache
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 10000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
