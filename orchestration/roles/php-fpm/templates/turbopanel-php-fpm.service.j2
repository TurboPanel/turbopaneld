[Unit]
Description=TurboPanel php-fpm (traditional-web Apache PHP)
After=network.target
# Prefer the vendored unit over any leftover distro php*-fpm package units.
Conflicts=php8.4-fpm.service php8.3-fpm.service php-fpm.service

[Service]
Type=forking
# Master starts as root so it can open FHS config/logs, then pool workers run
# as User/Group from each pool (tpapache). Matches the turbopanel-apache model.
PIDFile={{ turbopanel_run_dir }}/php/php-fpm.pid
ExecStartPre=/usr/bin/install -d -o {{ php_fpm_service_user }} -g {{ php_fpm_service_group }} -m 0750 {{ turbopanel_run_dir }}/php
ExecStart={{ turbopanel_vendor_dir }}/php/current/sbin/php-fpm --fpm-config {{ turbopanel_config_dir }}/php/php-fpm.conf --pid {{ turbopanel_run_dir }}/php/php-fpm.pid
ExecReload=/bin/kill -USR2 $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
