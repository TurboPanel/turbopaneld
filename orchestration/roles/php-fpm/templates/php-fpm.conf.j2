; Managed by TurboPanel — do not edit by hand.
; Per-site pools live in {{ turbopanel_config_dir }}/php/pools/*.conf
; (written by the daemon traditional-web apply path).

[global]
pid = {{ turbopanel_run_dir }}/php/php-fpm.pid
error_log = {{ turbopanel_log_dir }}/php/php-fpm.log
syslog.facility = daemon
syslog.ident = turbopanel-php-fpm
log_level = notice
daemonize = yes
include = {{ turbopanel_config_dir }}/php/pools/*.conf
