#!/bin/sh
set -eu

container="{{ tabix_container_name }}"
web_port="{{ tabix_web_port }}"
max_attempts=30
sleep_seconds=1

running="$(/usr/bin/docker inspect -f '{% raw %}{{.State.Running}}{% endraw %}' "$container" 2>/dev/null || echo false)"
if [ "$running" != "true" ]; then
  /usr/bin/docker start "$container"
fi

i=0
while ! /usr/bin/curl -sf --max-time 1 "http://127.0.0.1:${web_port}/" >/dev/null 2>&1; do
  i=$((i + 1))
  if [ "$i" -ge "$max_attempts" ]; then
    exit 1
  fi
  sleep "$sleep_seconds"
done
