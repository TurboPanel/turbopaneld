[Unit]
Description=TurboPanel Stripe CLI (dev webhook forwarder)
After=network-online.target turbopanel-caddy.service
Wants=network-online.target turbopanel-caddy.service

[Service]
Type=simple
ExecStart={{ stripe_listen_config_dir }}/wrapper-start.sh
Restart=on-failure
RestartSec=5
# 78 = EX_CONFIG: no key in stripe.env yet — show as failed (the journal names
# the file) and do not loop; any other failure restarts.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
