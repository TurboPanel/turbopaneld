---
# Co-located with ansible.cfg — ansible-lint resolves roles_path from there.
# The VS Code / Cursor Ansible extension must set ansible.config.path to the
# daemon repo root ansible.cfg (see daemon/.vscode/settings.json and
# dev.code-workspace daemon folder) so playbooks under orchestration/playbooks/
# resolve roles correctly; runtime converge still uses orchestration/ansible.cfg.
#
# Repo-root .ansible-lint also excludes Galaxy roles for IDE cwd.
# geerlingguy.* is installed by ansible-galaxy (requirements-docker.yml) —
# never first-party; do not lint or edit it. Discovery exclusions only; open
# files use nested geerlingguy.*/.ansible-lint (ensureGalaxyDockerRole).
offline: true
exclude_paths:
  - .cache/
  # Galaxy geerlingguy.docker (dot layout) and geerlingguy/docker (author/role)
  - roles/geerlingguy.docker/
  - roles/geerlingguy/
  - roles/geerlingguy.*/
  - "**/roles/geerlingguy.docker/**"
  - "**/roles/geerlingguy/**"
  - "**/roles/geerlingguy.*/**"

