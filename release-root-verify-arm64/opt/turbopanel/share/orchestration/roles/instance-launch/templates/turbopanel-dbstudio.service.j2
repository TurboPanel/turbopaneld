[Unit]
Description=TurboPanel Drizzle Studio
After=network-online.target docker.service turbopanel-postgres.service {{ instance_service_name }}.service
Wants=network-online.target turbopanel-postgres.service {{ instance_service_name }}.service

[Service]
Type=simple
User={{ instance_user }}
Group={{ turbopanel_group }}
WorkingDirectory={{ turbopanel_instance_dir }}
Environment=HOME={{ turbopanel_instance_runtime_dir }}
Environment=XDG_CONFIG_HOME={{ turbopanel_instance_config_dir }}
Environment=TURBOPANEL_NODE=/usr/local/bin/node
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=TURBOPANEL_UI_MODE={{ turbopanel_ui_mode }}
Environment=TURBOPANEL_DRIZZLE_STUDIO_PORT={{ drizzle_studio_port | default(4983) }}
Environment=TURBOPANEL_DRIZZLE_STUDIO_HOST=127.0.0.1
{% if turbopanel_pg_password is defined %}
{% if (turbopanel_instance_runtime | default('deno')) == 'workers' %}
Environment=TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@localhost:{{ postgres_port }}/{{ postgres_db }}
{% else %}
Environment=TURBOPANEL_DATABASE_URL=postgresql://{{ postgres_user }}:{{ turbopanel_pg_password }}@/{{ postgres_db }}?host={{ postgres_socket_dir }}
{% endif %}
{% endif %}
StandardOutput=append:{{ instance_log_dir }}/dbstudio.log
StandardError=append:{{ instance_log_dir }}/dbstudio.err.log
ExecStart={{ turbopanel_instance_dir }}/scripts/drizzle-studio-serve.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
