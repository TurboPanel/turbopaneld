load("../../turbopanel/tilt/common.tiltfile", "deno_bin", "deno_serve_env")

def run_daemon_mode(daemon_dir = "."):
    if config.tilt_subcommand != "down":
        print("")
        print("-----------------------------------------")
        print("Services:")
        print("  Daemon  @ (no port)")
        print("")
        print("Press Ctrl+C to stop all services")
        print("=========================================")

    local_resource(
        name = "daemon",
        labels = ["Daemon"],
        serve_cmd = deno_bin() + " run --watch --allow-net --allow-read --allow-write --allow-run --allow-env main.ts",
        serve_dir = daemon_dir,
        serve_env = deno_serve_env(),
        trigger_mode = TRIGGER_MODE_AUTO,
        deps = [
            daemon_dir + "/main.ts",
            daemon_dir + "/deno.json",
        ],
    )
