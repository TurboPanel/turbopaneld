load("../../turbopanel/tilt/common.tiltfile", "SOCKET_PATH", "deno_bin", "deno_serve_env")

def run_daemon_mode(daemon_dir = "."):
    if config.tilt_subcommand != "down":
        print("")
        print("-----------------------------------------")
        print("Services:")
        print("  Daemon  @ unix://" + SOCKET_PATH + " (instance client)")
        print("")
        print("Press Ctrl+C to stop all services")
        print("=========================================")

    daemon_env = dict(deno_serve_env())
    daemon_env["TURBOPANEL_SOCKET"] = SOCKET_PATH

    local_resource(
        name = "daemon",
        labels = ["Daemon"],
        serve_cmd = deno_bin() + " run --watch --allow-net --allow-read=/run/turbopanel --allow-write --allow-run --allow-env main.ts",
        serve_dir = daemon_dir,
        serve_env = daemon_env,
        resource_deps = ["turbopanel (deno)"],
        trigger_mode = TRIGGER_MODE_AUTO,
        deps = [
            daemon_dir + "/main.ts",
            daemon_dir + "/deno.json",
            daemon_dir + "/src/instance/client.ts",
            daemon_dir + "/src/instance/paths.ts",
        ],
    )
