# tilt/agent.tiltfile
#
# Standalone "agent node" mode: run the daemon by itself, with no co-located
# TurboPanel instance. The daemon dials the instance over the network using
# TURBOPANEL_INSTANCE_URL (loaded from .env), and self-updates when its commit
# drifts from the instance's. This is what `tilt up` runs on an installed node.
#
# Co-located dev keeps using tilt/daemon.tiltfile (run_daemon_mode), loaded from
# the turbopanel repo's Tiltfile.

def _deno_bin():
    override = os.environ.get("TURBOPANEL_DENO", "")
    if override != "":
        return override

    home = os.environ.get("HOME", "")
    if home != "":
        candidate = home + "/runtimes/deno/current/deno"
        resolved = str(local("readlink -f '" + candidate + "' 2>/dev/null || true", quiet = True)).strip()
        if resolved != "":
            return resolved

    # Fall back to a PATH lookup.
    return "deno"

def run_agent_mode():
    deno = _deno_bin()

    # Opt-in to skipping TLS validation for self-signed internal instances. The
    # public Cloudflare-tunnel hostname has a valid cert and needs neither this
    # nor TURBOPANEL_INSTANCE_CA.
    insecure = os.environ.get("TURBOPANEL_TLS_INSECURE", "") == "1"
    tls_flag = " --unsafely-ignore-certificate-errors" if insecure else ""

    if config.tilt_subcommand != "down":
        print("")
        print("-----------------------------------------")
        print("TurboPanel daemon (agent mode)")
        print("  instance <- TURBOPANEL_INSTANCE_URL (.env)")
        print("  self-updates to origin/trunk on commit drift")
        print("Press Ctrl+C to stop")
        print("=========================================")

    local_resource(
        name = "daemon",
        labels = ["Daemon"],
        serve_cmd = deno + " run --watch --allow-net --allow-sys=networkInterfaces,hostname --allow-read --allow-write --allow-run --allow-env --env-file=.env" + tls_flag + " main.ts",
        trigger_mode = TRIGGER_MODE_AUTO,
        deps = [
            "main.ts",
            "deno.json",
            "src/instance/client.ts",
            "src/server-addresses.ts",
            "src/instance/paths.ts",
            "src/updater.ts",
            "src/tunnels.ts",
            "src/orchestration/cloudflared.ts",
        ],
    )
