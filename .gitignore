.env
logs/
# Deno V8 profiles + HTML/LCOV (`deno test --coverage=…`). Official task uses
# coverage/; scoped local runs may write coverage-commands/ and similar.
coverage*/

# Python bytecode (e.g. scripts/extract-deno-zip.py)
__pycache__/
*.py[cod]
.pnpm-store/
state/
cloudflared/
dist/
publish/
release-root-verify-*/
.turbopanel-checkout-stamp

# paths.test.ts makeTempDir({ dir: repoRoot }) leftovers from interrupted runs
deno-compile-*/
paths-test-*/

# Ansible Galaxy roles historically landed under orchestration/roles/ if
# ansible-galaxy -p pointed at the checkout — never commit them. Runtime
# installs go to vendor/ansible/galaxy-roles via ensureGalaxyDockerRole
# (codeload download; not ansible-galaxy role install).
# Dot layout and author/role slash layout (leftover checkout copies).
orchestration/roles/geerlingguy.docker/
orchestration/roles/geerlingguy/
# Local Galaxy/dependency cache (wrong install target if ansible-galaxy runs from checkout).
orchestration/.ansible/
.ansible/

# Isolated Workers deploy tooling (Node/wrangler only).
workers/turbopanel-sh/public/
workers/turbopanel-sh/node_modules/
.DS_Store
